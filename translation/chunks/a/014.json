   "ctx": [
    "BIOA_NOR10_00_PLC_LOC",
    "BIOA_NOR10_11_DS1_LOC"
   ]
  },
  {
   "key": "u05512",
   "en": "Find a spot to land near the excavation. Not too close. I don't want anyone to know we're here yet.",
   "tr": "Kazının yakınında inecek bir yer bul. Çok yakın olmasın. Henüz kimsenin burada olduğumuzu bilmesini istemiyorum.",
   "ctx": [
    "BIOA_NOR10_00_PLC_LOC",
    "BIOA_NOR10_11_DS1_LOC"
   ]
  },
  {
   "key": "u05513",
   "en": "Your team's the muscle in this operation, Commander. Go in heavy and head straight for the dig site.",
   "tr": "Bu operasyonda ekibin vurucu güç, Komutan. Ağır silahlarla girin ve doğrudan kazı alanına ilerleyin.",
   "ctx": [
    "BIOA_NOR10_00_PLC_LOC",
    "BIOA_NOR10_11_DS1_LOC"
   ]
  },
  {
   "key": "u05514",
   "en": "What about survivors, Captain?",
   "tr": "Peki ya hayatta kalanlar, Kaptan?",
   "ctx": [
    "BIOA_NOR10_00_PLC_LOC",
    "BIOA_NOR10_11_DS1_LOC"
   ]
  },
  {
   "key": "u05515",
   "en": "Helping survivors is a secondary objective. The beacon's your top priority.",
   "tr": "Hayatta kalanlara yardım etmek ikincil bir hedef. İşaret fişeği birinci önceliğin.",
   "ctx": [
    "BIOA_NOR10_00_PLC_LOC",
    "BIOA_NOR10_11_DS1_LOC"
   ]
  },
  {
   "key": "u05516",
   "en": "Nihlus? You're coming with us?",
   "tr": "Nihlus? Bizimle mi geliyorsun?",
   "ctx": [
    "BIOA_NOR10_00_PLC_LOC",
    "BIOA_NOR10_11_DS1_LOC"
   ]
  },
  {
   "key": "u05517",
