 },
 "entries": [
  {
   "key": "u14478",
   "en": "That's not the way I work.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14479",
   "en": "I didn't need target practice. Don't you have a prisoner to guard?",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14480",
   "en": "Weisman's Crime",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14481",
   "en": "Weisman's Sentence",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14482",
   "en": "Xenophobe",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14483",
   "en": "This changes things.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14484",
   "en": "It's part of a mission.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14485",
   "en": "Obey my orders!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14486",
   "en": "That's not your concern.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14487",
   "en": "You didn't hear that.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14488",
   "en": "You catch on quick.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14489",
   "en": "Finch's Needs",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14490",
   "en": "Bio known already",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14491",
   "en": "Gang not Earth-first",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14492",
   "en": "(Shoot him.)",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14493",
   "en": "You can't do this.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14494",
   "en": "This won't help you.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14495",
   "en": "Do whatever you want.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14496",
   "en": "(Pay him.)",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14497",
   "en": "I'm working with you!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14498",
   "en": "I'm not in bed with anyone.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14499",
   "en": "My career is safe.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14500",
   "en": "I wouldn't have to. ",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14501",
   "en": "They can't touch me.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14502",
   "en": "No, I shouldn't have.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14503",
   "en": "I won't do that.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14504",
   "en": "He's not worth my time.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14505",
   "en": "He's mine to take.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14506",
   "en": "I don't care. Give him to me.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14507",
   "en": "There won't be a sentencing.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14508",
   "en": "Back off, Wrex. Fist told us to take you down if you showed up.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14509",
   "en": "What are you waiting for? I'm standing right here.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14510",
   "en": "This is Fist's only chance. If he's smart, he'll take it.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14511",
   "en": "He's not coming out, Wrex. End of story.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14512",
   "en": "This story is just beginning.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14513",
   "en": "Out of my way, humans. I have no quarrel with you.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14514",
   "en": "What was that all about?",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC",
    "BIOA_WAR40V_00_DSG_LOC",
    "BIOA_WAR40_05_DSG_LOC"
   ]
  },
  {
   "key": "u14515",
   "en": "Who knows? Let's just try not to get caught in the middle.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u14516",
   "en": "Stop right there! Don't come any closer!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05B_DSG_LOC"
   ]
  },
  {
   "key": "u14517",
   "en": "Stay back or we'll shoot!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05B_DSG_LOC"
   ]
  },
  {
   "key": "u14518",
   "en": "Uh... well... uh...",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05B_DSG_LOC"
   ]
  },
  {
   "key": "u14519",
   "en": "I can't believe that worked!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05B_DSG_LOC"
   ]
  },
  {
   "key": "u14520",
   "en": "Shooting people isn't always the answer.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05B_DSG_LOC"
   ]
  },
  {
   "key": "u14521",
   "en": "This would be a good time to find somewhere else to work.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05B_DSG_LOC"
   ]
  },
  {
   "key": "u14522",
   "en": "I just killed fifty bodyguards to get in here. What do you think I'll do to you?",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05B_DSG_LOC"
   ]
  },
  {
   "key": "u14523",
   "en": "Take them out!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05B_DSG_LOC"
   ]
  },
  {
   "key": "u14524",
   "en": "Save yourselves.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05B_DSG_LOC"
   ]
  },
  {
   "key": "u14525",
   "en": "You're making a mistake.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05B_DSG_LOC"
   ]
  },
  {
   "key": "u14526",
   "en": "They work for Fist.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05B_DSG_LOC"
   ]
  },
  {
   "key": "u14527",
   "en": "It would've been quicker to just kill them.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05B_DSG_LOC"
   ]
  },
  {
   "key": "u14528",
   "en": "I would've never thought of that.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05B_DSG_LOC"
   ]
  },
  {
   "key": "u14529",
   "en": "Warehouse workers. All the real guards must be dead.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05B_DSG_LOC"
   ]
  },
  {
   "key": "u14530",
   "en": "Yeah. Yeah, right. That's a good idea.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05B_DSG_LOC"
   ]
  },
  {
   "key": "u14531",
   "en": "I never liked Fist anyway.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05B_DSG_LOC"
   ]
  },
  {
   "key": "u14532",
   "en": "Aw, screw Fist. He doesn't pay us enough for this.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05B_DSG_LOC"
   ]
  },
  {
   "key": "u14533",
   "en": "It's them or us.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05B_DSG_LOC"
   ]
  },
  {
   "key": "u14534",
   "en": "Nobody threatens me!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05B_DSG_LOC"
   ]
  },
  {
   "key": "u14535",
   "en": "Looks like it's shut down.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05B_DSG_LOC"
   ]
  },
  {
   "key": "u14536",
   "en": "Fist knows we're coming.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05B_DSG_LOC"
   ]
  },
  {
   "key": "u14537",
   "en": "I wonder where all the dancers went.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05_DSG_LOC",
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14538",
   "en": "I see why this place is so popular. It's got quite the, uh, view.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05_DSG_LOC",
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14539",
   "en": "Hey, Lieutenant, put your tongue back in your mouth before you trip on it.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05_DSG_LOC",
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14540",
   "en": "Smell that? Fresh blood mixed with stale booze.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05_DSG_LOC",
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14541",
   "en": "A million light years from where humanity began and we walk into a bar filled with men drooling over half-naked women shaking their asses on a stage. I can't decide if that's funny or sad.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05_DSG_LOC",
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14542",
   "en": "What? You don't think they're here because of the food?",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05_DSG_LOC",
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14543",
   "en": "We asari are more accepting of our sexuality than most other species. Some club owners like to exploit this by hiring us as dancers.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05_DSG_LOC",
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14544",
   "en": "C-Sec always turned a blind eye to what went on in here. I think Fist was paying someone off.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05_DSG_LOC",
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14545",
   "en": "Fist had a good thing going here. Too bad he got greedy.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05_DSG_LOC",
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14546",
   "en": "Dancers are highly respected among my people. But I get the feeling these women are not held in high esteem.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05_DSG_LOC",
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14547",
   "en": "Hi! I'll be with you in just a sec.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14548",
   "en": "I don't know what you're talking about. Now, if you don't mind I need to get back to my customers.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14549",
   "en": "I will, thank you.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14550",
   "en": "Now you sound like my sister. Why is everyone so concerned about me? I can take care of myself.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14551",
   "en": "I need to go. I'm not a stripper. I don't get paid to stand around and look pretty.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14552",
   "en": "Why do I get the feeling you're not here to order drinks?",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14553",
   "en": "I'm busy. The other waitresses can help you.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14554",
   "en": "Not now. I'm busy.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14555",
   "en": "I've got nothing to say to you.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14556",
   "en": "I need to talk to you about your work with C-Sec.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14557",
   "en": "This isn't a game, Jenna. These people are dangerous.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14558",
   "en": "I'll wait right here.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14559",
   "en": "This will be quick.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14560",
   "en": "Make time now.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14561",
   "en": "Fine. Forget it.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14562",
   "en": "Hey there. Welcome to Flux.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14563",
   "en": "I'll be right over.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14564",
   "en": "Take a seat. Someone will be with you soon.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14565",
   "en": "Because I'm not.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14566",
   "en": "Sorry, I'll get to you when I can.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14567",
   "en": "Hi. Be with you in a minute.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14568",
   "en": "Enjoy the entertainment. I'll get to you soon.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14569",
   "en": "Charming girl.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14570",
   "en": "Tough girl.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14571",
   "en": "She puts on a brave face.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14572",
   "en": "Stubborn girl.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14573",
   "en": "Lovely girl.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14574",
   "en": "I'm trying to help.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u14575",
   "en": "[Leave]",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC"
   ]
  },
  {
   "key": "u14576",
   "en": "[Relax]",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC"
   ]
  },
  {
   "key": "u14577",
   "en": "[Sit Forward]",
   "tr": "",
   "ctx": [
    "BIOA_STA60_05women_DSG_LOC"
   ]
  },
  {
   "key": "u14578",
   "en": "Wait! Don't kill me! I surrender!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14579",
   "en": "The quarian isn't here. Said she'd only deal with the Shadow Broker himself.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14580",
   "en": "Here on the wards. The back alley by the markets. She's supposed to meet them right now. You can make it if you hurry.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14581",
   "en": "Hey! I came clean! I told you about the meeting! Besides, I've got my own problems now.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14582",
   "en": "The Shadow Broker wants me dead! I have to disappear. Forget about me. I'm a ghost.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14583",
   "en": "Don't worry. You'll never see me again.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14584",
   "en": "Where's the quarian?",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14585",
   "en": "Tell me where the quarian is and I won't have to shoot you in the kneecaps.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14586",
   "en": "Give me the location. Now.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14587",
   "en": "Am I supposed to just forget your part in all this?",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14588",
   "en": "Too many people died here, Fist. You don't get to walk away.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14589",
   "en": "You're not my concern.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14590",
   "en": "There's no time to waste. Come on!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14591",
   "en": "We have to save her!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14592",
   "en": "Where's the meeting?",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14593",
   "en": "You don't deserve to live.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14594",
   "en": "Fine. Disappear.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14595",
   "en": "She's not here. I don't know where she is. That's the truth!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14596",
   "en": "He's no use to you now. Let me kill him.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14597",
   "en": "He's lying.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14598",
   "en": "Wait! Wait! I don't know where the quarian is, but I know where you can find her.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14599",
   "en": "Nobody meets the Shadow Broker. Ever. Even I don't know his true identity. But she didn't know that. I told her I'd set a meeting up.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14600",
   "en": "But when she shows up, it'll be Saren's men waiting for her.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14601",
   "en": "Put a round in his leg. See if he talks.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14602",
   "en": "You'd better start explaining before I lose my temper.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14603",
   "en": "You've got three seconds to come clean. Then I start shooting.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14604",
   "en": "Tell me where that meeting is before I blow your lying head off!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14605",
   "en": "Shoot him.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14606",
   "en": "Nobody lies to me, Fist!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14607",
   "en": "Face to face? Impossible! Even I was hired through an agent.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14608",
   "en": "Impossible. The Shadow Broker only works through his agents.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14609",
   "en": "I thought the Shadow Broker only worked through agents.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14610",
   "en": "Drop the gun, krogan!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14611",
   "en": "What are you doing?!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14612",
   "en": "Oh my God!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14613",
   "en": "The Shadow Broker paid me to kill him. I don't leave jobs half done.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14614",
   "en": "He was the only contract I had left. And don't we have something more pressing to worry about?",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14615",
   "en": "How many people died because of him? He brought this on himself. Besides, we have more pressing concerns.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14616",
   "en": "That quarian's dead if we don't go now!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14617",
   "en": "That quarian is dead if we don't go now!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14618",
   "en": "I'm in charge here! You ever pull another stunt like that...",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14619",
   "en": "We don't shoot unarmed prisoners!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14620",
   "en": "A lot of people died because of him. He had it coming. Now let's move. We have to save that quarian!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14621",
   "en": "I never want to see you again. Is that clear?",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14622",
   "en": "Smart move.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC",
    "BIOA_WAR20_03a_DSG_LOC",
    "BIOA_WAR40_06_DSG_LOC"
   ]
  },
  {
   "key": "u14623",
   "en": "Never do that again!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14624",
   "en": "He'd surrendered!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14625",
   "en": "Get out of here, Fist.",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14626",
   "en": "Why do I have to do everything myself? Time to die, little soldiers!",
   "tr": "",
   "ctx": [
    "BIOA_STA60_06_DSG_LOC"
   ]
  },
  {
   "key": "u14627",
   "en": "Pardon me, soldier. Could I take a moment of your time?",
   "tr": "",
   "ctx": [
    "BIOA_STA60_07A_DSG_LOC"
   ]
  }
 ]
}
