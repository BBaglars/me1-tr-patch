   ]
  },
  {
   "key": "u00590",
   "en": "[Log out]",
   "tr": "",
   "ctx": [
    "BIOA_FRE35_00_DSG_LOC"
   ]
  },
  {
   "key": "u00613",
   "en": "I do not like this place. Too many dark secrets.",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_00_DSG_LOC",
    "BIOA_ICE25_00_DSG_LOC",
    "BIOA_ICE50_00_DSG_LOC"
   ]
  },
  {
   "key": "u00615",
   "en": "I've never seen so much ice and snow.",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_00_DSG_LOC",
    "BIOA_ICE25_00_DSG_LOC",
    "BIOA_ICE50_00_DSG_LOC"
   ]
  },
  {
   "key": "u00617",
   "en": "I hate the cold.",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_00_DSG_LOC",
    "BIOA_ICE25_00_DSG_LOC",
    "BIOA_ICE50_00_DSG_LOC"
   ]
  },
  {
   "key": "u00631",
   "en": "Very well.",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_ICE20_03B_DSG_LOC",
    "BIOA_ICE20_03D_DSG_LOC"
   ]
  },
  {
   "key": "u00691",
   "en": "What do you want?",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_ICE20_03B_DSG_LOC",
    "BIOA_ICE20_08_DSG_LOC"
   ]
  },
  {
   "key": "u00764",
   "en": "Goodbye.",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_ICE20_03A_DSG_LOC",
    "BIOA_ICE20_03B_DSG_LOC"
   ]
  },
  {
   "key": "u00775",
   "en": "I don't have time for this.",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_ICE20_03B_DSG_LOC",
    "BIOA_ICE20_08_DSG_LOC"
   ]
  },
  {
   "key": "u00781",
   "en": "I'll help you.",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_ICE20_03B_DSG_LOC",
    "BIOA_ICE20_08_DSG_LOC"
   ]
  },
  {
   "key": "u00806",
   "en": "Sounds suspicious.",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_ICE20_03B_DSG_LOC",
    "BIOA_ICE20_08_DSG_LOC"
   ]
  },
  {
   "key": "u00874",
   "en": "I'll talk to him.",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_ICE20_03B_DSG_LOC",
    "BIOA_ICE20_08_DSG_LOC"
   ]
  },
  {
   "key": "u00879",
   "en": "I have a mission to complete.",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_ICE20_03B_DSG_LOC",
    "BIOA_ICE20_08_DSG_LOC"
   ]
  },
  {
   "key": "u00893",
   "en": "Get out of here.",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_ICE20_06_DSG_LOC",
    "BIOA_JUG70_15_DSG_LOC"
   ]
  },
  {
   "key": "u00903",
   "en": "Who are you?",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_ICE20_06_DSG_LOC",
    "BIOA_ICE20_08_DSG_LOC"
   ]
  },
  {
   "key": "u00905",
   "en": "Nope.",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_ICE20_06_DSG_LOC",
    "BIOA_STA60_09A_DSG_LOC"
   ]
  },
  {
   "key": "u00936",
   "en": "Is there anything I can do for you today, Commander?",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_STA20_04A_DSG_LOC"
   ]
  },
  {
   "key": "u01006",
   "en": "Personal questions",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_ICE20_04_DSG_LOC",
    "BIOA_ICE60_07_DSG_LOC"
   ]
  },
  {
   "key": "u01021",
   "en": "Forget about it.",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_JUG20_08_DSG_LOC",
    "BIOA_NOR10_11_DSG_LOC"
   ]
  },
  {
   "key": "u01025",
   "en": "I'll do my best.",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_STA60_02a_DSG_LOC"
   ]
  },
  {
   "key": "u01026",
   "en": "No promises.",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_STA60_04_DSG_LOC",
    "BIOA_STA60_07A_DSG_LOC"
   ]
  },
  {
   "key": "u01027",
   "en": "We'll see.",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_ICE20_03A_DSG_LOC",
    "BIOA_NOR10_06kaidan_DSG_LOC"
   ]
  },
  {
   "key": "u01028",
   "en": "Of course not.",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_NOR10_06lockera_DSG_LOC",
    "BIOA_NOR10_09ashley_DS2_LOC"
   ]
  },
  {
   "key": "u01029",
   "en": "Why?",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_ICE20_04_DSG_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u01051",
   "en": "Why not?",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_ICE20_08_DSG_LOC",
    "BIOA_STA20_09A_DSG_LOC"
   ]
  },
  {
   "key": "u01068",
   "en": "Can I help you?",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_ICE20_08_DSG_LOC",
    "BIOA_STA60_05A_DSG_LOC"
   ]
  },
  {
   "key": "u01072",
   "en": "No.",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_ICE20_03A_DSG_LOC",
    "BIOA_ICE20_03D_DSG_LOC"
   ]
  },
  {
   "key": "u01101",
   "en": "Don't worry.",
   "tr": "",
   "ctx": [
    "BIOA_ICE20_01A_DSG_LOC",
    "BIOA_NOR10_06lockera_DSG_LOC",
    "BIOA_NOR10_09ashley_DS2_LOC"
   ]
  },
  {
