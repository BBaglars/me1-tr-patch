{
 "meta": {
  "lane": "a",
  "task": "t119",
  "chunk": "a/012",
  "family": "ICE50"
 },
 "entries": [
  {
   "key": "u02770",
   "en": "What's the problem?",
   "tr": "",
   "ctx": [
    "BIOA_ICE50_06_DSG_LOC",
    "BIOA_ICE50_08_DSG_LOC",
    "BIOA_ICE50_10_DSG_LOC"
   ]
  },
  {
   "key": "u02784",
   "en": "I'm in a hurry.",
   "tr": "",
   "ctx": [
    "BIOA_ICE50_06_DSG_LOC",
    "BIOA_ICE50_08_DSG_LOC",
    "BIOA_ICE50_10_DSG_LOC"
   ]
  },
  {
   "key": "u02805",
   "en": "Yes, I would.",
   "tr": "",
   "ctx": [
    "BIOA_ICE50_06_DSG_LOC",
    "BIOA_ICE50_08_DSG_LOC",
    "BIOA_ICE50_10_DSG_LOC"
   ]
  },
  {
   "key": "u02835",
   "en": "That makes sense.",
   "tr": "",
   "ctx": [
    "BIOA_ICE50_06_DSG_LOC",
    "BIOA_ICE50_08_DSG_LOC",
    "BIOA_ICE50_10_DSG_LOC"
   ]
  },
  {
   "key": "u02924",
   "en": "You and me both.",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_02_DSG_LOC",
    "BIOA_NOR10_06kaidan_DSG_LOC",
    "BIOA_NOR10_06lockerk_DSG_LOC"
   ]
  },
  {
   "key": "u02967",
   "en": "Understood.",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_02_DSG_LOC",
    "BIOA_JUG20_08_DSG_LOC",
    "BIOA_NOR10_03_DSG_LOC"
   ]
  },
  {
   "key": "u02979",
   "en": "I'll see what I can do.",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_02_DSG_LOC",
    "BIOA_ICE60_07A_DSG_LOC",
    "BIOA_NOR10_03_DSG_LOC"
   ]
  },
  {
   "key": "u03024",
   "en": "I don't know what you're talking about.",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_02_DSG_LOC",
    "BIOA_NOR10_06lockera_DSG_LOC",
    "BIOA_NOR10_09ashley_DS2_LOC"
   ]
  },
  {
   "key": "u03028",
   "en": "What?",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_02_DSG_LOC",
    "BIOA_ICE60_06_DSG_LOC",
    "BIOA_ICE60_07_DSG_LOC"
   ]
  },
  {
   "key": "u03048",
   "en": "No problem.",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_02_DSG_LOC",
    "BIOA_NOR10_04_DSG_LOC",
    "BIOA_NOR10_11_DSG_LOC"
   ]
  },
  {
   "key": "u03136",
   "en": "Where do I go?",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_06_DSG_LOC",
    "BIOA_STA20_04C_DSG_LOC"
   ]
  },
  {
   "key": "u03161",
   "en": "My name's Shepard.",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_06_DSG_LOC",
    "BIOA_STA30_01_DSG_LOC"
   ]
  },
  {
   "key": "u03188",
   "en": "Shut up.",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_06_DSG_LOC",
    "BIOA_STA30_04A_DSG_LOC",
    "BIOA_WAR20_03a_DSG_LOC"
   ]
  },
  {
   "key": "u03214",
   "en": "Yes?",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_07A_DSG_LOC",
    "BIOA_NOR10_11_DSG_LOC"
   ]
  },
  {
   "key": "u03286",
   "en": "Suit yourself.",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_07A_DSG_LOC",
    "BIOA_NOR10_11_DSG_LOC"
   ]
  },
  {
   "key": "u03351",
   "en": "Happy to help.",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_07A_DSG_LOC",
    "BIOA_STA20_02A_DSG_LOC",
    "BIOA_STA60_08A_DSG_LOC"
   ]
  },
  {
   "key": "u03384",
   "en": "That's all for now.",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_07_DSG_LOC",
    "BIOA_NOR10_04A_DSG_LOC",
    "BIOA_STA20_02A_DSG_LOC"
   ]
  },
  {
   "key": "u03431",
   "en": "What's on your mind?",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_07_DSG_LOC",
    "BIOA_STA60_02a_DSG_LOC"
   ]
  },
  {
   "key": "u03455",
   "en": "How are you holding up?",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_07_DSG_LOC",
    "BIOA_ICE60_14_DSG_LOC",
    "BIOA_NOR10_01_DS1_LOC"
   ]
  },
  {
   "key": "u03485",
   "en": "Good question.",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_07_DSG_LOC",
    "BIOA_STA60_05A_DSG_LOC",
    "BIOA_UNC52_03_DSG_LOC"
   ]
  },
  {
   "key": "u03486",
   "en": "Show me what you've got.",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_07_DSG_LOC",
    "BIOA_STA30_03A_DSG_LOC",
    "BIOA_STA60_02a_DSG_LOC"
   ]
  },
  {
   "key": "u03508",
   "en": "You lied to me.",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_10_DSG_LOC",
    "BIOA_STA20_10A_DSG_LOC",
    "BIOA_STA30_02A_DSG_LOC"
   ]
  },
  {
   "key": "u03557",
   "en": "You mean Liara?",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_12_DSG_LOC",
    "BIOA_NOR10_06kaidan_DSG_LOC",
    "BIOA_NOR10_06lockerk_DSG_LOC"
   ]
  },
  {
   "key": "u03572",
   "en": "How so?",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_12_DSG_LOC",
    "BIOA_NOR10_11_DSG_LOC",
    "BIOA_STA30_01_DSG_LOC"
   ]
  },
  {
   "key": "u03590",
   "en": "Of course, Commander.",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_12_DSG_LOC",
    "BIOA_STA60_01nodest_DSG_LOC",
    "BIOA_WAR20_03f_DSG_LOC"
   ]
  },
  {
   "key": "u03608",
   "en": "Give it to me.",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_12_DSG_LOC",
    "BIOA_NOR10_11_DSG_LOC",
    "BIOA_PRO10_08_DSG_LOC"
   ]
  },
  {
   "key": "u03703",
   "en": "If you're certain.",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_12_DSG_LOC",
    "BIOA_NOR10_03_DSG_LOC"
   ]
  },
  {
   "key": "u03861",
   "en": "What did you do?",
   "tr": "",
   "ctx": [
    "BIOA_ICE60_14_DSG_LOC",
    "BIOA_LOS40_05_DSG_LOC",
    "BIOA_NOR10_11_DSG_LOC"
   ]
  },
  {
   "key": "u04916",
   "en": "Everybody hang on!",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04917",
   "en": "I... I can't believe Kaidan didn't make it. How could we just leave him down there?",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04918",
   "en": "Thanks, Commander. Things got pretty hot down there. You saved my life.",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04919",
   "en": "It's a distress call, a message sent out across the Prothean Empire. A warning against the Reapers, but the warning came too late.",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04920",
   "en": "Saren will have his entire fleet orbiting Ilos. You will never make it down to the surface without reinforcements. You must alert the Council. We need a fleet to-- ohhh...",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04921",
   "en": "I am sorry. The joining is... exhausting. I should go to the medical bay and lie down for a moment.",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04922",
   "en": "Your role in our communion is passive. I am the one who must submerge myself in your mind. Drown myself in your thoughts. It is more difficult than it looks.",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04923",
   "en": "The human subconscious instinctively resists the joining, Commander. A strong personality like yours makes it even harder. I just need some time to recover.",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04924",
   "en": "That will not be necessary. I just need some rest. Somewhere quiet.",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04925",
   "en": "Tell me. Your visions -- have they changed at all? Do you know where the Conduit is now?",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04926",
   "en": "That is unfortunate. I am afraid our only choice is to go to Feros. Maybe we will find what we need there.",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04927",
   "en": "But how are we going to find him? Or the Conduit?",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04928",
   "en": "What about that beacon? The one in the base? Did it give you another vision? Did it show you where the Conduit is?",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04929",
   "en": "Both our lives. I don't know how you did it, Commander. The Alliance'll come up with a whole new medal for what you pulled off here.",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04930",
   "en": "If they don't court-martial you. You endangered the entire mission. Why didn't you just leave one of us behind?",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04931",
   "en": "We might have tried, Commander. But I don't think either one of us could have pulled this off.",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04932",
   "en": "Anyone else, I'd say they got lucky.",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04933",
   "en": "Kaidan's right. Nobody else could make a stunt like that work. Put anyone else in charge and someone gets left behind. Or the mission fails.",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04934",
   "en": "I... I can't believe Ash didn't make it. How could we just leave her down there?",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04935",
   "en": "But why me? Why not her?",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04936",
   "en": "I know. And I am grateful. But Ash died because of me. Because of us.",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04937",
   "en": "I'm sorry, Commander. You saved my life. I'm grateful for that. But if I'd done my job-- We should have been able to save her.",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04938",
   "en": "But if I'd done my job, you wouldn't have had to make that call.",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04939",
   "en": "Yes, sir. I'm-- We'll get it done.",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04940",
   "en": "It should have been me, Commander. You know that.",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04941",
   "en": "I know. And I'm grateful. But Kaidan died because of me. Because of us.",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04942",
   "en": "I-- I'm sorry, Commander. You saved my life. I'm grateful for that. But it should have be me. Alenko was a superior officer. I would have gladly stayed behind.",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04943",
   "en": "Commander? Excuse me for interrupting. But I have an idea. I think the beacon you found in Saren's base was similar to the one you found on Eden Prime.",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04944",
   "en": "It may have filled in the missing pieces of your vision. I might be able to help you put all those pieces together.",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04945",
   "en": "I understand your reluctance, Commander. But the visions are already there. I only want to help you make sense of them. It may be the only way to stop Saren.",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04946",
   "en": "Relax, Commander. Embrace eternity!",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  },
  {
   "key": "u04947",
   "en": "Incredible. I... I never thought the images would be so... intense. I need a moment to collect myself.",
   "tr": "",
   "ctx": [
    "BIOA_JUG_80_X_Outrun_CIN_LOC",
    "BIOA_NOR10_04A_DSG_LOC"
   ]
  }
 ]
}
