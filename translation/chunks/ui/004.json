 "entries": [
  {
   "key": "u18891",
   "en": "Nassana Dantius has hired you to rescue her sister Dahlia from a mercenary group working out in the Artemis Tau Cluster.",
   "tr": "Nassana Dantius, kız kardeşi Dahlia'yı Artemis Tau Kümesi'nde faaliyet gösteren bir paralı asker grubundan kurtarmanız için sizi tuttu.",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u18892",
   "en": "Go to the Macedon System in the Artemis Tau cluster and infiltrate the mercenary base.",
   "tr": "Artemis Tau kümesindeki Macedon Sistemi'ne gidin ve paralı asker üssüne sızın.",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u18893",
   "en": "Find Dahlia",
   "tr": "Dahlia'yı Bul",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u18894",
   "en": "Go to the Embassy Lounge on the Presidium level of the Citadel and tell Nassana Dantius that her sister Dahlia is dead.",
   "tr": "Citadel'in Presidium katındaki Büyükelçilik Salonu'na gidin ve Nassana Dantius'a kız kardeşi Dahlia'nın öldüğünü söyleyin.",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u18895",
   "en": "Inform Nassana",
   "tr": "Nassana'yı Bilgilendir",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u18896",
   "en": "You informed Nassana Dantius that Dahlia was dead. With her blackmailing sister out of the way, Nassana can now look forward to a long and promising political career.",
   "tr": "Nassana Dantius'a Dahlia'nın öldüğünü bildirdiniz. Şantajcı kız kardeşi yolundan çekildiğine göre Nassana artık uzun ve gelecek vaat eden bir siyasi kariyeri bekleyebilir.",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u18897",
   "en": "You've received a distress call from a downed med ship located in the Hydra System of the Argos Rho Cluster.",
   "tr": "Argos Rho Kümesi'ndeki Hydra Sistemi'nde düşmüş bir sağlık gemisinden imdat çağrısı aldınız.",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u18898",
   "en": "The distress call from the downed med ship turned out to be a trap set by the geth. Fortunately, you were able to survive the ambush.",
   "tr": "Düşen sağlık gemisinden gelen imdat çağrısının geth'lerin kurduğu bir tuzak olduğu ortaya çıktı. Neyse ki pusudan sağ çıkmayı başardınız.",
   "ctx": [
    "Startup"
   ]
  },
