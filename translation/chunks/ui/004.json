 "entries": [
  {
   "key": "u18891",
   "en": "Nassana Dantius has hired you to rescue her sister Dahlia from a mercenary group working out in the Artemis Tau Cluster.",
   "tr": "",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u18892",
   "en": "Go to the Macedon System in the Artemis Tau cluster and infiltrate the mercenary base.",
   "tr": "",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u18893",
   "en": "Find Dahlia",
   "tr": "",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u18894",
   "en": "Go to the Embassy Lounge on the Presidium level of the Citadel and tell Nassana Dantius that her sister Dahlia is dead.",
   "tr": "",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u18895",
   "en": "Inform Nassana",
   "tr": "",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u18896",
   "en": "You informed Nassana Dantius that Dahlia was dead. With her blackmailing sister out of the way, Nassana can now look forward to a long and promising political career.",
   "tr": "",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u18897",
   "en": "You've received a distress call from a downed med ship located in the Hydra System of the Argos Rho Cluster.",
