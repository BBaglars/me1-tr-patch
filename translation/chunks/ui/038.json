  {
   "key": "u23442",
   "en": "Videlicet is a complex synthetic chemical that improves short-term memory and mental focus in humans. This is the mental stimulant that Elias Keeler asked you for.",
   "tr": "",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u23443",
   "en": "Eximo is a non-addictive narcotic used to treat stress in humans. It is often prescribed to executives and government officials who tend to overwork.",
   "tr": "",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u23444",
   "en": "Turn Off",
   "tr": "",
   "ctx": [
