   ]
  },
  {
   "key": "u25247",
   "en": "You do not have an active gamer profile. To create or load a gamer profile, press the Xbox Guide button. If you continue, you will not be able to save your progress.",
   "tr": "Etkin bir oyuncu profiliniz yok. Bir oyuncu profili oluşturmak veya yüklemek için Xbox Kılavuz tuşuna basın. Devam ederseniz ilerlemenizi kaydedemezsiniz.",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u25248",
   "en": "Confirm Selections and Exit",
   "tr": "Seçimleri Onayla ve Çık",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u25249",
   "en": "Gameplay options are only stored in Save Games, not across profiles. Save your game when you exit the OPTIONS menu to save your gameplay changes.",
   "tr": "Oynanış seçenekleri profiller arasında değil, yalnızca Kayıtlı Oyunlarda saklanır. Oynanış değişikliklerinizi kaydetmek için SEÇENEKLER menüsünden çıkarken oyununuzu kaydedin.",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u25250",
   "en": "General Manager of Production",
   "tr": "Yapım Genel Müdürü",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u25251",
   "en": "You can return to the Normandy from any uncharted world by pressing [XBoxB_Btn_X] while in the Mako.",
   "tr": "Mako'dayken [XBoxB_Btn_X] tuşuna basarak herhangi bir keşfedilmemiş dünyadan Normandy'ye dönebilirsiniz.",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u25252",
   "en": "Many achievements offer in-game rewards. Make sure to check the Achievement screen from the Main Menu.",
   "tr": "Birçok başarım oyun içi ödüller sunar. Ana Menü'den Başarımlar ekranına göz atmayı unutmayın.",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u25253",
   "en": "After landing on this small asteroid, you were contacted by a human. Three fusion torches are being used to direct the asteroid into the path of a nearby planet. She's urged you to find the torches and shut them down.",
   "tr": "Bu küçük asteroide indikten sonra bir insan sizinle iletişime geçti. Üç füzyon meşalesi asteroidi yakındaki bir gezegenin yoluna yönlendirmek için kullanılıyor. Sizden meşaleleri bulup kapatmanızı istedi.",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u25254",
   "en": "X57: Bring Down the Sky",
   "tr": "X57: Bring Down the Sky",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u25255",
   "en": "The three torches are disabled, but the leader of the batarians is still holding several humans hostage.",
   "tr": "Üç meşale devre dışı ama batarian'ların lideri hâlâ birkaç insanı rehin tutuyor.",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u25256",
   "en": "You rescued the human prisoners and disabled all the fusion torches. The team will evacuate to Terra Nova and send in a repair crew to get the asteroid functional again.",
   "tr": "İnsan esirleri kurtardınız ve tüm füzyon meşalelerini devre dışı bıraktınız. Ekip Terra Nova'ya tahliye olacak ve asteroidi yeniden çalışır hale getirmek için bir onarım ekibi gönderecek.",
   "ctx": [
    "Startup"
   ]
  },
  {
   "key": "u25257",
   "en": "Find the three fusion torches and disable them.",
   "tr": "Üç füzyon meşalesini bulup devre dışı bırakın.",
   "ctx": [
    "Startup"
   ]
  },
