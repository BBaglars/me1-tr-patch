   "tr": "",
   "ctx": [
    "BIOA_JUG80_00_PLC_LOC",
    "BIOA_JUG80_01_DSG_LOC",
    "BIOA_JUG80_03_DSG_LOC"
   ]
  },
  {
   "key": "u04766",
   "en": "Up to the AA tower. Move!",
   "tr": "",
   "ctx": [
    "BIOA_JUG80_00_PLC_LOC",
    "BIOA_JUG80_01_DSG_LOC",
    "BIOA_JUG80_03_DSG_LOC"
   ]
  },
  {
   "key": "u04767",
   "en": "You keep that nuke safe!",
   "tr": "",
   "ctx": [
    "BIOA_JUG80_00_PLC_LOC",
    "BIOA_JUG80_01_DSG_LOC",
    "BIOA_JUG80_03_DSG_LOC"
   ]
  },
  {
   "key": "u04768",
   "en": "Where are you?",
