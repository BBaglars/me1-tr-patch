 "entries": [
  {
   "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|74820",
   "en": "Stop right there! Don't come any closer!",
   "tr": "Dur orada! Daha fazla yaklaşma!"
  },
  {
   "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|74821",
   "en": "Stay back or we'll shoot!",
   "tr": "Geri çekil yoksa ateş ederiz!"
  },
  {
   "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|74825",
   "en": "Uh... well... uh...",
   "tr": "Ee... şey... ee..."
  },
  {
   "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|74826",
   "en": "I can't believe that worked!",
   "tr": "Bunun işe yaramasına inanamıyorum!"
  },
  {
   "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|74827",
   "en": "Shooting people isn't always the answer.",
   "tr": "İnsanları vurmak her zaman cevap değil."
  },
  {
   "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|74833",
   "en": "This would be a good time to find somewhere else to work.",
   "tr": "Burası dışında çalışacak başka bir yer bulmak için iyi bir zaman."
  },
  {
   "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|74834",
   "en": "I just killed fifty bodyguards to get in here. What do you think I'll do to you?",
   "tr": "Buraya girmek için az önce elli koruma öldürdüm. Size ne yapacağımı sanıyorsunuz?"
  },
  {
   "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|74837",
   "en": "Take them out!",
   "tr": "Hepsini indirin!"
  },
  {
   "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|74842",
   "en": "Save yourselves.",
   "tr": "Kendinizi kurtarın."
  },
  {
   "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|74843",
   "en": "You're making a mistake.",
   "tr": "Hata yapıyorsun."
  },
  {
   "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|74844",
   "en": "They work for Fist.",
   "tr": "Fist için çalışıyorlar."
  },
  {
   "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|95786",
   "en": "It would've been quicker to just kill them.",
   "tr": "Onları öldürmek daha hızlı olurdu."
  },
  {
   "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|95787",
   "en": "I would've never thought of that.",
   "tr": "Bunu hiç düşünmezdim."
  },
  {
   "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|95788",
   "en": "Shooting people isn't always the answer.",
   "tr": "İnsanları vurmak her zaman cevap değil."
  },
  {
   "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|95789",
   "en": "Shooting people isn't always the answer.",
   "tr": "İnsanları vurmak her zaman cevap değil."
  },
  {
   "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|104812",
   "en": "Warehouse workers. All the real guards must be dead.",
   "tr": "Depo çalışanları. Gerçek muhafızların hepsi ölmüş olmalı."
  },
  {
   "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|104813",
   "en": "Warehouse workers. All the real guards must be dead.",
   "tr": "Depo çalışanları. Gerçek muhafızların hepsi ölmüş olmalı."
  },
  {
