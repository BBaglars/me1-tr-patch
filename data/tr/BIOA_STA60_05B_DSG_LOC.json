   "en": "Warehouse workers. All the real guards must be dead.",
   "tr": "Depo çalışanları. Gerçek muhafızların hepsi ölmüş olmalı."
  },
  {
   "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|104815",
   "en": "Yeah. Yeah, right. That's a good idea.",
   "tr": "Evet. Evet, doğru. Bu iyi bir fikir."
  },
  {
   "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|104816",
   "en": "I never liked Fist anyway.",
   "tr": "Zaten Fist'ten hiç hoşlanmadım."
  },
  {
   "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|104817",
   "en": "Aw, screw Fist. He doesn't pay us enough for this.",
   "tr": "Ah, Fist canı cehenneme. Bunun için bize yeterince ödemiyor."
  },
  {
   "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|104827",
   "en": "It's them or us.",
   "tr": "Ya onlar ya biz."
  },
  {
   "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|104828",
   "en": "Nobody threatens me!",
   "tr": "Kimse beni tehdit edemez!"
  },
