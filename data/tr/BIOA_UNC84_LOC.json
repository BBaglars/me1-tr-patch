  {
   "key": "BIOA_UNC84_LOC|sp102_triggers_d|134927",
   "en": "Looks like the data module's still intact. Joker can transmit this info to your Alliance Command.",
   "tr": "Görünüşe göre veri modülü hâlâ sağlam. Joker bu bilgiyi İttifak Komutanlığı'nıza iletebilir."
  },
  {
   "key": "BIOA_UNC84_LOC|sp102_triggers_d|134929",
   "en": "Nice shot.",
   "tr": "Güzel atış."
  },
  {
   "key": "BIOA_UNC84_LOC|sp102_triggers_d|134930",
   "en": "That was a little extreme, wasn't it?",
   "tr": "Biraz aşırı değil miydi?"
  },
  {
   "key": "BIOA_UNC84_LOC|sp102_triggers_d|134931",
   "en": "Guess the little beast had it coming.",
   "tr": "Sanırım küçük canavar hak etti."
  },
  {
   "key": "BIOA_UNC84_LOC|sp102_triggers_d|134932",
   "en": "Personally, I would've just thrown a rock at him.",
   "tr": "Şahsen ben ona bir taş atardım."
  },
  {
   "key": "BIOA_UNC84_LOC|sp102_triggers_d|134933",
   "en": "Remind me to stay on your good side, Commander.",
   "tr": "Beni iyi tarafında tutmayı hatırlat Komutan."
  },
  {
   "key": "BIOA_UNC84_LOC|sp102_triggers_d|134934",
   "en": "This is why you humans have such a violent reputation.",
   "tr": "Siz insanların bu kadar şiddet ünlü olmasının sebebi bu."
  },
  {
   "key": "BIOA_UNC84_LOC|unc_banter_00_d|160642",
   "en": "I'm right here.",
   "tr": "Hemen buradayım."
  },
  {
   "key": "BIOA_UNC84_LOC|unc_banter_00_d|160643",
   "en": "Ready whenever you are.",
   "tr": "Ne zaman istersen hazırım."
  },
  {
   "key": "BIOA_UNC84_LOC|unc_banter_00_d|160644",
   "en": "Yes, sir.",
   "tr": "Emredersiniz, efendim."
  },
  {
   "key": "BIOA_UNC84_LOC|unc_banter_00_d|160645",
   "en": "Yes, ma'am.",
   "tr": "Emredersiniz, hanımefendi."
  },
  {
   "key": "BIOA_UNC84_LOC|unc_banter_00_d|160646",
   "en": "On your order.",
   "tr": "Emrinizle."
  },
  {
   "key": "BIOA_UNC84_LOC|unc_banter_00_d|160647",
   "en": "Ready to move.",
   "tr": "Harekete hazırım."
  },
  {
   "key": "BIOA_UNC84_LOC|unc_banter_00_d|160648",
   "en": "Waiting for orders.",
   "tr": "Emir bekliyorum."
  },
  {
   "key": "BIOA_UNC84_LOC|unc_banter_00_d|160650",
   "en": "Ready.",
   "tr": "Hazır."
  },
  {
   "key": "BIOA_UNC84_LOC|unc_banter_00_d|160651",
   "en": "Say the word.",
   "tr": "Sen söyle yeter."
  },
  {
   "key": "BIOA_UNC84_LOC|unc_banter_00_d|160652",
   "en": "Charged and locked.",
   "tr": "Dolu ve kilitli."
  },
  {
   "key": "BIOA_UNC84_LOC|unc_banter_00_d|160653",
   "en": "I'm on it.",
   "tr": "Hallediyorum."
  },
  {
   "key": "BIOA_UNC84_LOC|unc_banter_00_d|160655",
   "en": "Ready.",
   "tr": "Hazır."
  },
  {
   "key": "BIOA_UNC84_LOC|unc_banter_00_d|160656",
   "en": "On your order, Shepard.",
   "tr": "Emrinle, Shepard."
  },
  {
   "key": "BIOA_UNC84_LOC|unc_banter_00_d|160657",
   "en": "Lead on, Commander.",
   "tr": "Yol göster, Komutan."
  },
  {
   "key": "BIOA_UNC84_LOC|unc_banter_00_d|160659",
   "en": "Just lead the way.",
   "tr": "Sen yol göster yeter."
  },
  {
   "key": "BIOA_UNC84_LOC|unc_banter_00_d|160660",
   "en": "I'm here if you need me.",
   "tr": "Lazım olursam buradayım."
  },
  {
   "key": "BIOA_UNC84_LOC|unc_banter_00_d|160661",
   "en": "Right behind you, Shepard.",
   "tr": "Hemen arkandayım, Shepard."
  },
  {
   "key": "BIOA_UNC84_LOC|unc_banter_00_d|160663",
   "en": "Let's get moving.",
   "tr": "Hadi yürüyelim."
  },
  {
   "key": "BIOA_UNC84_LOC|unc_banter_00_d|160664",
   "en": "No sense standing around.",
   "tr": "Dikilmenin âlemi yok."
  },
  {
   "key": "BIOA_UNC84_LOC|unc_banter_00_d|160665",
   "en": "Let's go.",
   "tr": "Gidelim."
  },
  {
   "key": "BIOA_UNC84_LOC|unc_banter_00_d|160667",
   "en": "You lead, I'll follow.",
   "tr": "Sen önden git, ben arkandan gelirim."
  }
 ]
