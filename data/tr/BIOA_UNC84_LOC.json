  {
   "key": "BIOA_UNC84_LOC|sp102_triggers_d|134923",
   "en": "It's a miracle the data module's still intact. Joker can transmit this info to Alliance Command.",
   "tr": "Veri modülünün hâlâ sağlam olması mucize. Joker bu bilgiyi İttifak Komutanlığı'na iletebilir."
  },
  {
   "key": "BIOA_UNC84_LOC|sp102_triggers_d|134924",
   "en": "It's a miracle the data module's still intact. Joker can transmit this info to Alliance Command.",
   "tr": "Veri modülünün hâlâ sağlam olması mucize. Joker bu bilgiyi İttifak Komutanlığı'na iletebilir."
  },
  {
   "key": "BIOA_UNC84_LOC|sp102_triggers_d|134925",
   "en": "It is a miracle the data module is still intact. Your pilot should be able to relay this info to your superiors.",
   "tr": "Veri modülünün hâlâ sağlam olması mucize. Pilotunuz bu bilgiyi üstlerinize aktarabilmeli."
  },
  {
   "key": "BIOA_UNC84_LOC|sp102_triggers_d|134926",
   "en": "It's a miracle the data module's still intact. Joker should be able to transmit this info to Alliance Command.",
   "tr": "Veri modülünün hâlâ sağlam olması mucize. Joker bu bilgiyi İttifak Komutanlığı'na iletebilmeli."
