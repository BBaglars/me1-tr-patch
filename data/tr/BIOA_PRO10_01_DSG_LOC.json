 "entries": [
  {
   "key": "BIOA_PRO10_01_DSG_LOC|pro10_trig02_a_river_approach_d|3867",
   "en": "Gas bags. Don't worry - they're harmless.",
   "tr": "Gaz kesecikleri. Merak etme, zararsızlar."
  },
  {
   "key": "BIOA_PRO10_01_DSG_LOC|pro10_trig02_a_river_approach_d|3868",
   "en": "What the hell are those?",
   "tr": "Bunlar da ne?"
  },
  {
   "key": "BIOA_PRO10_01_DSG_LOC|pro10_trig02_a_river_approach_d|152010",
   "en": "Freaky looking things, aren't they?",
   "tr": "Ürkütücü görünüyorlar, değil mi?"
  },
  {
   "key": "BIOA_PRO10_01_DSG_LOC|pro10_trig02_c_bodies_d|145651",
   "en": "Oh, god. What happened here?",
   "tr": "Aman Tanrım. Burada ne oldu?"
  },
  {
   "key": "BIOA_PRO10_01_DSG_LOC|pro10_trig02_d_nihlus_d|149204",
   "en": "This place got hit hard, Commander. Hostiles everywhere. Keep your guard up.",
   "tr": "Burası ağır darbe almış, Komutan. Her yerde düşman var. Tetikte ol."
  },
  {
   "key": "BIOA_PRO10_01_DSG_LOC|pro10_trigger_01_outside_ship_d|3859",
   "en": "Ship perimeter secure, Commander!",
   "tr": "Gemi çevresi güvende, Komutan!"
  },
  {
   "key": "BIOA_PRO10_01_DSG_LOC|pro10_trigger_01_outside_ship_d|3860",
   "en": "No sign of Nihlus. Damn, he's fast.",
   "tr": "Nihlus'tan iz yok. Kahretsin, hızlı."
  },
  {
   "key": "BIOA_PRO10_01_DSG_LOC|pro10_trigger_02_b_gasbag_d|102699",
   "en": "Damn!",
   "tr": "Kahretsin!"
  },
  {
   "key": "BIOA_PRO10_01_DSG_LOC|pro10_trigger_02_b_gasbag_d|149197",
   "en": "Oh, yeah. Don't stand next to them when the shooting starts.",
   "tr": "Ah, evet. Ateş başlayınca yanlarında durma."
  }
 ]
}
