 "entries": [
  {
   "key": "BIOA_END70_00_DSG_LOC|end00_banter_00_D|160478",
   "en": "Saren's close now.",
   "tr": "Saren artık yakın."
  },
  {
   "key": "BIOA_END70_00_DSG_LOC|end00_banter_00_D|160479",
   "en": "We have to hurry!",
   "tr": "Acele etmeliyiz!"
  },
  {
   "key": "BIOA_END70_00_DSG_LOC|end00_banter_00_D|160480",
   "en": "This will all be over soon.",
   "tr": "Bunların hepsi yakında bitecek."
  },
  {
   "key": "BIOA_END70_00_DSG_LOC|end00_banter_00_D|160482",
   "en": "Time for payback!",
   "tr": "Hesaplaşma zamanı!"
  },
  {
   "key": "BIOA_END70_00_DSG_LOC|end00_banter_00_D|160483",
   "en": "Saren can't run any more.",
   "tr": "Saren artık kaçamaz."
  },
  {
   "key": "BIOA_END70_00_DSG_LOC|end00_banter_00_D|160484",
   "en": "Come on! We're running out of time!",
   "tr": "Hadi! Zamanımız tükeniyor!"
  },
  {
   "key": "BIOA_END70_00_DSG_LOC|end00_banter_00_D|160486",
   "en": "We have to stop Saren!",
   "tr": "Saren'i durdurmalıyız!"
  },
  {
   "key": "BIOA_END70_00_DSG_LOC|end00_banter_00_D|160487",
   "en": "The fate of the entire galaxy hangs in the balance!",
   "tr": "Bütün galaksinin kaderi kıl payı dengede!"
  },
  {
   "key": "BIOA_END70_00_DSG_LOC|end00_banter_00_D|160488",
   "en": "There is no time to lose.",
   "tr": "Kaybedecek zaman yok."
  },
  {
   "key": "BIOA_END70_00_DSG_LOC|end00_banter_00_D|160490",
   "en": "Somebody needs to put Saren in his place!",
   "tr": "Birinin Saren'e haddini bildirmesi lazım!"
  },
  {
   "key": "BIOA_END70_00_DSG_LOC|end00_banter_00_D|160491",
   "en": "Time to settle some old scores.",
   "tr": "Bazı eski hesapları kapatma zamanı."
  },
  {
   "key": "BIOA_END70_00_DSG_LOC|end00_banter_00_D|160492",
   "en": "Saren has to pay for what he's done!",
   "tr": "Saren yaptıklarının bedelini ödeyecek!"
  },
  {
   "key": "BIOA_END70_00_DSG_LOC|end00_banter_00_D|160494",
   "en": "Saren's so close, I can smell him!",
   "tr": "Saren o kadar yakın ki kokusunu alıyorum!"
  },
  {
   "key": "BIOA_END70_00_DSG_LOC|end00_banter_00_D|160495",
   "en": "Time to settle some old scores.",
   "tr": "Bazı eski hesapları kapatma zamanı."
  },
  {
   "key": "BIOA_END70_00_DSG_LOC|end00_banter_00_D|160496",
   "en": "I'm going to rip him apart with my bare hands.",
   "tr": "Onu çıplak ellerimle parçalayacağım."
  },
  {
   "key": "BIOA_END70_00_DSG_LOC|end00_banter_00_D|160498",
   "en": "Quickly, before it's too late!",
   "tr": "Çabuk, çok geç olmadan!"
  },
  {
   "key": "BIOA_END70_00_DSG_LOC|end00_banter_00_D|160499",
   "en": "Saren is trying to take control of the Citadel!",
   "tr": "Saren Citadel'in kontrolünü ele geçirmeye çalışıyor!"
  },
  {
   "key": "BIOA_END70_00_DSG_LOC|end00_banter_00_D|160500",
   "en": "We have to stop him before he brings back the Reapers!",
   "tr": "Biçiciler'i geri getirmeden onu durdurmalıyız!"
  }
 ]
}
