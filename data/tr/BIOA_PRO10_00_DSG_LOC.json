  },
  {
   "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_00_D|159673",
   "en": "Smells like smoke and death.",
   "tr": "Duman ve ölüm kokuyor."
  },
  {
   "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_00_D|159674",
   "en": "Eden Prime will never be the same again.",
   "tr": "Eden Prime bir daha asla eskisi gibi olmayacak."
  },
  {
   "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_00_D|159675",
   "en": "Check your targets. Could be friendlies.",
   "tr": "Hedeflerini kontrol et. Dost olabilirler."
  },
  {
   "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_00_D|159676",
   "en": "We should move, Commander",
   "tr": "Hareket etmeliyiz, Komutan."
  },
  {
   "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_00_D|159678",
   "en": "We thought this world was safe... until the geth showed up.",
   "tr": "Bu dünyanın güvenli olduğunu sanıyorduk... geth ortaya çıkana dek."
  },
  {
   "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_00_D|159679",
   "en": "It used to be beautiful here.",
   "tr": "Burası eskiden güzeldi."
  },
  {
   "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_00_D|159680",
   "en": "Somebody's going to pay for this.",
   "tr": "Birileri bunun bedelini ödeyecek."
  },
  {
   "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_00_D|159681",
   "en": "Let's get the bastards.",
   "tr": "Hadi şu piçleri yakalayalım."
  },
  {
   "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_00_D|159682",
   "en": "We should move.",
   "tr": "Hareket etmeliyiz."
  },
  {
   "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_00_D|159684",
   "en": "Oh god. What happened here?",
   "tr": "Aman Tanrım. Burada ne oldu?"
  },
  {
   "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_01_D|159767",
   "en": "That man was still alive when they stuck him on the spike.",
   "tr": "O adam kazığa geçirildiğinde hâlâ hayattaydı."
  },
  {
   "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_01_D|159768",
   "en": "Killing us isn't enough. The geth want us to suffer.",
   "tr": "Bizi öldürmek yetmiyor. Geth acı çekmemizi istiyor."
  },
  {
   "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_01_D|159770",
   "en": "Impaling victims instead of just shooting them... there must be some reason behind  it.",
   "tr": "Kurbanları vurmak yerine kazığa geçirmek... arkasında bir neden olmalı."
  },
  {
   "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_01_D|159771",
   "en": "Classic psychological warfare. They're using terror as a weapon.",
   "tr": "Klasik psikolojik savaş. Terörü silah olarak kullanıyorlar."
  },
  {
   "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_02_D|159782",
   "en": "Now we know what those spikes are for: turning our own dead against us.",
   "tr": "Artık o kazıkların ne işe yaradığını biliyoruz: kendi ölülerimizi bize karşı çevirmek."
  },
  {
   "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_02_D|159784",
   "en": "It must take a few hours for the spikes to turn people into husks.",
   "tr": "Kazıkların insanları husk'a çevirmesi birkaç saat sürmeli."
  }
 ]
}
