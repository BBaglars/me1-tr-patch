{
 "meta": {
  "package": "BIOA_PRO10_02_DSG_LOC_INT.pcc",
  "stem": "BIOA_PRO10_02_DSG_LOC",
  "textLang": "INT",
  "sets": 3
 },
 "entries": [
  {
   "key": "BIOA_PRO10_02_DSG_LOC|pro10_trig_jenkins_d|159343",
   "en": "Maybe we should check on Jenkins.",
   "tr": "Belki Jenkins'e bakmalıyız."
  },
  {
   "key": "BIOA_PRO10_02_DSG_LOC|pro10_trigger_03_b_river_ambush_d|3872",
   "en": "Argh!",
   "tr": "Argh!"
  },
  {
   "key": "BIOA_PRO10_02_DSG_LOC|pro10_trigger_03_b_river_ambush_d|3880",
   "en": "Jenkins. Take point.",
   "tr": "Jenkins. Öncü sensin."
  },
  {
   "key": "BIOA_PRO10_02_DSG_LOC|pro10_trigger_03_b_river_ambush_d|46041",
   "en": "Move up.",
   "tr": "İlerle."
  },
  {
   "key": "BIOA_PRO10_02_DSG_LOC|pro10_trigger_04_captain_dead_d|3889",
   "en": "Aye, aye, sir.",
   "tr": "Emredersiniz, efendim."
  },
  {
   "key": "BIOA_PRO10_02_DSG_LOC|pro10_trigger_04_captain_dead_d|3904",
   "en": "Sometimes marines die. The rest of just have to carry on. We still have to find that beacon.",
   "tr": "Bazen deniz piyadeleri ölür. Geri kalanımız yola devam etmek zorunda. Hâlâ o işaretçiyi bulmamız gerek."
  },
  {
   "key": "BIOA_PRO10_02_DSG_LOC|pro10_trigger_04_captain_dead_d|46051",
   "en": "We can't help him now.",
   "tr": "Artık ona yardım edemeyiz."
  },
  {
   "key": "BIOA_PRO10_02_DSG_LOC|pro10_trigger_04_captain_dead_d|102702",
   "en": "Ripped right through his shields. Never had a chance.",
   "tr": "Kalkanlarını delip geçmiş. Hiç şansı olmamış."
  },
  {
   "key": "BIOA_PRO10_02_DSG_LOC|pro10_trigger_04_captain_dead_d|102709",
   "en": "Aye, aye, ma'am.",
   "tr": "Emredersiniz, hanımefendi."
  },
  {
   "key": "BIOA_PRO10_02_DSG_LOC|pro10_trigger_04_captain_dead_d|146631",
   "en": "We'll see that he receives a proper service once the mission is complete. But I need you to stay focused.",
   "tr": "Görev bitince düzgün bir tören yapılmasını sağlarız. Ama odaklanman gerek."
  },
  {
   "key": "BIOA_PRO10_02_DSG_LOC|pro10_trigger_04_captain_dead_d|146632",
   "en": "Leave him. We need to finish the mission.",
   "tr": "Bırak onu. Görevi bitirmeliyiz."
  },
  {
   "key": "BIOA_PRO10_02_DSG_LOC|pro10_trigger_04_captain_dead_d|146633",
   "en": "He deserves a burial.",
   "tr": "Bir mezarı hak ediyor."
  },
  {
   "key": "BIOA_PRO10_02_DSG_LOC|pro10_trigger_04_captain_dead_d|146634",
   "en": "Forget about him.",
   "tr": "Onu boş ver."
  }
 ]
}
