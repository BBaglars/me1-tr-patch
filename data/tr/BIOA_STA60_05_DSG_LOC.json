  {
   "key": "BIOA_STA60_05_DSG_LOC|sta60_banter_02_D|159910",
   "en": "I wonder where all the dancers went.",
   "tr": "Acaba tüm dansçılar nereye gitti."
  },
  {
   "key": "BIOA_STA60_05_DSG_LOC|sta60_banter_02_D|159911",
   "en": "I see why this place is so popular. It's got quite the, uh, view.",
   "tr": "Bu yerin neden bu kadar popüler olduğunu anlıyorum. Epey, ee, manzarası var."
  },
  {
   "key": "BIOA_STA60_05_DSG_LOC|sta60_banter_02_D|159912",
   "en": "Hey, Lieutenant, put your tongue back in your mouth before you trip on it.",
   "tr": "Hey Teğmen, dilini ağzına geri sok da takılmasın."
  },
  {
   "key": "BIOA_STA60_05_DSG_LOC|sta60_banter_02_D|159914",
   "en": "Smell that? Fresh blood mixed with stale booze.",
   "tr": "Kokuyu duyuyor musun? Taze kan ve bayat içki karışımı."
  },
  {
   "key": "BIOA_STA60_05_DSG_LOC|sta60_banter_02_D|159915",
   "en": "A million light years from where humanity began and we walk into a bar filled with men drooling over half-naked women shaking their asses on a stage. I can't decide if that's funny or sad.",
   "tr": "İnsanlığın başladığı yerden milyon ışık yılı uzaktayız ve sahnede yarı çıplak kadınların kalçalarını salladığını izleyen erkeklerle dolu bir bara giriyoruz. Komik mi üzücü mü karar veremiyorum."
  },
  {
   "key": "BIOA_STA60_05_DSG_LOC|sta60_banter_02_D|159916",
   "en": "What? You don't think they're here because of the food?",
   "tr": "Ne? Yemek için geldiklerini düşünmüyorsun, değil mi?"
  },
  {
   "key": "BIOA_STA60_05_DSG_LOC|sta60_banter_02_D|159918",
   "en": "We asari are more accepting of our sexuality than most other species. Some club owners like to exploit this by hiring us as dancers.",
   "tr": "Biz asari kadınlar cinselliğimizi çoğu türden daha kabullenici karşılıyoruz. Bazı kulüp sahipleri bunu bizi dansçı olarak işe alarak sömürmeyi sever."
  },
  {
   "key": "BIOA_STA60_05_DSG_LOC|sta60_banter_02_D|159920",
   "en": "C-Sec always turned a blind eye to what went on in here. I think Fist was paying someone off.",
   "tr": "C-Sec buradakilere hep göz yumdu. Sanırım Fist birine rüşvet veriyordu."
  },
  {
   "key": "BIOA_STA60_05_DSG_LOC|sta60_banter_02_D|159922",
   "en": "Fist had a good thing going here. Too bad he got greedy.",
   "tr": "Fist'in burada güzel bir düzeni vardı. Açgözlü olması yazık oldu."
  },
  {
   "key": "BIOA_STA60_05_DSG_LOC|sta60_banter_02_D|159924",
   "en": "Dancers are highly respected among my people. But I get the feeling these women are not held in high esteem.",
   "tr": "Dansçılar halkım arasında çok saygı görür. Ama bu kadınların yüksek saygı görmediği hissine kapılıyorum."
  }
 ]
