 "entries": [
  {
   "key": "BIOA_PRO00_LOC|combat_banter_00_D|160611",
   "en": "Not now, Commander!",
   "tr": "Şimdi olmaz, Komutan!"
  },
  {
   "key": "BIOA_PRO00_LOC|combat_banter_00_D|160612",
   "en": "Take out those hostiles!",
   "tr": "Şu düşmanları temizle!"
  },
  {
   "key": "BIOA_PRO00_LOC|combat_banter_00_D|160614",
   "en": "I'm a little busy here!",
   "tr": "Biraz meşgulüm!"
  },
  {
   "key": "BIOA_PRO00_LOC|combat_banter_00_D|160615",
   "en": "Not in the middle of a fight!",
   "tr": "Savaşın ortasında olmaz!"
  },
  {
   "key": "BIOA_PRO00_LOC|combat_banter_00_D|160617",
   "en": "Now is not the time!",
   "tr": "Sırası değil!"
  },
  {
   "key": "BIOA_PRO00_LOC|combat_banter_00_D|160618",
   "en": "We are in the middle of a fight!",
   "tr": "Savaşın tam ortasındayız!"
  },
  {
   "key": "BIOA_PRO00_LOC|combat_banter_00_D|160620",
   "en": "Not now, Shepard!",
   "tr": "Şimdi olmaz, Shepard!"
  },
  {
   "key": "BIOA_PRO00_LOC|combat_banter_00_D|160621",
   "en": "Take out those hostiles!",
   "tr": "Şu düşmanları temizle!"
  },
  {
   "key": "BIOA_PRO00_LOC|combat_banter_00_D|160623",
   "en": "I'm a little busy here!",
   "tr": "Biraz meşgulüm!"
  },
  {
   "key": "BIOA_PRO00_LOC|combat_banter_00_D|160624",
   "en": "Not now, Shepard!",
   "tr": "Şimdi olmaz, Shepard!"
  },
  {
   "key": "BIOA_PRO00_LOC|combat_banter_00_D|160626",
   "en": "Take out those hostiles!",
   "tr": "Şu düşmanları temizle!"
  },
  {
   "key": "BIOA_PRO00_LOC|combat_banter_00_D|160627",
   "en": "Now is not the time!",
   "tr": "Sırası değil!"
  },
  {
   "key": "BIOA_PRO00_LOC|pro10_banter_00_D|159673",
   "en": "Smells like smoke and death.",
   "tr": "Duman ve ölüm kokuyor."
  },
  {
   "key": "BIOA_PRO00_LOC|pro10_banter_00_D|159674",
   "en": "Eden Prime will never be the same again.",
   "tr": "Eden Prime bir daha asla eskisi gibi olmayacak."
  },
  {
   "key": "BIOA_PRO00_LOC|pro10_banter_00_D|159675",
   "en": "Check your targets. Could be friendlies.",
   "tr": "Hedeflerini kontrol et. Dost olabilirler."
  },
  {
   "key": "BIOA_PRO00_LOC|pro10_banter_00_D|159676",
   "en": "We should move, Commander",
   "tr": "Hareket etmeliyiz, Komutan."
  },
  {
   "key": "BIOA_PRO00_LOC|pro10_banter_00_D|159678",
   "en": "We thought this world was safe... until the geth showed up.",
   "tr": "Bu dünyanın güvenli olduğunu sanıyorduk... geth ortaya çıkana dek."
  },
  {
   "key": "BIOA_PRO00_LOC|pro10_banter_00_D|159679",
   "en": "It used to be beautiful here.",
   "tr": "Burası eskiden güzeldi."
  },
  {
   "key": "BIOA_PRO00_LOC|pro10_banter_00_D|159680",
   "en": "Somebody's going to pay for this.",
   "tr": "Birileri bunun bedelini ödeyecek."
  },
  {
   "key": "BIOA_PRO00_LOC|pro10_banter_00_D|159681",
   "en": "Let's get the bastards.",
   "tr": "Hadi şu piçleri yakalayalım."
  },
  {
   "key": "BIOA_PRO00_LOC|pro10_banter_00_D|159682",
   "en": "We should move.",
   "tr": "Hareket etmeliyiz."
  },
  {
   "key": "BIOA_PRO00_LOC|pro10_banter_00_D|159684",
   "en": "Oh god. What happened here?",
   "tr": "Aman Tanrım. Burada ne oldu?"
  }
 ]
