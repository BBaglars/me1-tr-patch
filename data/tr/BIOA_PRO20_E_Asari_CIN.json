 "entries": [
  {
   "key": "BIOA_PRO20_E_Asari_CIN|pro20_end_cutscene_matriarch_d|62647",
   "en": "We identified the ship that touched down on Eden Prime. The Normandy. A human Alliance vessel.",
   "tr": "Eden Prime'a inen gemiyi tespit ettik. Normandy. İnsan İttifak gemisi."
  },
  {
   "key": "BIOA_PRO20_E_Asari_CIN|pro20_end_cutscene_matriarch_d|62649",
   "en": "It was under the command of Captain Anderson.",
   "tr": "Kaptan Anderson'ın komutasındaydı."
  },
  {
   "key": "BIOA_PRO20_E_Asari_CIN|pro20_end_cutscene_matriarch_d|62651",
   "en": "They managed to save the colony.",
   "tr": "Koloniyi kurtarmayı başardılar."
  },
  {
   "key": "BIOA_PRO20_E_Asari_CIN|pro20_end_cutscene_matriarch_d|62652",
   "en": "And the beacon?",
   "tr": "Peki ya işaret fişeği?"
  },
  {
   "key": "BIOA_PRO20_E_Asari_CIN|pro20_end_cutscene_matriarch_d|62653",
   "en": "One of the humans may have used it.",
   "tr": "İnsanlardan biri kullanmış olabilir."
  },
  {
   "key": "BIOA_PRO20_E_Asari_CIN|pro20_end_cutscene_matriarch_d|62655",
   "en": "This human must be eliminated.",
   "tr": "Bu insan yok edilmeli."
  },
  {
   "key": "BIOA_PRO20_E_Asari_CIN|pro20_end_cutscene_matriarch_d|143381",
   "en": "Argh! Rarh! Argh!",
   "tr": "Argh! Rarh! Argh!"
  }
 ]
}
