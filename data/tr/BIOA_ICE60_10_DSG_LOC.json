{
 "meta": {
  "package": "BIOA_ICE60_10_DSG_LOC_INT.pcc",
  "stem": "BIOA_ICE60_10_DSG_LOC",
  "textLang": "INT",
  "sets": 1
 },
 "entries": [
  {
   "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81817",
   "en": "Your mission ends here, Shepard.",
   "tr": "Görevin burada bitiyor Shepard."
  },
  {
   "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81818",
   "en": "What the hell?",
   "tr": "Ne oluyor be?"
  },
  {
   "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81819",
   "en": "I didn't have permission to come in. He got in my way.",
   "tr": "İçeri girmek için iznim yoktu. Yoluma çıktı."
  },
  {
   "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81820",
   "en": "You're not as stupid as you look.",
   "tr": "Göründüğün kadar aptal değilsin."
  },
  {
   "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81821",
   "en": "You saw what you expected. Nothing more.",
   "tr": "Beklediğini gördün. Fazlasını değil."
  },
  {
   "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81822",
   "en": "I was assigned to keep an eye on things here.",
   "tr": "Buradaki işlere göz kulak olmakla görevlendirildim."
  },
  {
   "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81823",
   "en": "I was ordered to eliminate you, should the opportunity arise. And here you are, trapped in this lab.",
   "tr": "Fırsat çıkarsa seni ortadan kaldırmam emredildi. Ve işte buradasın, bu laboratuvarda kapana kısılmış."
  },
  {
   "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81824",
   "en": "Weapons free!",
   "tr": "Silahlar serbest!"
  },
  {
   "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81825",
   "en": "What the hell?",
   "tr": "Ne oluyor be?"
  },
  {
   "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81826",
   "en": "We'll see about that, bitch.",
   "tr": "Bakalım o nasıl olacak cadı."
  },
  {
   "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81827",
   "en": "Ambush.",
   "tr": "Pusu."
  },
  {
   "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81828",
   "en": "I thought she seemed odd.",
   "tr": "Garip göründüğünü düşünmüştüm."
  },
  {
   "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81830",
   "en": "You're a sleeper agent for Benezia.",
   "tr": "Benezia'nın uyuyan ajanısın."
  },
  {
   "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81831",
   "en": "What happened to Ventralis' man?",
   "tr": "Ventralis'in adamına ne oldu?"
  },
  {
   "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81833",
   "en": "She's surrounded by geth and pointing a gun at us. Shoot her!",
   "tr": "Geth'lerle çevrili ve bize silah doğrultuyor. Vurun onu!"
  },
  {
   "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81835",
   "en": "I thought you were a scientist.",
   "tr": "Bilim insanı olduğunu sanmıştım."
  },
  {
   "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81837",
   "en": "You're the asari from the mess hall.",
   "tr": "Yemekhanedeki asari'sin."
  },
  {
   "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81841",
   "en": "You work for the Matriarch.",
   "tr": "Matriarch için çalışıyorsun."
  },
  {
   "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81842",
   "en": "Where's the guard?",
   "tr": "Muhafız nerede?"
  },
  {
   "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81843",
   "en": "Kill her.",
   "tr": "Öldürün onu."
  },
  {
   "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81844",
   "en": "You lied to me.",
   "tr": "Bana yalan söyledin."
  },
  {
   "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81845",
   "en": "I've seen you.",
   "tr": "Seni gördüm."
  }
 ]
}
