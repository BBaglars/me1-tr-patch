   "tr": "İnatçı kız."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|104653",
   "en": "Lovely girl.",
   "tr": "Sevimli kız."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|104655",
