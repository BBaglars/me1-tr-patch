 "entries": [
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|77274",
   "en": "Hi! I'll be with you in just a sec.",
   "tr": "Merhaba! Bir saniye içinde sizinle ilgileneceğim."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80508",
   "en": "I don't know what you're talking about. Now, if you don't mind I need to get back to my customers.",
   "tr": "Ne dediğini bilmiyorum. Şimdi sakıncası yoksa müşterilerime dönmem gerek."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80511",
   "en": "I will, thank you.",
   "tr": "Yapacağım, teşekkürler."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80512",
   "en": "Now you sound like my sister. Why is everyone so concerned about me? I can take care of myself.",
   "tr": "Şimdi kız kardeşim gibi konuşuyorsun. Neden herkes benim için bu kadar endişeleniyor? Kendime bakabilirim."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80513",
   "en": "I need to go. I'm not a stripper. I don't get paid to stand around and look pretty.",
   "tr": "Gitmem lazım. Ben striptizci değilim. Öylece durup güzel görünmem için para almıyorum."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80514",
   "en": "Why do I get the feeling you're not here to order drinks?",
   "tr": "Neden içki sipariş etmeye gelmediğin hissine kapılıyorum?"
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80515",
   "en": "I'm busy. The other waitresses can help you.",
   "tr": "Meşgulüm. Diğer garsonlar size yardım edebilir."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80516",
   "en": "Not now. I'm busy.",
   "tr": "Şimdi olmaz. Meşgulüm."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80517",
   "en": "I've got nothing to say to you.",
   "tr": "Sana söyleyecek bir şeyim yok."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80518",
   "en": "I need to talk to you about your work with C-Sec.",
   "tr": "C-Sec ile çalışman hakkında seninle konuşmam gerek."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80521",
   "en": "Have it your way.",
   "tr": "Nasıl istersen."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80522",
   "en": "This isn't a game, Jenna. These people are dangerous.",
   "tr": "Bu bir oyun değil Jenna. Bu insanlar tehlikeli."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80524",
   "en": "I'll wait right here.",
   "tr": "Tam burada bekleyeceğim."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80525",
   "en": "This will be quick.",
   "tr": "Kısa sürecek."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80526",
   "en": "Make time now.",
   "tr": "Şimdi zaman ayır."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80527",
   "en": "Okay.",
   "tr": "Tamam."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80530",
   "en": "Fine. Forget it.",
   "tr": "Peki. Boş ver."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80531",
   "en": "Don't be stupid.",
   "tr": "Aptal olma."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80534",
   "en": "Sorry.",
   "tr": "Üzgünüm."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|88505",
   "en": "Hey there. Welcome to Flux.",
   "tr": "Merhaba. Flux'a hoş geldiniz."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|88506",
   "en": "I'll be right over.",
   "tr": "Hemen geliyorum."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|88507",
   "en": "Take a seat. Someone will be with you soon.",
   "tr": "Oturun. Biri hemen sizinle ilgilenecek."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|93754",
   "en": "Because I'm not.",
   "tr": "Çünkü değilim."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|100094",
   "en": "Sorry, I'll get to you when I can.",
   "tr": "Üzgünüm, fırsat bulunca size bakacağım."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|100095",
   "en": "Hi. Be with you in a minute.",
   "tr": "Merhaba. Bir dakikaya yanınızdayım."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|100096",
   "en": "Enjoy the entertainment. I'll get to you soon.",
   "tr": "Eğlencenin tadını çıkarın. Yakında yanınıza geleceğim."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|104649",
   "en": "Charming girl.",
   "tr": "Hoş kız."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|104650",
   "en": "Tough girl.",
   "tr": "Sert kız."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|104651",
   "en": "She puts on a brave face.",
   "tr": "Cesur bir yüz takınıyor."
  },
  {
   "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|104652",
