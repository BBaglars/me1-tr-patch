{
  "meta": {
    "package": "BIOA_UNC52_02_DSG_LOC_DE.pcc",
    "stem": "BIOA_UNC52_02_DSG_LOC",
    "textLang": "DE",
    "sets": 2
  },
  "entries": [
    {
      "key": "BIOA_UNC52_02_DSG_LOC|prc1_cutscene_discovered_D|175490",
      "en": "Rein da.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_02_DSG_LOC|prc1_cutscene_discovered_D|175491",
      "en": "Aaron.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_02_DSG_LOC|prc1_cutscene_discovered_D|175492",
      "en": "Sagen Sie uns, wem Sie geholfen haben.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_02_DSG_LOC|prc1_cutscene_discovered_D|175493",
      "en": "Ich werd Sie nicht noch mal fragen.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_02_DSG_LOC|prc1_cutscene_discovered_D|175494",
      "en": "Nein!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_02_DSG_LOC|prc1_cutscene_discovered_D|175495",
      "en": "Raus mit ihr.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_02_DSG_LOC|prc1_cutscene_discovered_D|175496",
      "en": "Und du: Finde das Problem und behebe es.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_02_DSG_LOC|prc1_cutscene_discovered_D|175983",
      "en": "Wer schaltet die Antriebe ab?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_02_DSG_LOC|prc1_cutscene_discovered_D|175984",
      "en": "Ich werd Sie nicht noch mal fragen.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_02_DSG_LOC|prc1_cutscene_discovered_D|175985",
      "en": "Nein!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_02_DSG_LOC|prc1_cutscene_discovered_D|175986",
      "en": "Raus mit ihr.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_02_DSG_LOC|prc1_cutscene_discovered_D|175987",
      "en": "Finde das Problem und behebe es!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_02_DSG_LOC|prc1_human_radio_D|175196",
      "en": "Sind Sie da? Sie müssen sich beeilen. Sie haben sie ernsthaft sauer gemacht.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_02_DSG_LOC|prc1_human_radio_D|175197",
      "en": "Ihr Anführer bringt überall Sprengladungen an. Ich glaube, er will die ganze Anlage hochjagen.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_02_DSG_LOC|prc1_human_radio_D|175198",
      "en": "Verschwinden Sie da.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_02_DSG_LOC|prc1_human_radio_D|175199",
      "en": "Nicht schießen. Bitte.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_02_DSG_LOC|prc1_human_radio_D|175336",
      "en": "Sie sind auf dem richtigen Weg.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_02_DSG_LOC|prc1_human_radio_D|175338",
      "en": "Ich weiß nicht, wer Sie sind, aber ich ... Mist! Muss weg.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_02_DSG_LOC|prc1_human_radio_D|175340",
      "en": "Können Sie mich hören? Ich habe zu viele Interferenzen auf diesem Kanal.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_02_DSG_LOC|prc1_human_radio_D|175341",
      "en": "Verdammtes Ding! Tut mir leid, aber ich habe einige Rückkopplungen.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_02_DSG_LOC|prc1_human_radio_D|175834",
      "en": "Mal sehen, ob ich es reparieren kann. Machen Sie in der Zwischenzeit einfach so weiter.",
      "tr": ""
    }
  ]
}