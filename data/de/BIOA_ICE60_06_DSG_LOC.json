{
  "meta": {
    "package": "BIOA_ICE60_06_DSG_LOC_DE.pcc",
    "stem": "BIOA_ICE60_06_DSG_LOC",
    "textLang": "DE",
    "sets": 8
  },
  "entries": [
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_ambient_scientist_3_D|80779",
      "en": "Ich bin unbewaffnet!",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_ambient_scientist_3_D|80780",
      "en": "Ich mache auch keinen Ärger! Ehrlich nicht!",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_ambient_scientist_3_D|80782",
      "en": "Ich wünschte, man würde uns arbeiten lassen. Wenn ich was zu tun hätte, würde ich nicht ständig daran denken, dass wir ...",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_ambient_scientist_3_D|80783",
      "en": "Zev sagt, die anderen kommen wieder auf die Beine. Dann sind sie wohl wach, wenn sie gefressen werden.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_ambient_scientist_3_D|80786",
      "en": "Was war das für ein Lärm? Sind Rachni da reingekommen? Haben Sie sie getötet?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_ambient_scientist_3_D|80790",
      "en": "Könnte schlimmer sein, was? Ich könnte einer von denen auf der Krankenstation sein.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_ambient_scientist_3_D|80792",
      "en": "Immer gute Miene zum bösen Spiel machen. Wenn Sie nicht lachen, müssen Sie ... Äh, ja. Man muss einfach ...",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_ambient_scientist_3_D|80793",
      "en": "Ich hätte Urlaub einreichen sollen. Nein, ich hätte die letzten paar Allele analysieren müssen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_ambient_scientist_3_D|80794",
      "en": "Dank Ventralis leben wir noch. Er muss wissen, was er tut.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_ambient_scientist_3_D|80795",
      "en": "Sie unternehmen doch was gegen diese Viecher, oder?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_ambient_scientist_4_D|80815",
      "en": "Ich bin nicht bewaffnet!",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_ambient_scientist_4_D|80816",
      "en": "Aufhören! Ich bin keine Bedrohung!",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_ambient_scientist_4_D|80818",
      "en": "Vielleicht nehmen diese Erbsenzähler meine Bitte um mehr Sicherheitsvorkehrungen im Labor ernst.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_ambient_scientist_4_D|80822",
      "en": "Bevor die Verbindung zur Zentrale wiederhergestellt wurde, kam unsere Energie aus Batterien.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_ambient_scientist_4_D|80823",
      "en": "Im Moment habe ich mehr Angst vor den Wachen. Die sind mir eine Spur zu reizbar.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_ambient_scientist_4_D|80825",
      "en": "Meine Albträume sahen früher genau so aus. Zu viel billiger Horror-Trash vor dem Lichtausmachen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_ambient_scientist_4_D|80826",
      "en": "Können Sie uns von diesem Berg wegbringen?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_ambient_scientist_4_D|80827",
      "en": "Ich hätte nie gedacht, dass wir die Wachen hier mal brauchen würden.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82217",
      "en": "Wo ich auch hingehe, bin ich der einzige Überlebende. Vielleicht sollten Sie lieber Abstand halten.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82219",
      "en": "Sie kamen da raus.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82220",
      "en": "Was?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82221",
      "en": "Über die Rachni?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82222",
      "en": "Rachni? Das ist doch lächerlich.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82223",
      "en": "Verarschen Sie mich nicht. Das können keine Rachni sein.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82224",
      "en": "Rachni? Das glaube ich nicht.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82225",
      "en": "\"Rachni\"? Ich glaube, das habe ich schon mal gehört.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82226",
      "en": "Das Wort habe ich schon mal gehört.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82235",
      "en": "Sie fanden es in einem verlassenen Schiff. Das Ei. Wartete dort seit den letzten Angriffen. Sie brachten es hierher ...",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82236",
      "en": "Halt die Klappe! Himmel! Willst du, dass wir alle umgebracht werden?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82237",
      "en": "Ich habe keine Kontrolle darüber, wer hier lebt oder stirbt. Du etwa?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82238",
      "en": "Wenn du durchknallst, dann bitte leise.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82239",
      "en": "Es ist möglich. Die Proben reagierten empfindlich auf Biotik.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82241",
      "en": "Ich habe sie umgebracht.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82242",
      "en": "Was?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82243",
      "en": "Wen?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82244",
      "en": "Antworten Sie!",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82245",
      "en": "Wen?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82246",
      "en": "Was?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82247",
      "en": "Doktor Zhonmua. Wir waren auf dem Weg zum Mittagessen, als der Alarm losging. Ich lief zur Bahn und schloss die Türen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82249",
      "en": "Sie hämmerte einmal an das Fenster, dann filetierten sie sie in kleine Stücke. Ihr Kopf zerplatzte wie eine reife Melone.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82250",
      "en": "Ich habe die Tür geschlossen. Ich habe sie umgebracht.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82251",
      "en": "Glauben Sie, ich will Absolution? Es gibt keine.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82252",
      "en": "Natürlich. Da haben Sie vollkommen Recht.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82253",
      "en": "Ja.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82254",
      "en": "Sie sind wegen denen hier, nicht wahr?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82255",
      "en": "Ich wünschte, ich wäre verrückt. Dann wäre alles einfacher.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82257",
      "en": "Ich bin Olar. Han Olar.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82258",
      "en": "Ich möchte mehr über diese Dinger wissen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82265",
      "en": "Wo sind die hergekommen?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82266",
      "en": "Sie stecken da mit drin. Was können Sie mir erzählen?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82270",
      "en": "Könnte Matriarchin Benezia im Sicherheitslabor überlebt haben?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82272",
      "en": "Ich habe gehört, dass Sie im Sicherheitslabor waren. Wie konnten Sie lebendig da rauskommen?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82282",
      "en": "Sagen Sie mir, was Sie wissen. Ich sorge dafür, dass Ihr Überleben einen Sinn ergibt.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82283",
      "en": "Das Einzige, was Sie tun konnten, war sich selbst zu retten.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82284",
      "en": "Hätten Sie anders gehandelt, wären Sie jetzt auch tot.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82285",
      "en": "Ich gehe dann jetzt.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82287",
      "en": "Meinen Sie die Viecher da draußen?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82288",
      "en": "Machen Sie auf geheimnisvoll oder sind Sie einfach nur irre?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82291",
      "en": "Und wer sind Sie?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82292",
      "en": "Was ist mit den Aliens?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82293",
      "en": "Benezia",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82294",
      "en": "Ihr Überleben",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82295",
      "en": "Auf Wiedersehen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82298",
      "en": "Wie sind die hierher gekommen?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82299",
      "en": "Was wissen Sie?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82317",
      "en": "Dann helfen Sie mir.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82318",
      "en": "Besser sie als Sie.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82319",
      "en": "Sie haben getan, was Sie tun mussten.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82321",
      "en": "Meinen Sie die Aliens?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82322",
      "en": "Sind Sie immer so vage?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|82323",
      "en": "Wer sind Sie?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|83985",
      "en": "Was glauben Sie denn? Wir wissen, was sie getan haben.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|83986",
      "en": "Ein Teamleiter müsste Zugang haben. Wie Dr. Cohen. Sie finden ihn auf der Krankenstation.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|83987",
      "en": "Die Firma will ihre Fehler vertuschen und hat eine Matriarchin geschickt, um uns verschwinden zu lassen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|83988",
      "en": "Benezia? Sie ist am Le...? Sie ist hier?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|83993",
      "en": "Sie hat Ventralis befohlen, Sie ins Sicherheitslabor zu schicken. Sie hatte damit gerechnet, dass die Rachni Sie töten.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|83994",
      "en": "Durch den Kontrollpunkt und dann immer der Nase lang. ",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|83996",
      "en": "Machen Sie doch, was Sie wollen. Ich verschwinde von diesem Berg.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|83997",
      "en": "Sind Sie wegen mir hier?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|83998",
      "en": "Machen Sie, was Sie wollen. Es spielt sowieso keine Rolle mehr.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|83999",
      "en": "Bringen wir's hinter uns.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|84001",
      "en": "Die synthetischen Dinger, die Sie angegriffen haben.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|84002",
      "en": "Ich werde nicht zulassen, dass Ihnen was passiert. Warum hat sie versucht, Sie zu töten?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|84003",
      "en": "Ich brauche Ihre volle Aufmerksamkeit. Hören Sie? Was ist hier passiert?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|84004",
      "en": "Wie komme ich in den Servicebereich?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|84005",
      "en": "Die haben es auf das Wissenschaftsteam abgesehen. Warum?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|84013",
      "en": "Zeigen Sie mir die richtige Richtung.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|84017",
      "en": "Dann sammeln wir die Lady mal ein.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|84020",
      "en": "Sie meinen die Ge... Äh, die anorganischen Wesen, die die Asari bei sich hatte?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|84021",
      "en": "Die Tür ist verschlossen. Wie komme ich da rein?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|84022",
      "en": "Wer kam wo raus?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|84023",
      "en": "Sie sind jetzt in Sicherheit.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|84024",
      "en": "Reißen Sie sich zusammen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|84025",
      "en": "Warum wurden Sie angegriffen?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|84033",
      "en": "Wo geht's lang?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|84035",
      "en": "Wir holen sie da raus.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|84040",
      "en": "Die Geth?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|84041",
      "en": "Wie komme ich da rein?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|84042",
      "en": "Hä?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|84043",
      "en": "Was ist mit dem Servicebereich?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|85946",
      "en": "Die Kroganer haben sie vor tausend Jahren ausgerottet.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|85947",
      "en": "Die Rachni sind ausgestorben.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|101473",
      "en": "Durchknallen? Ich bin völlig normal. So normal wie noch nie.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|101474",
      "en": "Ja. Ich bin der einzige Überlebende aus dem Sicherheitslabor.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|101475",
      "en": "Ich habe Ihnen alles gesagt, was ich weiß. Wir haben die Rachni wiederbelebt. Im Nachhinein nicht die klügste Entscheidung.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|102842",
      "en": "Benezia brachte sie mit.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|147261",
      "en": "Ich will alles über die Rachni wissen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|147262",
      "en": "Erzählen Sie mir von den Rachni.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_hanolar_D|163537",
      "en": "Sie ist jetzt dort?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_quarantine_guard_D|81777",
      "en": "Was wollen Sie hier?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_quarantine_guard_D|81778",
      "en": "Ja, genau.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_quarantine_guard_D|81780",
      "en": "Ich sagte, Sie sollen verschwinden.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_quarantine_guard_D|81781",
      "en": "Wissen Sie, was da drin ist? Wollen Sie uns alle umbringen?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_quarantine_guard_D|81782",
      "en": "In den letzten drei Tagen habe ich genau vier Stunden geschlafen. Ich brauche diesen Scheiß nicht.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_quarantine_guard_D|81783",
      "en": "Und ich dachte, das würde 'ne ruhige Schicht.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_quarantine_guard_D|81784",
      "en": "Sie gehören nicht zur Crew.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_quarantine_guard_D|81785",
      "en": "Es gibt keine menschlichen Spectre.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_quarantine_guard_D|81786",
      "en": "Na toll. Noch ein Mensch, der rumläuft, wo er nichts zu suchen hat.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_quarantine_guard_D|81788",
      "en": "Hören Sie mal, dieser Plage ist es egal, wer Sie sind. Dieses Labor steht unter Quarantäne.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_quarantine_guard_D|81789",
      "en": "Richtig, das hat er durchgegeben. Er sagte auch, dass Sie, um wieder rauszukommen, beweisen müssen, dass Sie nicht kontaminiert sind.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_quarantine_guard_D|81790",
      "en": "Wenn Sie 'ne Todessehnsucht verspüren, können Sie auch an der Barrikade Wache schieben.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_quarantine_guard_D|81791",
      "en": "Nichts. Entschuldigen Sie die Störung.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_quarantine_guard_D|81794",
      "en": "Nennen Sie mich Shepard. Ich bin ein Spectre und wurde von der Citadel geschickt.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_quarantine_guard_D|81796",
      "en": "Commander Shepard von der Allianz-Navy. ",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_quarantine_guard_D|81798",
      "en": "Ich heiße Shepard.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_quarantine_guard_D|81801",
      "en": "Ich habe Ventralis' Erlaubnis, da reinzugehen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_quarantine_guard_D|81804",
      "en": "Auf Wiedersehen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_quarantine_guard_D|81807",
      "en": "Ich bin ein Spectre.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_quarantine_guard_D|81808",
      "en": "Allianz-Navy",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_quarantine_guard_D|81809",
      "en": "Ich bin Shepard.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_quarantine_guard_D|81810",
      "en": "Ich will ein Heilmittel finden.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig06_science_joke_D|80840",
      "en": "Okay, der hier haut dich um!",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig06_science_joke_D|80841",
      "en": "Wie kannst du jetzt Witze erzählen?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig06_science_joke_D|80842",
      "en": "Also ein Wasserstoffatom sagte zum anderen: \"Ich habe mein Elektron verloren!\"",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig06_science_joke_D|80843",
      "en": "Da sagt das andere Wasserstoffatom: \"Mann, bist du dir ganz sicher?\"",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig06_science_joke_D|80844",
      "en": "\"Positiv!\"",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig06_science_joke_D|80845",
      "en": "Halt einfach die Klappe. Himmel! ",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig06_science_joke_D|97296",
      "en": "Den kenn ich.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig10_lab_exit_D|81851",
      "en": "Commander. Sieht aus, als hätte diese Asari-\"Doktorin\" die Wache getötet.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig10_lab_exit_D|81852",
      "en": "Hm. Die Asari hat die Wache erwürgt. Keine Zeugen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig10_lab_exit_D|81853",
      "en": "Commander. Sieht aus, als hätte diese Asari-\"Doktorin\" die Wache getötet.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig10_lab_exit_D|81854",
      "en": "Commander. Sieht aus, als hätte diese Asari-\"Doktorin\" die Wache getötet.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig10_lab_exit_D|81855",
      "en": "Sie hat die Wache getötet, Shepard. Nur weil sie ihr im Weg stand.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig11_lab_sealed_D|81856",
      "en": "Was?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig11_lab_sealed_D|81857",
      "en": "Dann treten Sie von der Tür zurück.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig11_lab_sealed_D|81858",
      "en": "Könnten Sie die Tür öffnen?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig11_lab_sealed_D|81859",
      "en": "Ich sehe mich nur um.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig11_lab_sealed_D|81860",
      "en": "Wir müssen gehen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig11_lab_sealed_D|81861",
      "en": "Auf Wiedersehen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig11_lab_sealed_D|86651",
      "en": "Haben Sie ein Heilmittel?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig11_lab_sealed_D|86652",
      "en": "Dann lassen Sie mal sehen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig11_lab_sealed_D|86653",
      "en": "Der Captain sagte, ich bin dafür verantwortlich, dass Sie hier nicht jeden kontaminieren. Ich will ein Heilmittel in Ihrer Hand sehen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig11_lab_sealed_D|86654",
      "en": "Natürlich.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig11_lab_sealed_D|86656",
      "en": "Noch nicht.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig11_lab_sealed_D|86659",
      "en": "[LÜGEN] Ja.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig11_lab_sealed_D|86660",
      "en": "Nein.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig11_lab_sealed_D|120386",
      "en": "Kommen Sie mir nicht so, Mister. Machen Sie die verdammte Tür auf.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig11_lab_sealed_D|120387",
      "en": "Haben Sie 'n Problem mit den Ohren? Lassen Sie mich raus.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig11_lab_sealed_D|120388",
      "en": "Lassen Sie mich raus.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig11_lab_sealed_D|120389",
      "en": "Aufmachen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig12_olar_execution_D|81879",
      "en": "Höre ich jetzt das berühmte \"Sie wissen zu viel\"?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_06_DSG_LOC|ice60_trig12_olar_execution_D|81880",
      "en": "Halt die Klappe.",
      "tr": ""
    }
  ]
}