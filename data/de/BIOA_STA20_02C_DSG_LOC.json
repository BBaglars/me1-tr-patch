    {
      "key": "BIOA_STA20_02C_DSG_LOC|sta00_cab_D|159576",
      "en": "Bitte wählen Sie ein Ziel für den Citadel Rapid Transit aus.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02C_DSG_LOC|sta20_amb_parks_wealthy_D|85353",
      "en": "Das ist ja gar nichts. Mein Büro ist bereits fünf Mal umgebaut worden.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02C_DSG_LOC|sta20_amb_parks_wealthy_D|85354",
      "en": "Fünf Mal? Aber warum? Was versprechen die sich davon?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02C_DSG_LOC|sta20_amb_parks_wealthy_D|85355",
      "en": "Woher soll ich das wissen? Die Keeper geben ja nie Erklärungen ab.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02C_DSG_LOC|sta20_amb_parks_wealthy_D|85356",
      "en": "Und trotzdem lässt man sie machen, was sie für richtig halten.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02C_DSG_LOC|sta20_amb_parks_wealthy_D|85357",
      "en": "Wir haben ja keine Wahl. Wenn man versucht, sie aufzuhalten, schalten sie einfach ab und werden durch einen anderen ersetzt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02C_DSG_LOC|sta20_amb_parks_wealthy_D|85358",
      "en": "Eigentlich seltsam, dass wir so wenig von ihnen wissen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02C_DSG_LOC|sta20_amb_parks_wealthy_D|85359",
      "en": "Und es ist frustrierend.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02C_DSG_LOC|sta20_amb_parks_wealthy_D|85360",
      "en": "Ich bin häufiger hingegangen, als es noch das \"Archos\" war.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02C_DSG_LOC|sta20_amb_parks_wealthy_D|85361",
      "en": "Ja, aber seit Fist es übernommen hat, gehe ich da auch nicht mehr hin.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02C_DSG_LOC|sta20_amb_parks_wealthy_D|85362",
      "en": "Die besten Lounges werden scheinbar von Läden wie Choras Nest ersetzt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02C_DSG_LOC|sta20_amb_parks_wealthy_D|85363",
      "en": "Die Botschafter-Lounge ist nicht schlecht. Aber das Entertainment-Programm ist totlangweilig.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02C_DSG_LOC|sta20_amb_parks_wealthy_D|85364",
      "en": "Sie wird halt von Bürokraten geführt. Wahrscheinlich haben sie monatelang darüber abgestimmt, was für ein Entertainment-Programm laufen soll.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02C_DSG_LOC|sta20_amb_parks_wealthy_D|85365",
      "en": "Hey, das ist gar nicht unwahrscheinlich.",
      "tr": ""
    }
  ]
