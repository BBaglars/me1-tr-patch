{
  "meta": {
    "package": "BIOA_STA60_02b_DSG_LOC_DE.pcc",
    "stem": "BIOA_STA60_02b_DSG_LOC",
    "textLang": "DE",
    "sets": 3
  },
  "entries": [
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|83397",
      "en": "Hallo. Willkommen in Morlans berühmtem Geschäft. Brauchen Sie viele gute Vorräte?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|83398",
      "en": "Aber mir wurde gesagt, dass der Doktor sie herbringt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|83399",
      "en": "Es hat eine Planänderung gegeben.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|83400",
      "en": "Eine Änderung? Aber ... der Doktor ... ich ... das ist nicht richtig, Mensch.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|83404",
      "en": "Was zum Teufel ist hier los? Wer sind Sie?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|83405",
      "en": "Wir können das beenden, wenn Sie mir diese Vorräte bringen. Sonst erzähle ich den Leuten das kleine Geheimnis des Doktors.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|83407",
      "en": "Hey, Moment mal! Ich bin hier bloß der Mittelsmann.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|83409",
      "en": "Das ist weitaus mehr, als ich erwartet habe.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|83410",
      "en": "Danke, Mensch. Ist schön, ihn mal so demütig zu sehen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|83413",
      "en": "Ich werde nicht kampflos untergehen!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|83414",
      "en": "Sie erwarten eine Lieferung medizinischer Vorräte.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|83422",
      "en": "Lassen Sie den Doktor in Ruhe.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|83423",
      "en": "Lassen Sie den Doktor in Ruhe. Oder Sie kriegen's mit mir zu tun.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|83425",
      "en": "Sie schließen eine medizinische Klinik. Was ist, wenn jemand Behandlung braucht? Was ist, wenn Sie Behandlung brauchen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|83426",
      "en": "Ihr Geheimnis bleibt begraben, oder ich begrabe Sie.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|83432",
      "en": "Das Geheimnis stirbt mit Ihnen!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|83434",
      "en": "Ich bin wegen Dr. Michel hier.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|83443",
      "en": "Ein Freund von Dr. Michel.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|83444",
      "en": "Es ist vorbei.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|83447",
      "en": "Denken Sie noch mal darüber nach.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|83448",
      "en": "Reden oder sterben Sie!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|83449",
      "en": "Töten Sie ihn.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|84063",
      "en": "Oh, Sie werden zufrieden sein, denke ich. Ich habe sehr schöne Dinge, Sie werden schon sehen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|84064",
      "en": "Lassen Sie mal sehen, was Sie haben.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|84065",
      "en": "Ich brauche Vorräte.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|88510",
      "en": "Ja, in Ordnung. Viel Glück, Mensch.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|88511",
      "en": "Auf Wiedersehen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|88512",
      "en": "Ich muss gehen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|88513",
      "en": "Auf Wiedersehen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|90394",
      "en": "Ich habe ihn nie getroffen, Mensch. Ich kannte nur den, der mit dem Doktor gesprochen hat.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|90395",
      "en": "Was wissen Sie über Banes?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|90396",
      "en": "Wer ist Banes?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|102484",
      "en": "Kleine Planänderung.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|102485",
      "en": "Die Dinge haben sich geändert, Morlan.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|102486",
      "en": "Kleine Planänderung.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|102487",
      "en": "Kleine Planänderung.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|105011",
      "en": "Ja, Mensch? Brauchen Sie etwas?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|105012",
      "en": "Halten Sie den Mund. Ich hab Banes gesagt, dass Sie's vermasseln!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|105015",
      "en": "Nur, wenn Sie bereit sind, zufrieden zu sterben.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|105016",
      "en": "Dann machen wir's auf die harte Tour!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|105021",
      "en": "Vielleicht finden wir einen Weg, der beide Seiten zufrieden stellt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|105022",
      "en": "Sie werden vom Doktor nichts bekommen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|105025",
      "en": "Ihr schlimmster Albtraum.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|105027",
      "en": "Finden wir eine Lösung.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|105028",
      "en": "Kein Deal.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|124127",
      "en": "Nun, jetzt wird sich hier gewiss einiges ändern.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|124128",
      "en": "Zum Besseren. Er war ein Tier. Ein richtiger Tyrann.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|173711",
      "en": "[Objekte anzeigen]",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|173712",
      "en": "[Panzerungen anzeigen]",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|173713",
      "en": "[Standardobjekte anzeigen]",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_black_market_D|173714",
      "en": "[Nichtmenschliche Panzerungen anzeigen]",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77272",
      "en": "Bleiben Sie da stehen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77893",
      "en": "Werfen Sie die Daten rüber, dann können Sie gehen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77894",
      "en": "Ich bin nicht gekommen, um Spielchen zu spielen, Mensch.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77895",
      "en": "Sie wissen, wer ich bin, und ich weiß, dass Sie bluffen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77896",
      "en": "Das sehe ich anders, Mensch.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77897",
      "en": "Ich werde Sie noch ein Mal bitten. Geben Sie mir die Daten, dann können Jahleed und Sie weiterleben.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77899",
      "en": "Gut, wie Sie wollen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77900",
      "en": "Warten Sie! Ich gebe auf. Ich gebe auf! Bitte ... töten Sie mich nicht!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77901",
      "en": "Nein! Hören Sie, Jahleed kann die Daten haben. Ich will sie nicht. Nicht, wenn ich dafür sterben muss.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77902",
      "en": "Was sind das für Daten? Warum sind sie so wichtig?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77903",
      "en": "Ich dachte, das wissen Sie; er sagte, Sie würden sie liefern.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77905",
      "en": "Es ist so gut wie unmöglich, die Keeper zu scannen, und man kann sie nicht fangen oder ihnen Proben entnehmen. Sie zerstören sich einfach selbst.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77906",
      "en": "Wir sind seit Jahrhunderten hier und wissen nichts über sie.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77909",
      "en": "Wir verloren die Übersicht. Wir wollten diese Gelegenheit einfach nicht verpassen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77910",
      "en": "Aber das ist jetzt egal. Ich möchte am Leben bleiben. Es ist mir egal, ob ich diese Daten jemals wiedersehe.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77911",
      "en": "Das werde ich - bei der Forschung bleiben, meine ich. Danke. Auf Wiedersehen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77912",
      "en": "Das werde ich - ich meine, Sie nicht wiedersehen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77913",
      "en": "Was wollen Sie wegen Jahleed unternehmen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77916",
      "en": "Was? Nein! Bitte!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77918",
      "en": "Was für Daten? Wovon reden Sie?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77920",
      "en": "Wenn ich Sie noch mal sehe, bin ich das Letzte, was Sie sehen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77922",
      "en": "Wir werden uns mal mit unserem molligen Freund unterhalten.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77923",
      "en": "Ich werde ihm zeigen, was mit Leuten passiert, die mich anlügen!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77924",
      "en": "Ich werde später mit ihm reden.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77925",
      "en": "Das kommt nicht in Frage. Niemand greift mich an und geht dann einfach weg.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77927",
      "en": "Wer sind Sie? Was wollen Sie?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77929",
      "en": "Lassen Sie die Waffen fallen. Sofort!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77932",
      "en": "Wir haben das, was Sie suchen, nicht.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77933",
      "en": "Die Sache muss nicht gleich aus dem Ruder laufen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77934",
      "en": "Kommen Sie und holen Sie sie. Das wird Ihr letzter Fehler sein.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77935",
      "en": "Warum sollte ich Sie nicht auf der Stelle töten? Warum sind Sie bereit, für diese Daten zu sterben?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77936",
      "en": "Was an diesen Daten ist so wichtig? Warum wollen Sie sie haben?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77937",
      "en": "Ich kann meine Waffe erst wegstecken, wenn der Job erledigt ist.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77946",
      "en": "Also wollen Sie nur wiederhaben, was Jahleed gestohlen hat.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77947",
      "en": "Ich sollte Sie beide töten.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77949",
      "en": "Sie sollten bei der Forschung bleiben und die Spionage uns überlassen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77951",
      "en": "Daten?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77952",
      "en": "Wer sind Sie?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77953",
      "en": "Zurück mit Ihnen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77958",
      "en": "Es gibt keine Daten.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77959",
      "en": "Lassen Sie uns drüber reden.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77960",
      "en": "Nur über meine Leiche.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77961",
      "en": "Warum nicht?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77962",
      "en": "Überzeugen Sie mich.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77963",
      "en": "Zu schade.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77973",
      "en": "Was?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77974",
      "en": "Verstehe.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77975",
      "en": "(seufz)",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77977",
      "en": "Gut. Gehen Sie.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77978",
      "en": "Verschwinden Sie von hier.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77979",
      "en": "Sie bleiben hier.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77982",
      "en": "Zeit für eine Unterhaltung.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77983",
      "en": "Ich werde ihn töten.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|77984",
      "en": "Um den kümmern wir uns später.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|101155",
      "en": "Warum sind diese Daten so wichtig?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|101156",
      "en": "Warum sind diese Daten so wichtig?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|101157",
      "en": "Was ist an diesen Daten so wichtig?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|101158",
      "en": "Was macht diese Daten so wertvoll?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|101163",
      "en": "Was ist mit Jahleed?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|101164",
      "en": "Was sollen wir wegen des verlogenen Volus unternehmen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|101165",
      "en": "Was sollen wir wegen Jahleed unternehmen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|101166",
      "en": "Was ist mit dem Volus? Was sollen wir wegen ihm unternehmen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|113732",
      "en": "Männer.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145320",
      "en": "Die Initialisierungsdaten. Vom Scannen der Keeper.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145321",
      "en": "Es ist so: Wir haben ein paar Daten von der Arbeit gestohlen, um die Scanner zu bauen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145322",
      "en": "Wir sollten eigentlich zusammenarbeiten. Ich sammle die Daten, er analysiert sie.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145323",
      "en": "Commander. Ich habe nicht erwartet, Sie noch einmal zu sehen. Was kann ich für Sie tun?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145324",
      "en": "Ich weiß gar nicht, worauf Sie anspielen. Meine Experimente sind ...",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145325",
      "en": "Wir glauben Ihnen kein Wort. Jahleed hat uns erzählt, dass Sie ihn verfolgen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145326",
      "en": "Schluss mit dem Gefasel. Ihr Freund, Jahleed, hat uns von Ihnen erzählt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145327",
      "en": "Ihre Lügen sind offensichtlich. Wir haben mit Ihrem Freund, Jahleed, gesprochen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145328",
      "en": "Schluss mit dem Gefasel. Jahleed hat uns von Ihren Plänen erzählt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145329",
      "en": "Schluss mit dem Gefasel. Jahleed hat uns erzählt, dass Sie ihn verfolgen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145330",
      "en": "Sie haben mit Jahleed gesprochen ...? Dann wissen Sie von den Daten?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145331",
      "en": "Ihr könnt gehen, Jungs.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145332",
      "en": "Anscheinend haben sich meine Pläne gerade geändert.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145333",
      "en": "Ich bin nicht so übel, wie Sie glauben, Commander. Jahleed und ich waren nur ... verschiedener Meinung.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145334",
      "en": "Das Unternehmen, für das wir arbeiten, hat ein experimentelles Verfahren für den Einsatz in medizinischen Scannern entwickelt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145335",
      "en": "Aber Jahleed und ich haben ein noch viel größeres Potenzial darin gesehen. Also haben wir die Pläne gestohlen und heimlich ein Gerät entwickelt, um die Keeper zu scannen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145336",
      "en": "Können Sie sich das vorstellen? Ein Gerät, mit denen man die Keeper auslesen kann?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145337",
      "en": "Verstehen Sie wirklich nicht? Wir waren die Ersten, die sie jemals gescannt haben!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145338",
      "en": "Sie haben es selbst gesehen, Commander. Und Sie wissen, dass wir es schaffen können.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145340",
      "en": "Ich will ihn gar nicht töten.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145341",
      "en": "Es war Jahleeds Job, unsere ersten Resultate zu veröffentlichen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145342",
      "en": "Aber er entschied, die Daten für sich selbst zu behalten. Vielleicht, um sie zu verkaufen. Ich weiß nicht.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145343",
      "en": "Commander. Wenn Sie für mich weitere Daten sammeln würden ... Stellen Sie sich vor, was wir alles lernen könnten.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145344",
      "en": "Und es wäre auch eine Gelegenheit, einen großen Profit daraus zu schlagen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145345",
      "en": "In Ordnung. Ich habe es verstanden.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145346",
      "en": "Also dann: Keine Scans mehr. Versprochen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145347",
      "en": "Aber Jahleed hat natürlich noch die Initialisierungsdaten. Ich bezweifele, dass er sie zurückgeben will.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145348",
      "en": "Sehr gut. Vielleicht können Sie ja auch gleich mit Jahleed sprechen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145349",
      "en": "Die Daten, die Sie für mich sammeln, sind wertlos, wenn mir Jahleed nicht bei der Analyse hilft.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145350",
      "en": "Danke. Und viel Erfolg beim Scannen, Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145351",
      "en": "Das ist gar nicht so schwierig.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145352",
      "en": "Man muss nur nahe an sie heran und dann einen Scan ausführen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145353",
      "en": "Sie scheinen interessiert. Womöglich genug, um mir zu helfen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145354",
      "en": "Ich gebe Ihnen meinen Scanner.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145355",
      "en": "Wenn Sie einen Keeper sehen, führen Sie einen Scan aus. Diskret, versteht sich.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145356",
      "en": "Für jeden neuen Keeper-Scan führt meine Datenbank ein automatisches Update aus. Und dann führe ich ein Update auf Ihrem Credit-Konto aus.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145357",
      "en": "Und was genau sollte ich denn liefern?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145360",
      "en": "Fangen Sie am besten mit der Wahrheit an, Chorban.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145361",
      "en": "Die Show ist vorbei. Ich will wissen, was hier los ist, Chorban.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145368",
      "en": "Erzählen Sie jetzt alles, was Sie wissen!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145369",
      "en": "Nein. Aber Sie werden es mir gleich sagen. Alles.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145372",
      "en": "Nur weiter.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145375",
      "en": "Und darum die ganze Aufregung?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145376",
      "en": "Was ist daran so Besonderes?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145378",
      "en": "Warum wollen Sie Ihren Partner töten?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145379",
      "en": "Das erklärt noch nicht, warum Sie Ihren Partner töten wollen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145383",
      "en": "Ich werde keine Gesetze brechen, um für Sie zu forschen. Geben Sie zurück, was Sie gestohlen haben, oder ich werde Sie verhaften lassen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145386",
      "en": "Ich kümmere mich schon um Jahleed.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145387",
      "en": "Wenn es doch wissenschaftlichen Zwecken dient, kann ich ja nicht ablehnen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145388",
      "en": "Ein paar Scans sollten sicher kein größeres Problem darstellen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145390",
      "en": "Wenn ich Zeit finde, spreche ich mit ihm.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145391",
      "en": "Ich werde gleich mit ihm sprechen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145392",
      "en": "Wie sammeln Sie die Daten über die Keeper?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145395",
      "en": "Wie kann ich Ihnen helfen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145398",
      "en": "Wusste er das?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145399",
      "en": "Hat er das gesagt?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145402",
      "en": "Verstehe nicht ganz.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145403",
      "en": "Die Wahrheit",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145404",
      "en": "Keine Lügen mehr.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145405",
      "en": "Ich will Antworten.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145412",
      "en": "Noch nicht.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145413",
      "en": "Es reicht!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145414",
      "en": "Daten?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145417",
      "en": "Wieso?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145418",
      "en": "Sprechen Sie weiter.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145421",
      "en": "Das ist alles?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145422",
      "en": "Und?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145423",
      "en": "Verstehe nicht ganz.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145425",
      "en": "Und Jahleed?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145426",
      "en": "Da steckt mehr dahinter.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145430",
      "en": "Schluss jetzt!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145431",
      "en": "Geht klar",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145432",
      "en": "In Ordnung.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145435",
      "en": "Keine Sorge.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145436",
      "en": "Gehen wir.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145437",
      "en": "Er wird nicht davonkommen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145439",
      "en": "Vielleicht",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145440",
      "en": "Natürlich.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145441",
      "en": "Geht klar",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145442",
      "en": "Scannen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145445",
      "en": "Vielleicht",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|145446",
      "en": "Nein danke.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|146136",
      "en": "Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_chorban_D|146137",
      "en": "Wohl nicht.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|77273",
      "en": "Stehen bleiben. Das ist nah genug, Soldat.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81275",
      "en": "Haben Sie mein Geld?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81276",
      "en": "Zeig ihm die Ware.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81277",
      "en": "Scheint in Ordnung zu sein.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81278",
      "en": "Ist sie auch! Diese Mods sind die besten am Markt! Geben Sie mir jetzt meine Credits.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81279",
      "en": "Bitte sehr. Viel Spaß damit.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81280",
      "en": "Das ist eine Falle. Wir wurden reingelegt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81281",
      "en": "Was zum Teufel haben Sie vor?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81282",
      "en": "Haben Sinn für Humor, was? Der bringt Sie eines Tages noch um, Soldat.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81283",
      "en": "Kommt, Männer. Wir sind hier fertig.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81284",
      "en": "Dämlicher Soldat. Tötet ihn!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81285",
      "en": "Dämliche Soldatenbraut. Tötet sie!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81286",
      "en": "Zeig ihr die Waren.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81288",
      "en": "Haben Sie die Mods?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81289",
      "en": "Ich bin nicht zum Gucken hergekommen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81292",
      "en": "Bitte sehr.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81294",
      "en": "Ich nehme die Waffen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81295",
      "en": "Ich nehme Sie fest.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81297",
      "en": "Hier ist Ihr Geld, Jax.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81299",
      "en": "Tut mir Leid, Jax. Das ist Ihr Ende.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81302",
      "en": "Möglicherweise.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81303",
      "en": "Natürlich.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81304",
      "en": "Ja.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81307",
      "en": "Sicher.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81308",
      "en": "Das sehe ich anders.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81309",
      "en": "Sie sind verhaftet.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81312",
      "en": "War nur Spaß.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|81313",
      "en": "Sie haben mich gehört!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|89527",
      "en": "Hm. Es ist niemand gestorben.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|89528",
      "en": "Ich könnte jemanden erschießen, wenn Sie sich dann besser fühlen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|89529",
      "en": "Nein. Schon okay.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|101041",
      "en": "Sieht gut aus.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|101042",
      "en": "Scheint in Ordnung zu sein.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|101043",
      "en": "Das sieht gut aus.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_02b_DSG_LOC|sta60_jax_D|101044",
      "en": "Ja, das sieht gut aus. ",
      "tr": ""
    }
  ]
}