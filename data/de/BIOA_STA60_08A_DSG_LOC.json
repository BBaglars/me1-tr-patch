{
  "meta": {
    "package": "BIOA_STA60_08A_DSG_LOC_DE.pcc",
    "stem": "BIOA_STA60_08A_DSG_LOC",
    "textLang": "DE",
    "sets": 2
  },
  "entries": [
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83456",
      "en": "Sie können und Sie werden es tun. Oder Ihre Geschichte bleibt nicht mehr lange geheim.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83457",
      "en": "Enttäuschen Sie mich nicht, Doktor.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83458",
      "en": "Oh, Commander Shepard. Ich sah Sie nicht reinkommen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83462",
      "en": "Mein früherer Arbeitgeber hat mich gefeuert, weil ich Kliniken wie dieser die Medizin umsonst gab.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83464",
      "en": "Sie haben mich nie angeklagt. Sie wollten nur, dass ich ohne Aufhebens gehe. Aber jemand muss es herausgefunden haben, denn jetzt werde ich erpresst.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83466",
      "en": "Ich muss einem Händler auf dem Markt medizinische Vorräte geben, und zwar heute.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83467",
      "en": "Um ihn kümmern? Kommt meine Vergangenheit dann nicht ans Licht?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83469",
      "en": "Ich soll mit einem Händler namens Morlan unten am Markt sprechen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83470",
      "en": "Ich weiß das wirklich zu schätzen, Commander. Vielen Dank.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83473",
      "en": "Commander. Wie ist es gelaufen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83474",
      "en": "Wirklich? Das ist sehr beruhigend, Commander. Vielen Dank. ",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83475",
      "en": "Ich kann Sie nicht bezahlen, aber ich gebe Ihnen einen Rabatt auf alle Vorräte, die Sie hier kaufen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83476",
      "en": "Oh! Ich wusste nicht, dass es so ... wenigstens ist es vorbei.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83478",
      "en": "Offenbar arbeitet er für jemanden namens Banes. Kennen Sie den?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83479",
      "en": "Banes? Meint er Armistan Banes? Wir haben früher zusammen gearbeitet.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83480",
      "en": "Gut. Ich bin erleichtert, dass es vorbei ist.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83486",
      "en": "Wer war das auf dem Video? Was wollten die?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83493",
      "en": "Geben Sie mir den Namen des Kontaktmanns, ich kümmere mich um ihn, wer es auch sein mag.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83494",
      "en": "Ich werde dafür sorgen, dass sie's niemandem erzählen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83497",
      "en": "Keine Sorge. Ich kümmere mich darum.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83500",
      "en": "Er wird Sie nicht mehr belästigen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83504",
      "en": "Ich habe ihn getötet.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83508",
      "en": "Mal sehen, was uns der Captain erzählen kann.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83509",
      "en": "Ich habe keine Zeit für so was.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83517",
      "en": "Was ist los?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83529",
      "en": "Ich werde Ihnen helfen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83531",
      "en": "Ich werde vorsichtig sein.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83534",
      "en": "Gern geschehen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83536",
      "en": "Es ist vorbei.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83537",
      "en": "Wie erwartet.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83538",
      "en": "Er ist tot.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83545",
      "en": "Gute Idee.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83546",
      "en": "Bin nicht interessiert.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83564",
      "en": "Natürlich.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83574",
      "en": "Leben Sie wohl, Commander. War nett, Sie kennen zu lernen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83575",
      "en": "Zeigen Sie mir, was Sie zu verkaufen haben.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83584",
      "en": "Ich gehe dann jetzt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83586",
      "en": "Ich brauche Vorräte.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|83589",
      "en": "Auf Wiedersehen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|84067",
      "en": "Ich wünschte, ich könnte Ihnen mehr sagen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|84068",
      "en": "Kann ich Ihnen sonst noch irgendwie helfen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|85031",
      "en": "Viel Glück, Commander. Seien Sie vorsichtig.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|88514",
      "en": "Commander Shepard. Haben Sie den Erpresser gefunden? Konnten Sie mit Morlan auf dem Markt reden?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|88516",
      "en": "Natürlich. Ich wollte Sie nicht hetzen. Brauchen Sie sonst noch etwas?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|88518",
      "en": "Ich arbeite noch daran.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|88520",
      "en": "Noch nicht.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|90502",
      "en": "Ja, Commander. Kann ich irgendetwas für Sie tun?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|93853",
      "en": "Vielleicht kennt Captain Anderson diesen Mann.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|93854",
      "en": "Captain Anderson könnte ihn kennen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|95341",
      "en": "Haben Sie je von jemandem namens Banes gehört?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|95342",
      "en": "Er hat jemanden namens Banes erwähnt. Klingelt's da bei Ihnen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|95343",
      "en": "Er hat von jemandem namens Banes gesprochen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|95344",
      "en": "Ich glaube, er erwähnte jemanden namens Banes.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|95374",
      "en": "Wir sollten mit Captain Anderson reden.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|95375",
      "en": "Was ist mit Ihrem Captain?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|95376",
      "en": "Ob der Captain ihn wohl kennt?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|104592",
      "en": "Ich muss ihnen geben, was sie haben wollen. Wenn meine Vergangenheit bekannt wird, verliere ich meine Lizenz. Dann schließen sie meine Klinik.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|104596",
      "en": "Das Letzte, was ich hörte, war, dass das Allianz-Militär ihn wegen einer Forschung in der Traverse angestellt hatte.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|104602",
      "en": "Ich bin nur froh, dass Sie nicht verletzt wurden.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|104604",
      "en": "Was können Sie mir über ihn erzählen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|104605",
      "en": "Möglicherweise.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|104606",
      "en": "Wer ist er?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|104607",
      "en": "Ist einen Versuch wert.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|104608",
      "en": "Ist einen Versuch wert.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|104609",
      "en": "Ist einen Versuch wert.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|104610",
      "en": "Ist einen Versuch wert.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|104611",
      "en": "Ist einen Versuch wert.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|104615",
      "en": "Ich übernehme die Lieferung.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|104618",
      "en": "Gern geschehen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105030",
      "en": "Jemand aus meiner Vergangenheit. Ich kann das allein regeln.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105031",
      "en": "Verstehe. Vielleicht ist es besser, wenn ich nicht mehr weiß.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105032",
      "en": "Verstehe. Es ist mein Problem, und ich kann das allein regeln.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105033",
      "en": "Ich habe Ihnen nie gedankt, dass Sie mich aus Fists Klauen gerettet haben.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105034",
      "en": "Ich weiß nicht, was ohne Sie passiert wäre.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105035",
      "en": "Ich auch. Wollten Sie sonst noch etwas?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105036",
      "en": "Das ist ein guter Rat.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105037",
      "en": "Keine Sorge. Ich arbeite daran.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105038",
      "en": "Ich regle das auf meine Weise.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105039",
      "en": "Das ist sehr großzügig von Ihnen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105040",
      "en": "Jedes Mal, wenn ich herkomme, werden Sie bedroht. Wer war das?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105041",
      "en": "Ich kann Ihnen vielleicht helfen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105042",
      "en": "Vielleicht kann ich Ihnen helfen. Sagen Sie mir, was die wollen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105043",
      "en": "Sie werden Sie nicht mehr belästigen, das verspreche ich.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105045",
      "en": "Das müssen Sie schon allein regeln.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105047",
      "en": "Bleiben Sie bei der Medizin. Sie sind Leuten wie Fist nicht gewachsen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105048",
      "en": "Das werde ich.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105049",
      "en": "Geben Sie mir Zeit!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105050",
      "en": "Vielen Dank.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105051",
      "en": "Brauchen Sie Hilfe?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105052",
      "en": "Haben Sie wieder Ärger?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105053",
      "en": "Sprechen Sie weiter.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105054",
      "en": "Ich kann Ihnen helfen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105055",
      "en": "Keine Zeit dafür jetzt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105056",
      "en": "Das ist nicht mein Problem.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105057",
      "en": "Das ist nicht mein Problem.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105058",
      "en": "Vertrauen Sie mir.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105059",
      "en": "Nicht, wenn ich mit denen fertig bin.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|105062",
      "en": "Es war zu groß für Sie.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|113758",
      "en": "Ich wünschte, ich wüsste, wie das alles angefangen hat. Wie dieser Gauner von meiner ... Vergangenheit erfahren konnte.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|113759",
      "en": "Der Gauner sagte, er arbeitet für einen Mann namens Banes. Kennen Sie den?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|113762",
      "en": "Banes.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|124135",
      "en": "Ich brauche diese Vorräte für meine Klinik. Es geht nicht!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|124136",
      "en": "Commander. Ich bin gerade sehr beschäftigt ... wenn Sie mich bitte entschuldigen würden.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|124138",
      "en": "Hallo, Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|124139",
      "en": "Ich bin Dr. Chloe Michel. Kann ich irgendetwas für Sie tun?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|124140",
      "en": "Meine Eltern brachten mich her, als ich noch klein war.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|124141",
      "en": "Mein Vater war Arzt bei der Allianz.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|124142",
      "en": "Ich entschied mich, die Tradition als Mediziner aufrecht zu halten, ging aber nicht zum Militär. Verwundete Soldaten zu behandeln macht mir nämlich keinen großen Spaß.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|124145",
      "en": "Sagen Sie mir einfach, was los ist.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|124146",
      "en": "Ich will alle Details hören. Ich werde mich um diesen Kerl kümmern, der Sie bedroht.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|124149",
      "en": "Sie sind Ärztin? Wie sind Sie hier auf der Citadel gelandet?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|124153",
      "en": "Ich habe ihm Angst eingejagt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|124155",
      "en": "Schon in Ordnung.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|124156",
      "en": "Dann lassen Sie mal hören.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|124157",
      "en": "Hilfe bei der Bedrohung",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|124160",
      "en": "Persönliche Frage",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_doctor_michel_D|164082",
      "en": "Persönliche Frage",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105063",
      "en": "Ich hab's niemandem gesagt! Das schwöre ich!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105064",
      "en": "Das war klug, Doc.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105065",
      "en": "Ich konnte keine Beweise für meine Nachforschungen finden. Aber ich wusste, was wirklich vor sich geht. Saren verrät den Rat, und er entehrt mein Volk!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105066",
      "en": "Fist wird uns schon erwarten. Wenn wir zuschlagen, dann muss es ihn auch hart treffen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105067",
      "en": "Wir sind nicht die Einzigen, die hinter Fist her sind. Der Shadow Broker hat einen kroganischen Kopfgeldjäger namens Wrex auf ihn angesetzt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105068",
      "en": "Ja, wir haben ihn in der Bar gesehen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105069",
      "en": "Zuletzt soll er in der Citadel-Sicherheitsakademie gewesen sein.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105070",
      "en": "Was macht er da?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105071",
      "en": "Fist hat ihn beschuldigt, ihm gedroht zu haben, daher unterhielten wir uns mit Wrex. Wenn Sie sich beeilen, können Sie ihn noch in der Akademie erwischen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105072",
      "en": "Machen Sie keine Dummheiten, wenn Garrus kommt. Halten Sie den Mund, oder wir ...",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105073",
      "en": "Lassen Sie sie gehen!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105074",
      "en": "Stehen bleiben, Garrus! Eine falsche Bewegung, und ich ...",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105075",
      "en": "Wer sind Sie?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105076",
      "en": "Arg!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105077",
      "en": "Ahh!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105078",
      "en": "Perfektes Timing, Shepard. Ich hatte eine freie Schussbahn.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105079",
      "en": "Es musste schnell gehen! Ich habe nur reagiert. Ich wollte nicht ... Dr. Michel? Sind Sie verletzt?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105080",
      "en": "Manchmal hat man Glück.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105081",
      "en": "Dr. Michel? Sind Sie verletzt?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105082",
      "en": "Nein. Ich bin in Ordnung. Dank Ihnen. Ihnen allen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105083",
      "en": "Sie arbeiten für Fist. Sie wollen, dass ich den Mund halte und Garrus nichts von der Quarianerin erfährt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105084",
      "en": "Das könnte sein. Dr. Michel, erzählen Sie uns, was passiert ist.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105085",
      "en": "Vor einigen Tagen kam eine Quarianerin in mein Büro. Sie hatte eine Schusswunde, wollte aber nicht sagen, wer es war. Sie hatte große Angst und schien auf der Flucht zu sein.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105086",
      "en": "Sie fragte nach dem Shadow Broker. Für einen Unterschlupf wollte sie Informationen preisgeben.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105087",
      "en": "Ich habe den Kontakt zu Fist hergestellt. Er ist ein Agent des Shadow Brokers.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105088",
      "en": "Nicht mehr. Jetzt arbeitet er für Saren. Das gefällt dem Shadow Broker gar nicht.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105089",
      "en": "Fist hat den Shadow Broker betrogen? Das ist dumm, selbst für ihn. Saren muss ihm ein gutes Angebot gemacht haben.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105090",
      "en": "Die Quarianerin muss etwas haben, das Saren will. Etwas, wegen dem er sich mit dem Shadow Broker anlegen würde.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105091",
      "en": "Ich bin mir nicht sicher. Wie gesagt, für einen Unterschlupf wollte sie Informationen preisgeben. Sie hat ... Augenblick! Geth. Ihre Informationen hatten etwas mit den Geth zu tun!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105092",
      "en": "Das hat sie! Die Informationen, die sie anzubieten hatte, hatten etwas mit den Geth zu tun.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105093",
      "en": "Sie muss Saren mit den Geth in Verbindung bringen können. Das kann der Rat nicht ignorieren!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105094",
      "en": "Das ist Ihre Show, Shepard. Aber ich will Sarens Untergang ebenso wie Sie. Ich komme mit Ihnen!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105095",
      "en": "Turianer sind nicht alle gleich. Ich bin nicht wie Saren.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105103",
      "en": "Was haben Sie sich dabei gedacht? Sie hätten die Geisel treffen können!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105105",
      "en": "Sie haben ihn sauber getroffen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105107",
      "en": "Schön, dass ich helfen konnte.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105109",
      "en": "Ich weiß, dass diese Leute Sie bedroht haben. Aber wenn Sie uns sagen, für wen sie arbeiten, können wir Sie schützen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105110",
      "en": "Warum haben sie Sie bedroht? Für wen arbeiten sie?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105111",
      "en": "Hat das irgendetwas mit den Nachforschungen in Bezug auf Saren zu tun?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105113",
      "en": "Welche Quarianerin?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105115",
      "en": "Wo ist sie jetzt?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105116",
      "en": "Und dann?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105120",
      "en": "Was können Sie mir sonst noch über die Quarianerin sagen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105122",
      "en": "Sie muss einen Beweis dafür haben, dass er ein Verräter ist. Hat die Quarianerin etwas über Saren gesagt? Oder die Geth?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105124",
      "en": "Besuchen wir also Fist.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105125",
      "en": "Sie sind Turianer. Warum wollen Sie seinen Untergang?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105126",
      "en": "Ich brauche keinen Turianer, der mir in den Rücken schießt, wenn ich nicht damit rechne.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105128",
      "en": "Sie können mitkommen, aber ich behalte Sie im Auge!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105129",
      "en": "Willkommen an Bord, Garrus.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105132",
      "en": "Ein Kroganer könnte uns nützen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105135",
      "en": "Los geht's.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105136",
      "en": "Das kriegen wir selber hin. Gehen wir.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105144",
      "en": "Das war ein großes Risiko.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105145",
      "en": "Guter Schuss.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105146",
      "en": "Kein Problem.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105150",
      "en": "Wir können Sie beschützen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105151",
      "en": "Erzählen Sie mir, was passiert ist.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105152",
      "en": "Wer waren diese Männer?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105153",
      "en": "Was ist mit Saren?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105154",
      "en": "Quarianerin?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105157",
      "en": "Wo ist sie hingegangen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105158",
      "en": "Reden Sie weiter.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105162",
      "en": "Sonst noch was?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105163",
      "en": "Beweise.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105166",
      "en": "Wir müssen sie finden!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105167",
      "en": "Wir haben noch gar nichts.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105168",
      "en": "Aber Fist hat sie!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105169",
      "en": "Warum hassen Sie Saren?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105170",
      "en": "Vergessen Sie's.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105171",
      "en": "Okay.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105173",
      "en": "Sie haben's klar ausgedrückt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105174",
      "en": "Ich vertraue Ihnen nicht.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105177",
      "en": "Er könnte uns nützen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105178",
      "en": "Wir brauchen ihn nicht.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105181",
      "en": "Gehen wir.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105230",
      "en": "Sie arbeiten für Fist. Sie wollen, dass ich den Mund halte und Garrus nichts von der Quarianerin erfährt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105231",
      "en": "Der, von denen ich Ihnen erzählt habe, Shepard.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105232",
      "en": "Wie Wrex es gesagt hat, Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|105233",
      "en": "Wie Wrex es gesagt hat, Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|111641",
      "en": "Ja, wir haben von ihm gehört.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|163999",
      "en": "Lassen Sie sie gehen!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_08A_DSG_LOC|sta60_garrus_doctor_D|164000",
      "en": "Lassen Sie sie gehen.",
      "tr": ""
    }
  ]
}