{
  "meta": {
    "package": "BIOA_LAV70_08_DSG_LOC_DE.pcc",
    "stem": "BIOA_LAV70_08_DSG_LOC",
    "textLang": "DE",
    "sets": 1
  },
  "entries": [
    {
      "key": "BIOA_LAV70_08_DSG_LOC|lav70_trig03_krogan_boss_D|13959",
      "en": "Geben Sie auf. Oder auch nicht. Das wäre amüsanter.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_08_DSG_LOC|lav70_trig03_krogan_boss_D|13960",
      "en": "Der gleiche Grund, warum Sie hier sind: Die Asari.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_08_DSG_LOC|lav70_trig03_krogan_boss_D|13961",
      "en": "Was auch immer Sie wollen, von mir bekommen Sie es nicht.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_08_DSG_LOC|lav70_trig03_krogan_boss_D|13963",
      "en": "Verschont wenn möglich die Asari. Wenn nicht ... ist es auch egal.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_08_DSG_LOC|lav70_trig03_krogan_boss_D|13964",
      "en": "Das war keine Bitte. Saren will sie, und er bekommt immer, was er will.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_08_DSG_LOC|lav70_trig03_krogan_boss_D|13965",
      "en": "Genau die richtige Atmosphäre für einen Kampf um Leben und Tod!",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_08_DSG_LOC|lav70_trig03_krogan_boss_D|13967",
      "en": "Berauschend, nicht wahr?",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_08_DSG_LOC|lav70_trig03_krogan_boss_D|13968",
      "en": "Ihre Einstellung gefällt mir.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_08_DSG_LOC|lav70_trig03_krogan_boss_D|13969",
      "en": "Gibt es einen Grund, warum Sie mir im Weg stehen?",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_08_DSG_LOC|lav70_trig03_krogan_boss_D|13973",
      "en": "Vielen Dank, aber sie bleibt bei uns.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_08_DSG_LOC|lav70_trig03_krogan_boss_D|13975",
      "en": "Ist das wirklich der richtige Zeitpunkt?",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_08_DSG_LOC|lav70_trig03_krogan_boss_D|13978",
      "en": "Falls es Ihnen nicht aufgefallen ist, hier bricht alles zusammen.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_08_DSG_LOC|lav70_trig03_krogan_boss_D|13979",
      "en": "Wir haben keine Zeit, uns mit diesem Idioten abzugeben. Angriff!",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_08_DSG_LOC|lav70_trig03_krogan_boss_D|16429",
      "en": "Nein! Nein! Ich werde nicht mit ihnen gehen.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_08_DSG_LOC|lav70_trig03_krogan_boss_D|45139",
      "en": "Was ist denn los?",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_08_DSG_LOC|lav70_trig03_krogan_boss_D|45140",
      "en": "Diese Ruine stürzt ein.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_08_DSG_LOC|lav70_trig03_krogan_boss_D|45141",
      "en": "Töten Sie diesen Bastard.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_08_DSG_LOC|lav70_trig03_krogan_boss_D|45144",
      "en": "Ich gebe sie nicht heraus.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_08_DSG_LOC|lav70_trig03_krogan_boss_D|45145",
      "en": "Sie wollen jetzt kämpfen?",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_08_DSG_LOC|lav70_trig03_krogan_boss_D|64153",
      "en": "Danke, dass Sie das Energiefeld für uns deaktiviert haben. Geben Sie jetzt den Doktor raus.",
      "tr": ""
    }
  ]
}