{
  "meta": {
    "package": "BIOA_FRE34_00_DSG_LOC_DE.pcc",
    "stem": "BIOA_FRE34_00_DSG_LOC",
    "textLang": "DE",
    "sets": 2
  },
  "entries": [
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129783",
      "en": "Danke. Danke, dass Sie mich vor diesen Dingern gerettet haben.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129784",
      "en": "Commander. Das ist er. Das ist Dr. Saleon.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129785",
      "en": "Was? Mein Name ist Heart. Dr. Heart. Bitte holen Sie mich hier raus.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129786",
      "en": "Positiv.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129787",
      "en": "Dieses Mal gibt es kein Entkommen, Doktor. Ich würde mir ja erst Ihre Organe nehmen, aber wir haben leider keine Zeit dafür.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129788",
      "en": "Sie sind verrückt! Er ist verrückt. Bitte lassen Sie nicht zu, dass er mir das antut.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129789",
      "en": "Aber gern.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129790",
      "en": "Ihre Tage als Schlachter sind vorüber, Doktor.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129791",
      "en": "Nein. Bitte ... Bitte!",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129792",
      "en": "Aber ... wir haben ihn. Wir dürfen ihn nicht entkommen lassen. Nicht schon wieder.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129793",
      "en": "Ich ... okay. Das stimmt.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129794",
      "en": "Sie sind ein sehr glücklicher Salarianer. Sie haben dem Commander Ihr Leben zu verdanken.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129795",
      "en": "Oh. Vielen Dank!",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129796",
      "en": "Sie sind doch alle verrückt!",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129797",
      "en": "Und so muss er trotz allem sterben. Was machte das alles für einen Sinn?",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129798",
      "en": "Ja. Jemanden wie Sie habe ich noch nie getroffen, Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129801",
      "en": "Sind Sie sicher, dass er es ist?",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129804",
      "en": "Erlösen Sie ihn von seinem Leid, damit wir weiter können.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129808",
      "en": "Wir nehmen ihn mit und übergeben ihn dem Militär.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129809",
      "en": "Wenn er stirbt, werden wir nie erfahren, was er vorhatte und wie er das gemacht hat. Wir nehmen ihn mit, verhören ihn ... und dann sitzt er seine Zeit ab.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129812",
      "en": "Der gehört mir, Garrus.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129813",
      "en": "Sie können nicht vorhersagen, was die Leute tun, Garrus. Aber Sie können kontrollieren, wie Sie reagieren. Und das ist letzten Endes alles, was zählt.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129816",
      "en": "Sind Sie sicher?",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129817",
      "en": "Garrus?",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129820",
      "en": "Machen Sie ihn fertig.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129821",
      "en": "Zurück mit Ihnen, Garrus.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129822",
      "en": "Zeit zu sterben, Doktor!",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129826",
      "en": "In Ordnung",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129827",
      "en": "Ich tue es!",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129828",
      "en": "Denken Sie nach, Garrus!",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129831",
      "en": "Ich werde es Ihnen sagen.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|129832",
      "en": "Es tut mir leid, Garrus.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|130453",
      "en": "Tja ... ich schätze, wir sind hier fertig.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|146411",
      "en": "Offenbar hat Saleon noch mehr gemacht als Organe zu klonen.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|146413",
      "en": "Das war ... befriedigend.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|146414",
      "en": "Was war das gerade, Shepard?",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|146416",
      "en": "Gut. Vergessen Sie dieses Gefühl nicht. Genau so sollte es sein.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|146417",
      "en": "Sie dürfen niemals zögern, wenn Sie den Feind sehen, Garrus.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|146419",
      "en": "Wir sind hier fertig.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|146420",
      "en": "Raus.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|146421",
      "en": "Eine Lektion.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|146422",
      "en": "Was denken Sie?",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|146423",
      "en": "Das werde ich nicht, Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_d|146424",
      "en": "Verstehe.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146510",
      "en": "Offenbar hat Saleon noch mehr gemacht als Organe zu klonen.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146511",
      "en": "Offenbar hat der gute Doktor noch mehr gemacht als Organe zu klonen.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146512",
      "en": "Dieser Doktor steckt in ernsthaften Schwierigkeiten.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146513",
      "en": "In was ist der Doktor da nur verwickelt?",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146514",
      "en": "Was machen Sie denn hier? Das ist mein Schiff.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146515",
      "en": "Ich habe hier zu arbeiten, und das geht Sie nichts an. Ich schütze nur meine Interessen.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146516",
      "en": "Wir wissen, was Sie hier machen, Doktor.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146517",
      "en": "Wir wissen, was Sie hier machen, Doktor.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146518",
      "en": "Wir wissen, was Sie hier machen, Doktor.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146519",
      "en": "Wir wissen, was Sie hier machen, Doktor.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146520",
      "en": "In diesem Fall wissen Sie auch, dass ich ein Narr wäre, wenn ich Sie mit diesem Wissen wieder gehen lassen würde.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146522",
      "en": "Garrus wird nicht erfreut sein, dass wir diesen Kerl töten, wenn er nicht dabei ist.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146523",
      "en": "Garrus wird nicht erfreut sein, dass wir diesen Kerl töten, wenn er nicht dabei ist.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146524",
      "en": "Garrus wird sauer sein, wenn er hört, dass wir das ohne ihn erledigt haben.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146525",
      "en": "Garrus wird wütend sein, dass er sich nicht selbst um den Doktor kümmern konnte.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146526",
      "en": "Wer zu schwach zum Jagen ist, hat die Beute auch nicht verdient.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146529",
      "en": "Ich habe eben Ihr Leben gerettet. Zeigen Sie etwas mehr Respekt!",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146530",
      "en": "Ich hätte Sie auch einfach Ihrem Schicksal überlassen können.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146538",
      "en": "Dann mal los, Leute.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146539",
      "en": "Garrus ist ein großer Junge. Er wird drüber hinwegkommen.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146540",
      "en": "Ich denke, er wird es verstehen.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146542",
      "en": "Sie hatten Glück!",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146543",
      "en": "Freundschaftlich...",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146544",
      "en": "Ich freue mich auch, Sie kennenzulernen.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146552",
      "en": "Genau.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146553",
      "en": "Es ist nichts Persönliches.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146554",
      "en": "Genug geredet.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146555",
      "en": "Zu schade für ihn.",
      "tr": ""
    },
    {
      "key": "BIOA_FRE34_00_DSG_LOC|cha00_trig_garrus_left_behind_d|146556",
      "en": "Es ist nichts Persönliches.",
      "tr": ""
    }
  ]
}