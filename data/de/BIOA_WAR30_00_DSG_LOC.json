  "entries": [
    {
      "key": "BIOA_WAR30_00_DSG_LOC|war30_banter_00_D|160190",
      "en": "Gott, was stinkt das hier. Mir wird gleich schlecht.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR30_00_DSG_LOC|war30_banter_00_D|160191",
      "en": "So langsam wird's hier unheimlich.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR30_00_DSG_LOC|war30_banter_00_D|160193",
      "en": "Wenn es schleimig ist und sich bewegt, erschießen Sie's.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR30_00_DSG_LOC|war30_banter_00_D|160194",
      "en": "Riecht wie Kompost. Verrotteter Kompost.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR30_00_DSG_LOC|war30_banter_00_D|160196",
      "en": "Davon werde ich noch Alpträume bekommen.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR30_00_DSG_LOC|war30_banter_00_D|160197",
      "en": "Ich möchte mir gar nicht vorstellen, wie schrecklich es sein muss, von diesem ... Ding versklavt zu werden.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR30_00_DSG_LOC|war30_banter_00_D|160199",
      "en": "Das Ding ist ja riesig!",
      "tr": ""
    },
    {
      "key": "BIOA_WAR30_00_DSG_LOC|war30_banter_00_D|160200",
      "en": "Die Galaxis wird besser dran sein, wenn das Ding tot ist.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR30_00_DSG_LOC|war30_banter_00_D|160202",
      "en": "Wir müssen das Ding töten. Und zwar schnell.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR30_00_DSG_LOC|war30_banter_00_D|160203",
      "en": "Und es heißt, ich wäre hässlich.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR30_00_DSG_LOC|war30_banter_00_D|160205",
      "en": "Auf all unseren Wanderungen ist mein Volk noch nie einer Kreatur wie dieser begegnet.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR30_00_DSG_LOC|war30_banter_00_D|160206",
      "en": "Ist das eine Pflanze oder ein Tier? Oder irgendwas dazwischen?",
      "tr": ""
    }
  ]
}