{
  "meta": {
    "package": "BIOA_STA30_03A_DSG_LOC_DE.pcc",
    "stem": "BIOA_STA30_03A_DSG_LOC",
    "textLang": "DE",
    "sets": 2
  },
  "entries": [
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta00_popup_text_D|145642",
      "en": "Sie müssen mit dem Rat reden, um Zugang zu den Bezirken zu erhalten.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta00_popup_text_D|148499",
      "en": "Der Keeper-Scan wurde in die Datenbank übertragen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta00_popup_text_D|148500",
      "en": "Sie verfügen nicht über die korrekte Schlüsselkarte.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta00_popup_text_D|163019",
      "en": "Warnen Sie die Quarianerin, bevor es zu spät ist!",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88910",
      "en": "Hallo, Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88911",
      "en": "Sekunde. Ich hab' Sie gleich.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88912",
      "en": "Commander Shepard... mit dem Allianz-Militär hier. Das erste Mal auf der Citadel. Stimmt das in etwa?",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88913",
      "en": "Ich bin der Citadel-Sicherheits-Requisitionsoffizier. Ich muss sichergehen, dass unsere Käufer authorisiert sind.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88914",
      "en": "Ich schaue nur nach Citadel-Sicherheits Einträgen. Ich darf Waren nur an authorisierte Mitarbeiter verkaufen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88916",
      "en": "Ich zeige Ihnen die guten Sachen, Commander. Viel Spaß damit.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88917",
      "en": "Hört sich gut an. Bin gleich soweit. Oh! Da muss ein Fehler vorliegen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88918",
      "en": "Das System sagt mir, ich soll Ihnen unsere ausgesuchte Ware anbieten... Spectre?",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88920",
      "en": "Ich habe davon gehört, aber ich wusste nicht, dass Sie das sind. Tut mir leid, Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88921",
      "en": "Super. Ich hoffe, Sie finden, wonach Sie suchen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88922",
      "en": "Alles klar, Commander. Schönen Tag noch.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88924",
      "en": "Woher wissen Sie, wer ich bin?",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88925",
      "en": "Woher wissen Sie das alles?",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88926",
      "en": "Wer will das wissen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88928",
      "en": "Zeigen Sie mir, was Sie haben.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88932",
      "en": "Zeigen Sie mir einfach, was Sie haben.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88933",
      "en": "Ich muss jetzt los.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88935",
      "en": "Auf Wiedersehen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88937",
      "en": "Sie kennen mich?",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88938",
      "en": "Ganz genau.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88939",
      "en": "Warum?",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88941",
      "en": "Ich brauche Vorräte.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88942",
      "en": "Auf Wiedersehen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88946",
      "en": "Ich bin fertig.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88947",
      "en": "Kein Problem.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|88948",
      "en": "Wenn Sie meinen ...",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|89111",
      "en": "Also, darf es heute etwas für Sie sein, Commander Shepard?",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|171836",
      "en": "Vielleicht",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_03A_DSG_LOC|sta30_requisition_officer_D|171837",
      "en": "Warum?",
      "tr": ""
    }
  ]
}