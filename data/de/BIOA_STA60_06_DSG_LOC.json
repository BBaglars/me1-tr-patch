    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|cha00_banter_ques_D|159741",
      "en": "Hm.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_banter_02_D|159910",
      "en": "Ich frage mich, wohin all die Tänzer sind.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_banter_02_D|159911",
      "en": "Ich verstehe, warum dieser Schuppen so beliebt ist. Es gibt hier tolle ... äh, Aussichten.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_banter_02_D|159912",
      "en": "Hey, Lieutenant, fahren Sie die Zunge wieder ein, bevor Sie noch drauftreten.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_banter_02_D|159914",
      "en": "Riechen Sie das? Frisches Blut gemischt mit schalem Alkohol.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_banter_02_D|159915",
      "en": "Eine Million Lichtjahre von dem Ort entfernt, an dem die Menschheit begann, und wir gehen in eine Bar voller Männer, die sabbernd nackte Weiber dabei beobachten, wie sie auf der Bühne mit dem Arsch wackeln. Ich kann mich nicht entscheiden, ob das lustig oder traurig ist.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_banter_02_D|159916",
      "en": "Was? Sie glauben nicht, dass sie wegen des Essens hier sind?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_banter_02_D|159918",
      "en": "Wir Asari sind mit unserer Sexualität mehr im Einklang als die meisten anderen Spezies. Eine Clubbesitzer nutzen das gern aus und heuern uns als Tänzerinnen an.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_banter_02_D|159920",
      "en": "Der Sicherheitsdienst sieht geflissentlich darüber hinweg, was hier los ist. Ich glaube, Fist hat jemanden ausbezahlt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_banter_02_D|159922",
      "en": "Für Fist lief's gut hier drinnen. Zu schade, dass er gierig wurde.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_banter_02_D|159924",
      "en": "Tänzerinnen genießen bei meinem Volk höchsten Respekt. Aber ich habe das Gefühl, dass diese Frauen nicht besonders angesehen sind.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|74533",
      "en": "Warten Sie! Töten Sie mich nicht! Ich gebe auf!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|74589",
      "en": "Die Quarianerin ist nicht hier. Sie sagte, sie redet nur mit dem Shadow Broker persönlich.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|74591",
      "en": "Hier in den Bezirken. In der dunklen Gasse am Markt. Sie müsste sich jetzt mit ihnen dort treffen. Sie sollten sich beeilen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|74593",
      "en": "Hey! Ich habe ausgepackt! Ich habe Ihnen von dem Treffen erzählt! Außerdem habe ich jetzt andere Probleme.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|74594",
      "en": "Der Shadow Broker will meinen Tod! Ich muss verschwinden. Vergessen Sie mich - ich bin ein Geist.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|74596",
      "en": "Keine Sorge. Mich sehen Sie nie wieder.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|74609",
      "en": "Wo ist die Quarianerin?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|74610",
      "en": "Sagen Sie mir, wo die Quarianerin ist, oder ich schieße Ihnen die Knie weg.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|74617",
      "en": "Nennen Sie den Ort. Sofort.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|74619",
      "en": "Soll ich Ihren Anteil daran vergessen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|74621",
      "en": "Hier sind zu viele Leute gestorben, Fist. Sie können nicht abhauen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|74623",
      "en": "Das geht mich nichts an.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|74624",
      "en": "Wir haben keine Zeit zu verlieren. Na los!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|74705",
      "en": "Ich brauche Informationen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|74706",
      "en": "Reden Sie.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|74713",
      "en": "Wir müssen sie retten!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|74714",
      "en": "Wo findet das Treffen statt?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|74716",
      "en": "Was ist mit Ihnen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|74717",
      "en": "Gehen wir.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|74719",
      "en": "Sie verdienen's Leben nicht.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|74720",
      "en": "Okay. Verschwinden Sie.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|86058",
      "en": "Sie ist nicht hier. Ich weiß nicht, wo sie ist. Das ist die Wahrheit!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|86059",
      "en": "Er nutzt Ihnen jetzt nichts mehr. Lassen Sie mich ihn töten!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|86060",
      "en": "Er lügt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|86061",
      "en": "Er lügt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|86062",
      "en": "Warten Sie! Warten Sie! Ich weiß nicht, wo die Quarianerin ist, aber ich weiß, wie Sie sie finden können.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|86063",
      "en": "Den Shadow Broker kann man nicht treffen. Niemals. Selbst ich kenne seine wahre Identität nicht. Aber das wusste sie nicht. Ich sagte ihr, ich arrangiere ein Treffen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|86064",
      "en": "Aber wenn sie auftaucht, werden Sarens Männer auf sie warten.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|86083",
      "en": "Schießen Sie ihm ins Knie. Vielleicht redet er dann.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|86085",
      "en": "Schießen Sie los, bevor ich die Geduld verliere.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|86086",
      "en": "Sie haben drei Sekunden, dann schieße ich.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|86091",
      "en": "Sagen Sie mir, wo das Treffen stattfindet, bevor ich Ihnen den Schädel wegblase!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|86101",
      "en": "Erschießen Sie ihn.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|86102",
      "en": "Was ist passiert?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|86103",
      "en": "Mich lügt niemand an, Fist!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|86109",
      "en": "Sie Mistkerl!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|105182",
      "en": "Von Angesicht zu Angesicht? Unmöglich! Selbst ich wurde von einem Agenten angeworben.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|105183",
      "en": "Unmöglich. Der Shadow Broker arbeitet nur über Agenten.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|105184",
      "en": "Ich dachte, der Shadow Broker arbeitet nur über Agenten.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|105185",
      "en": "Hier in den Bezirken. In der dunklen Gasse am Markt. Sie müsste sich jetzt mit ihnen dort treffen. Sie sollten sich beeilen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|105187",
      "en": "Waffe fallenlassen, Kroganer!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|105188",
      "en": "Was machen Sie?!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|105189",
      "en": "Grundgütiger!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|105190",
      "en": "Ich soll ihn für den Shadow Broker töten. Und ich erledige meine Jobs.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|105191",
      "en": "Er war der Einzige, den ich noch hatte. Gibt es keine dringenderen Angelegenheiten, um die wir uns kümmern müssen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|105192",
      "en": "Wie viele sind wegen ihm gestorben? Er hat es sich selbst zuzuschreiben. Außerdem haben wir was Dringenderes zu erledigen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|105193",
      "en": "Die Quarianerin stirbt, wenn wir jetzt nicht gehen!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|105194",
      "en": "Die Quarianerin stirbt, wenn wir jetzt nicht gehen!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|105195",
      "en": "Die Quarianerin stirbt, wenn wir jetzt nicht gehen!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|105206",
      "en": "Ich habe hier das Sagen! Wenn Sie so was noch mal machen ...",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|105208",
      "en": "Wir erschießen keine unbewaffneten Gefangenen!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|105210",
      "en": "Wegen ihm mussten viele sterben. Er hat es heraufbeschworen. Und jetzt weiter. Wir müssen die Quarianerin retten!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|105211",
      "en": "Ich will Sie nie wiedersehen! Ist das klar?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|105212",
      "en": "Kluge Entscheidung.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|105223",
      "en": "Tun Sie das nie wieder!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|105224",
      "en": "Er hatte sich ergeben!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|105225",
      "en": "Er hatte es verdient.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|105228",
      "en": "Verschwinden Sie von hier, Fist.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_06_DSG_LOC|sta60_fist_D|106465",
      "en": "Warum muss ich immer alles selber machen? Zeit zu sterben, kleine Soldaten!",
      "tr": ""
    }
  ]
}