    },
    {
      "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_00_D|159673",
      "en": "Riecht nach Rauch und Tod.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_00_D|159674",
      "en": "Eden Prime wird nie wieder wie früher sein.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_00_D|159675",
      "en": "Ziele überprüfen! Es könnten unsere Leute sein.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_00_D|159676",
      "en": "Wir sollten weiter, Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_00_D|159678",
      "en": "Wir hielten diese Welt für sicher ... bis die Geth auftauchten.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_00_D|159679",
      "en": "Früher war es wunderschön hier.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_00_D|159680",
      "en": "Jemand wird dafür büßen.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_00_D|159681",
      "en": "Holen wir uns die Schweinehunde.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_00_D|159682",
      "en": "Wir sollten weiter.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_00_D|159684",
      "en": "Oh Gott. Was war hier los?",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_01_D|159767",
      "en": "Der Mann war noch am Leben, als sie ihn aufspießten.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_01_D|159768",
      "en": "Uns zu töten reicht nicht. Die Geth wollen, dass wir leiden.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_01_D|159770",
      "en": "Opfer aufzuspießen, statt sie zu erschießen ... dafür muss es einen Grund geben.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_01_D|159771",
      "en": "Klassische psychologische Kriegsführung. Sie setzen Terror als Waffe ein.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_02_D|159782",
      "en": "Jetzt wissen wir, wofür die Spitzen sind: Sie nutzen unsere eigenen Toten gegen uns.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_00_DSG_LOC|pro10_banter_02_D|159784",
      "en": "Diese Spitzen müssen Stunden brauchen, um aus Menschen Hülsen zu machen.",
      "tr": ""
    }
  ]
