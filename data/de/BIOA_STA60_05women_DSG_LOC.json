  "entries": [
    {
      "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|77274",
      "en": "Hey, ich bin sofort bei Ihnen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80508",
      "en": "Ich weiß nicht, was Sie meinen. Wenn Sie nichts dagegen haben, kümmere ich mich jetzt um meine Kunden.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80511",
      "en": "Das werde ich, danke.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80512",
      "en": "Jetzt klingen Sie wie meine Schwester. Warum machen sich alle Sorgen um mich? Ich kann auf mich aufpassen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80513",
      "en": "Ich muss gehen. Ich bin keine Stripperin und werde nicht dafür bezahlt, rumzustehen und gut auszusehen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80514",
      "en": "Warum habe ich das Gefühl, dass Sie nicht hier sind, um zu trinken?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80515",
      "en": "Ich hab zu tun. Die anderen Kellnerinnen können Ihnen helfen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80516",
      "en": "Nicht jetzt. Ich hab zu tun.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80517",
      "en": "Ich habe Ihnen nichts zu sagen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80518",
      "en": "Ich muss mit Ihnen über Ihre Arbeit für die Citadel-Sicherheit reden.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80521",
      "en": "Wie Sie wollen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80522",
      "en": "Das ist kein Spiel, Jenna. Diese Leute sind gefährlich.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80524",
      "en": "Ich werde hier warten.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80525",
      "en": "Es geht ganz schnell.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80526",
      "en": "Beeilen Sie sich.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80527",
      "en": "Okay.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80530",
      "en": "Sicher. Vergessen Sie's.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80531",
      "en": "Seien Sie nicht dumm.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|80534",
      "en": "Tut mir Leid.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|88505",
      "en": "Hallo. Willkommen im Flux.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05women_DSG_LOC|sta60_jenna_D|88506",
      "en": "Hey, ich bin gleich bei Ihnen.",
