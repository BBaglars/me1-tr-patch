  },
  "entries": [
    {
      "key": "BIOA_WAR20_01_DSG_LOC|war20_badraltalaqani_D|102274",
      "en": "Wir haben Ihr Schiff gesehen. Fai Dan möchte sofort mit Ihnen sprechen.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_01_DSG_LOC|war20_badraltalaqani_D|102278",
      "en": "Aber die Geth werden nicht warten. Sie bereiten einen weiteren Angriff vor.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_01_DSG_LOC|war20_badraltalaqani_D|102285",
      "en": "Bitte. Gehen Sie nach oben. Hinter den Frachter.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_01_DSG_LOC|war20_badraltalaqani_D|102286",
      "en": "Was ist so wichtig, dass er mich gleich sehen will?",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_01_DSG_LOC|war20_badraltalaqani_D|102288",
      "en": "Wer ist Fai Dan?",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_01_DSG_LOC|war20_badraltalaqani_D|102290",
      "en": "Ich muss mich um wichtigere Dinge kümmern.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_01_DSG_LOC|war20_badraltalaqani_D|102301",
      "en": "Warum?",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_01_DSG_LOC|war20_badraltalaqani_D|102302",
      "en": "Wer?",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_01_DSG_LOC|war20_badraltalaqani_D|102303",
      "en": "Er kann warten.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_01_DSG_LOC|war20_badraltalaqani_D|113225",
      "en": "Er ist unser Sprecher. Er braucht Ihre Hilfe bei den Verteidigungsvorbereitungen gegen die Geth. Sie machen einen weiteren Vorstoß.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_01_DSG_LOC|war20_badraltalaqani_D|113228",
      "en": "Die Geth starten einen weiteren Vorstoß. Fai Dan bereitet unsere Verteidigung vor. Aber er braucht Ihre Hilfe.",
      "tr": ""
    }
  ]
}