{
  "meta": {
    "package": "BIOA_UNC61_02_DSG_LOC_DE.pcc",
    "stem": "BIOA_UNC61_02_DSG_LOC",
    "textLang": "DE",
    "sets": 1
  },
  "entries": [
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130458",
      "en": "Das ist sie.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130459",
      "en": "Meine Panzerung. Genau das habe ich gesucht.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130460",
      "en": "Ich kann nicht glauben, dass meine Ahnen diesen Mist je getragen haben, aber zumindest habe ich sie wieder.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130461",
      "en": "Das ist der Wichser. Machen wir ihn fertig.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130463",
      "en": "Dies ist der Ort. Meine Panzerung muss hier irgendwo sein.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130464",
      "en": "Ich weiß, wer hier das Sagen hat.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130465",
      "en": "Nein, aber ich hatte schon bevor wir uns trafen vor, hier herzukommen.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130466",
      "en": "Dieser Ort gehört einem turianischen Wichser namens Tonn Actus.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130467",
      "en": "Es ist eine lange Geschichte, aber er hat etwas, das mir gehört.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130468",
      "en": "Bin direkt hinter Ihnen.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130469",
      "en": "Eine Familienpanzerung, die uns seit mehr als fünf Generationen gehört.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130470",
      "en": "Das turianische Militär hat sie meinem Großvater nach dem Krieg weggenommen.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130471",
      "en": "Und irgendwie ist sie bei diesem Arschloch gelandet. Ich will sie zurück.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130476",
      "en": "Sind Sie schon mal hier gewesen?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130479",
      "en": "Dafür haben wir keine Zeit. Ausrücken.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130480",
      "en": "Und, was ist es?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130483",
      "en": "Wir werden sie zurückholen. Und jetzt weiter.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130488",
      "en": "Woher wissen Sie das?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130489",
      "en": "Was? ",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130492",
      "en": "Raus.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130493",
      "en": "Er hat Ihnen etwas weggenommen?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130496",
      "en": "Keine Sorge.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|130497",
      "en": "Ich bin bei Ihnen.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|146355",
      "en": "Ich fange ja fast an, Sie zu mögen, Shepard.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|146356",
      "en": "Dann sind wir hier wohl fertig.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|146357",
      "en": "Ich bin froh, dass wir Ihnen helfen konnten, sie zurückzubekommen.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|146358",
      "en": "Aha. Gehen wir, Leute.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|146359",
      "en": "Gut.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|146360",
      "en": "Das ist ja großartig.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC61_02_DSG_LOC|cha00_trig_wrex_d|146361",
      "en": "Wie Sie meinen.",
      "tr": ""
    }
  ]
}