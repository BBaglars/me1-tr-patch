{
  "meta": {
    "package": "BIOA_STA60_07toss_DSG_LOC_DE.pcc",
    "stem": "BIOA_STA60_07toss_DSG_LOC",
    "textLang": "DE",
    "sets": 1
  },
  "entries": [
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|77276",
      "en": "Ja, was gibt's?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81636",
      "en": "Doran hatte keine Ahnung, was ich gemacht habe. Er nahm an, dass ich betrügen würde.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81637",
      "en": "Entweder Sie betrügen oder nicht.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81638",
      "en": "Ich habe meinem Glück nur nachgeholfen. Es war nur ein Experiment.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81640",
      "en": "Für Sie vielleicht. Aber dieses Gerät soll nur Situationen simulieren und Resultate aufzeichnen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81642",
      "en": "Das Aufzeichnen von Verlusten ist einfach. Die bemerkt niemand.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81654",
      "en": "Hm.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81655",
      "en": "Wurden Sie rausgeworfen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81656",
      "en": "Dem Besitzer gefiel Ihre Spielweise wohl nicht.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81659",
      "en": "Das klingt für mich nach Betrügen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81676",
      "en": "Auf Wiedersehen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81677",
      "en": "Was ist passiert?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81678",
      "en": "Sie haben betrogen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81679",
      "en": "Nichts.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81682",
      "en": "Erklären Sie das.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81966",
      "en": "Ich kümmere mich darum.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81967",
      "en": "Bitte sehr. Hoffentlich ist es das, was Sie haben wollten.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81968",
      "en": "Eigentlich habe ich Ihr Gerät Doran gegeben.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81969",
      "en": "Noch nicht.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81970",
      "en": "Ja.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81971",
      "en": "Ich hab's weggegeben.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81972",
      "en": "Natürlich.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81973",
      "en": "Bald.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|81974",
      "en": "Es ist weg.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|85042",
      "en": "Haben Sie Ihre Meinung geändert? Wollen Sie mir helfen, die Siege aufzuzeichnen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|85043",
      "en": "Sie schon wieder. Was wollen Sie jetzt schon wieder?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|88882",
      "en": "Hey. Das System ist ein großer Erfolg.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|88883",
      "en": "Vielen Dank dafür.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|88885",
      "en": "[seufz] Was soll ich denn jetzt machen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|88886",
      "en": "Ich bin ruiniert. Ruiniert!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|88887",
      "en": "Wirklich großartig! Das wird mir unschätzbare Daten liefern.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|88888",
      "en": "Genießen Sie Ihren Gewinn. Ich werde dieses System vervollständigen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|88889",
      "en": "Aber da steckte jahrelange Arbeit drin. Was soll ich denn jetzt machen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|88890",
      "en": "Vielleicht könnten Sie Ihre Talente besser nutzen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|88891",
      "en": "Sie sind mir aber keine Hilfe.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|88892",
      "en": "Das ist der absolut schlimmste Tag meines Lebens.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|88897",
      "en": "Doran hat mich erwischt und es mir weggenommen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|88904",
      "en": "Ich hab es verloren.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|88905",
      "en": "Doran hat es rausgefunden.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|89539",
      "en": "Warten Sie nicht zu lange.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|90368",
      "en": "Haben Sie schon fünf Siege mit dem Gerät aufgezeichnet?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|101090",
      "en": "Aber Sie haben betrogen, nicht wahr?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|101091",
      "en": "Ich kenne Doran. Wenn er sagt, dass Sie betrügen, dann betrügen Sie.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|101092",
      "en": "Aber Sie haben betrogen, nicht wahr?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|101093",
      "en": "Und hier sind Sie, der Betrüger.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104508",
      "en": "Ah, jetzt kommen wir zum Kern der Sache.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104509",
      "en": "In den letzten fünf Jahren habe ich ein Gerät entwickelt, das sehr präzise Gewinne und Verluste beim Quasar berechnen kann.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104510",
      "en": "Ich muss nur noch einige Siege aufzeichnen, um den Algorithmus zu vervollständigen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104511",
      "en": "Es ist illegal mein System zu benutzen. Aber ich benutze es nicht, ich werde es verkaufen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104512",
      "en": "Hmm. Sie könnten es ja mal versuchen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104513",
      "en": "Ich muss nur noch einige Siege aufzeichnen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104514",
      "en": "Aber Sie haben gesehen, was passiert, wenn Sie mit dem Gerät erwischt werden.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104515",
      "en": "Bitte sehr. Sie werden es merken, wenn Sie genug Siege aufgezeichnet haben.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104516",
      "en": "Dann legen Sie los. Die Daten sammeln sich nicht selbst.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104517",
      "en": "Hmpf. Wie Sie wollen. Ich muss noch einige Berechnungen machen. Auf Wiedersehen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104518",
      "en": "Behalten Sie den Gewinn. Das sollte Bezahlung genug sein.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104519",
      "en": "Das Gerät sendet eine Frequenz aus, die Ihre Chancen leicht verbessern.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104520",
      "en": "Nicht so wie mein System, aber es reicht, um Ihre Siege schneller aufzuzeichnen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104521",
      "en": "Was? Nein. Das Gerät ist einfach. Es nutzt brutale Gewalt, um sein Ziel zu erreichen. Und Sie haben gesehen, wie leicht es entdeckt werden kann.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104522",
      "en": "Mein System wird viel effizienter und nicht zu entdecken sein, wenn es fertig ist.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104523",
      "en": "Vielleicht könnten Sie Ihre Talente besser nutzen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104524",
      "en": "Suchen Sie sich einen Job.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104525",
      "en": "Sie könnten Ihre Talente besser nutzen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104526",
      "en": "Sie sind clever. Reißen Sie sich zusammen. ",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104527",
      "en": "Warum wollten Sie die Resultate aufzeichnen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104530",
      "en": "Können Sie das tun? Ist das nicht illegal?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104531",
      "en": "Vielleicht kann ich Ihnen den Beweis besorgen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104534",
      "en": "Ich werde Ihnen helfen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104536",
      "en": "Ich werde mein Glück auf die altmodische Art versuchen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104537",
      "en": "Was springt dabei für mich raus?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104538",
      "en": "Hilft mir das Gerät, zu gewinnen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104540",
      "en": "Warum verkaufen Sie das Gerät dann nicht?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104551",
      "en": "Vielleicht nicht.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104552",
      "en": "Experiment?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104554",
      "en": "Warum haben Sie's gemacht?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104556",
      "en": "Spielen Sie einfach das Spiel.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104559",
      "en": "Wie soll das funktionieren?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104560",
      "en": "Interessant.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104564",
      "en": "Lassen Sie's mich tun.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104565",
      "en": "Ich werde Ihnen nicht helfen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104566",
      "en": "Bezahlung",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104567",
      "en": "Gerät",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|104570",
      "en": "Sagen Sie einfach die Wahrheit.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|162904",
      "en": "Nein.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|162905",
      "en": "Nein.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|162906",
      "en": "Nein.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|166651",
      "en": "Aber sicher.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_07toss_DSG_LOC|sta60_schells_D|166652",
      "en": "Wäre das nicht trotzdem Betrügen?",
      "tr": ""
    }
  ]
}