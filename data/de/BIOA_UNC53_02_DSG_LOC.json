{
  "meta": {
    "package": "BIOA_UNC53_02_DSG_LOC_DE.pcc",
    "stem": "BIOA_UNC53_02_DSG_LOC",
    "textLang": "DE",
    "sets": 1
  },
  "entries": [
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142572",
      "en": "Warum bin ich nicht überrascht?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142574",
      "en": "Leben Sie wohl, Shepard.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142575",
      "en": "Was machen wir jetzt, Shepard?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142576",
      "en": "Was machen wir jetzt, Shepard?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142577",
      "en": "Befehle, Commander?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142578",
      "en": "Was sollen wir jetzt tun, Commander?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142579",
      "en": "Was jetzt?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142580",
      "en": "Das war eine Sprengkapsel. Jemand hat uns reingelegt.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142581",
      "en": "Was zum Teufel!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142582",
      "en": "Das war eine Sprengkapsel, Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142583",
      "en": "Seismische Ladung. Das war volle Absicht.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142584",
      "en": "Das war eine Sprengkapsel, Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142585",
      "en": "Shepard. Endlich.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142586",
      "en": "Sie erinnern sich nicht an mich. Natürlich. Das ist nicht tragisch. Ich erinnere mich an Sie. Ich vergesse nie jemanden, gegen den ich gekämpft habe.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142588",
      "en": "Mein Name ist Elanos Haliat. Ich bezweifle, dass Sie ihn kennen.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142589",
      "en": "Wer führt die Terminus-Clans Ihrer Meinung nach an, Shepard? Hm? Tausende von Piraten, Sklaventreibern, Kriminelle jeder Machart?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142590",
      "en": "Das ist richtig.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142591",
      "en": "Die stärksten Verbindungen.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142592",
      "en": "Derjenige, der die meisten Männer getötet, die meisten Schiffe erbeutet und die meisten Kolonien ausgeraubt hat.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142593",
      "en": "Vor drei Jahren war ich der Stärkste. Ich nutzte meinen Einfluss, um eine Flotte zusammenzustellen. Wir wollten Ihr Volk aus dem Randsektor vertreiben.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142594",
      "en": "Ich war der Motivator. Der Anstifter. Der, der Ruhm und Reichtümer versprach, wenn die größte Menschenkolonie des Clusters geplündert wird.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142595",
      "en": "Wir sind wegen Ihnen gescheitert. Wegen Ihrer verdammten Aktion.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142597",
      "en": "Leere Worte einer toten Frau.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142598",
      "en": "Leere Worte eines toten Mannes.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142601",
      "en": "Sollen sie nur. Wir werden bereit sein. Ein Allianz-Kriegsschiff wäre eine gute Beute.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142602",
      "en": "Oh, und falls Sie es noch nicht bemerkt haben, das Erz hier ist mit Schwermetallen durchzogen. Das Funkgerät Ihres Anzugs kann nicht da durchdringen.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142603",
      "en": "Das bezweifle ich.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142609",
      "en": "Meine Crew wird mich holen.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142611",
      "en": "Wir sehen uns wieder, Haliat. Verlassen Sie sich darauf.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142612",
      "en": "Wir werden einen Weg hier raus finden.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142615",
      "en": "Wir haben Luft und Licht, und die Normandy ist noch im Orbit. Wir suchen uns einen anderen Ausweg.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142616",
      "en": "Wir finden einen Ausweg. Ich muss jemandem da oben in den Arsch treten. Vielleicht finden wir hier etwas, das wir benutzen können.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142617",
      "en": "Ich weiß nicht. Ich muss nachdenken. Versuchen Sie, etwas zu finden, das wir benutzen können.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142622",
      "en": "Sie sind im Vorteil.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142623",
      "en": "Sind wir uns schon begegnet?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142625",
      "en": "Sie haben den Einsturz verursacht? Was hat das zu bedeuten?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142628",
      "en": "Bei den meisten kriminellen Organisationen ist es derjenige, der als der Erfolgreichste angesehen wird.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142630",
      "en": "Sie glauben wohl, dass mir das scheißegal ist. Interessant.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142631",
      "en": "Die interne Politik der Piratenbanden geht mir am Arsch vorbei.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142634",
      "en": "Sie haben den Angriff auf Elysium organisiert. Soll ich Ihnen für meinen Terrastern danken?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142635",
      "en": "Sie haben hinter dem Angriff auf Elysium gesteckt!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142640",
      "en": "So muss es nicht enden, Haliat.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142648",
      "en": "Wer sind Sie?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142649",
      "en": "\"Endlich?\"",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142650",
      "en": "Was ist hier los?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142654",
      "en": "Ein bejubelter Anführer.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142655",
      "en": "Na und?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142656",
      "en": "Woher soll ich das wissen? ",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142660",
      "en": "Sie haben Elysium angegriffen!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142661",
      "en": "Netter Versuch, Sie Genie.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142662",
      "en": "Der skyllianische Angriff.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142667",
      "en": "Können wir verhandeln?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142669",
      "en": "Kontaktieren Sie die Normandy.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142670",
      "en": "Ich kriege Sie noch.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142671",
      "en": "Unterschätzen Sie mich nicht.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142678",
      "en": "Keine Panik.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142679",
      "en": "Ich werde ihn töten.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142680",
      "en": "Ich werde mir etwas ausdenken.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142718",
      "en": "Der, der die Schuld für das Scheitern bekam.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142719",
      "en": "Ich war ruiniert, als Ihr Volk dem Angriff standgehalten hat. Wie könnte ich meinen Ruf besser wiederherstellen, als indem ich den ersten menschlichen Spectre eliminiere?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142721",
      "en": "Sie haben den Angriff auf Elysium organisiert. Zu schade, dass wir Sie zurück nach Terminus befördert haben, was?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142724",
      "en": "Netter Versuch, Sie Genie.",
      "tr": ""
    }
  ]
}