{
  "meta": {
    "package": "BIOA_NOR10_01_DS2_LOC_DE.pcc",
    "stem": "BIOA_NOR10_01_DS2_LOC",
    "textLang": "DE",
    "sets": 1
  },
  "entries": [
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|93593",
      "en": "Commander? Wir haben Besuch.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|93614",
      "en": "Nähern uns dem Ziel. Fertig zum Start.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|93616",
      "en": "Haben ihre Sensoren uns schon erfasst?",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|93617",
      "en": "Die Tarnsysteme sind aktiv. Solange sie uns nicht sehen können, wissen sie nicht, dass wir hier sind.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111512",
      "en": "Ich habe ein paar seltsame Aufzeichnungen von der Planetenoberfläche.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111513",
      "en": "Das geht nicht, Commander. Die nächste Landezone ist zwei Klicks entfernt.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111514",
      "en": "Zu Fuß werden wir es nicht rechtzeitig schaffen. Bringen Sie uns näher ran!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111515",
      "en": "Zu Fuß werden wir es nicht rechtzeitig schaffen. Bringen Sie uns näher ran!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111516",
      "en": "Näher geht es nicht! Es gibt keine Möglichkeit.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111517",
      "en": "Für eine solche Landung brauchen wir mindestens einhundert Meter freie Fläche. In Sarens Nähe gibt es nur zwanzig Meter.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111518",
      "en": "Wir müssen es versuchen.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111519",
      "en": "Zwanzig Meter? Das reicht nicht für eine saubere Landung.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111520",
      "en": "Zwanzig Meter? Das reicht nicht, um runterzugehen.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111522",
      "en": "Der Landewinkel ist zu steil!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111523",
      "en": "Wir müssen eine andere Landezone finden!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111524",
      "en": "Wir müssen eine andere Landezone finden!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111525",
      "en": "Es gibt keine andere Landezone!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111527",
      "en": "Das ist unsere einzige Chance!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111528",
      "en": "Das ist keine Chance! Das ist Selbstmord! Wir können nicht ...",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111529",
      "en": "Das ist keine Chance! Das ist Selbstmord! Wir können nicht ...",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111530",
      "en": "Das kriege ich hin.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111531",
      "en": "Das kriege ich hin.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111532",
      "en": "Bringen Sie uns runter, Joker. Folgen Sie den Koordinaten.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111536",
      "en": "Mit dem Mako absetzen.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111550",
      "en": "Joker?",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111551",
      "en": "Etwas Beeilung und runter zum Mako. Joker, setzen Sie uns direkt vor seine Füße ab!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111552",
      "en": "Das ist Saren.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111556",
      "en": "Nicht landen",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111570",
      "en": "Joker?",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|111571",
      "en": "Zeit für Action",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_01_DS2_LOC|nor20_ilos_approach_D|143388",
      "en": "Weiter, ihr beide! Rein da. Jetzt!",
      "tr": ""
    }
  ]
}