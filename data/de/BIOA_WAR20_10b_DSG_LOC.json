{
  "meta": {
    "package": "BIOA_WAR20_10b_DSG_LOC_DE.pcc",
    "stem": "BIOA_WAR20_10b_DSG_LOC",
    "textLang": "DE",
    "sets": 1
  },
  "entries": [
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|13326",
      "en": "Sie sollten nicht dort runter gehen!",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|13340",
      "en": "Ich bin frei. Endlich bin ich frei!",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|13341",
      "en": "Es war ein Albtraum.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|13342",
      "en": "Niemand sollte solch unmenschliche Schmerzen erleben.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|13343",
      "en": "Jetzt brauche ich erstmal Urlaub.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104867",
      "en": "Der Mann ist am Ende. Wir sollten ihn in Ruhe lassen.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104868",
      "en": "Er ist verwirrt. Wir sollten ihn in Ruhe lassen.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104869",
      "en": "Lassen wir ihn in Ruhe. Wir können nichts mehr für ihn tun.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104870",
      "en": "Gehen wir. Er kann uns nicht weiterhelfen.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104871",
      "en": "Lassen wir ihn in Ruhe. Der Mann hat den Verstand verloren.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104872",
      "en": "Mir helfen? Nein. Niemand kann mir helfen.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104873",
      "en": "Daran habe ich auch schon gedacht. Schon oft.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104874",
      "en": "Aber ich möchte lieber im Kampf sterben.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104875",
      "en": "Nicht die Art Kampf, die Sie kennen ... Es ist wie, wenn man in einem Dornbusch hängt ... Je mehr man zappelt, desto ...",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104876",
      "en": "Keine Zeit mehr. Wir bekommen Gesellschaft.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104877",
      "en": "Sprechen Sie mit Fai Dan. Fragen Sie ihn nach... aaaaagh!",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104878",
      "en": "Achtung!",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104879",
      "en": "Achtung!",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104880",
      "en": "Aufpassen!",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104881",
      "en": "Achtung!",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104882",
      "en": "Vorsicht!",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104883",
      "en": "Nein! Ich will endlich frei sein!",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104884",
      "en": "Ich übernehme die Kontrolle! Das ist \"mein\" Leben!",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104886",
      "en": "Nicht tun. Ich werde es nicht tun. Nicht tun.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104887",
      "en": "Mein Verstand gehört mir. Mein Verstand gehört mir. Mein Verstand gehört mir. ",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104888",
      "en": "SCHREI",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104889",
      "en": "Bald ist alles vorbei. Keine Schmerzen mehr. Nicht mehr...",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104890",
      "en": "Nicht das, was ich sollte, und alles, was ich nicht sollte.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104891",
      "en": "Ich \"könnte\" Sie aufhalten ... Wie würde Ihnen das gefallen?",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104892",
      "en": "Ich \"könnte\" es Ihnen sagen. Ihnen \"alles\" sagen ... Wie würde Ihnen das gefallen?",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104893",
      "en": "Uuuaaaah!",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104894",
      "en": "Oh, Mann ... Das war hart diesmal ...!",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104895",
      "en": "Nur der Peitschenruf des Meisters.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104896",
      "en": "Erinnert mich daran, dass ich noch am Leben bin.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104897",
      "en": "Sie sind hinter den Geth her, stimmt's? Sie sind nicht die Einzigen, die an diesen \"Dingern\" interessiert sind.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104898",
      "en": "Dann bleiben Sie nicht zu lange, sonst werden Sie mit der Zeit ... aaagh!",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104899",
      "en": "Nicht \"sucht nach\". Sondern, \"versucht loszuwerden\".",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104900",
      "en": "Sie sind ein Dorn im Fleische des ... aaagh!",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104901",
      "en": "Alles dreht sich darum, dass ... aaaaiiee!",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104902",
      "en": "Gyahh-ha-ha-ha! Ahahahahaha!",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104908",
      "en": "Was machen Sie hier unten?",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104910",
      "en": "Sie können mich nicht aufhalten.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104912",
      "en": "Was ist da hinten?",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104915",
      "en": "Was ist nur los mit Ihnen?",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104918",
      "en": "Für so etwas habe ich keine Zeit.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104919",
      "en": "Wer außer uns sucht noch nach den Geth?",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104924",
      "en": "Kann man Ihnen irgendwie helfen? Wollen Sie überhaupt Hilfe?",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104926",
      "en": "Vielleicht sollte ich ihn von seinen Leiden befreien.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104928",
      "en": "Was für ein Kampf?",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104929",
      "en": "Vielleicht kann ich Ihnen helfen, wenn Sie mir von Ihrem Kampf erzählen.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104932",
      "en": "Gehen wir.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104933",
      "en": "Wie kann ich helfen?",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104934",
      "en": "Ihn vielleicht töten?",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104937",
      "en": "Kampf?",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104938",
      "en": "Erzählen Sie mir mehr.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104944",
      "en": "Wer sind Sie?",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104945",
      "en": "Aus dem Weg.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104946",
      "en": "Warum nicht?",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104952",
      "en": "Alles in Ordnung?",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104953",
      "en": "Sie sind irgendwie seltsam.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104957",
      "en": "Ich gehe.",
      "tr": ""
    },
    {
      "key": "BIOA_WAR20_10b_DSG_LOC|war20_iannewstead_D|104958",
      "en": "Wie meinen Sie das?",
      "tr": ""
    }
  ]
}