    },
    {
      "key": "BIOA_STA60_09A_DSG_LOC|sta70_captain_D|106234",
      "en": "Let's do it.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_09A_DSG_LOC|sta70_captain_D|106236",
      "en": "They pulled me off the mission. Just like when they forced you to give up the Normandy.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_09A_DSG_LOC|sta70_captain_D|106237",
      "en": "The Normandy's been grounded. ",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_09A_DSG_LOC|sta70_captain_D|106239",
      "en": "You had to know what was going to happen. Why didn't you warn me?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_09A_DSG_LOC|sta70_captain_D|106242",
      "en": "There's only one ship that can get me into the Terminus Systems undetected, and she's grounded.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_09A_DSG_LOC|sta70_captain_D|106244",
      "en": "If we steal the Normandy, you're the one left holding the bag.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_09A_DSG_LOC|sta70_captain_D|106246",
      "en": "Stealing the Normandy is mutiny. What if the crew won't help me?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_09A_DSG_LOC|sta70_captain_D|106247",
      "en": "I won't forget this, Captain. I promise.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_09A_DSG_LOC|sta70_captain_D|106248",
      "en": "What's the plan?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_09A_DSG_LOC|sta70_captain_D|106255",
      "en": "You're going to get yourself killed. There has to be another way.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_09A_DSG_LOC|sta70_captain_D|106256",
      "en": "There's got to be a better way.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_09A_DSG_LOC|sta70_captain_D|106269",
      "en": "You'll have a better chance if you go after the ambassador's computer.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_09A_DSG_LOC|sta70_captain_D|106271",
      "en": "It's your call, Captain.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_09A_DSG_LOC|sta70_captain_D|106273",
      "en": "If you're lucky, the patrols won't catch you.",
