    },
    {
      "key": "BIOA_STA60_09A_DSG_LOC|sta70_captain_D|106286",
      "en": "How?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_09A_DSG_LOC|sta70_captain_D|106288",
      "en": "What happens to you?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_09A_DSG_LOC|sta70_captain_D|106289",
      "en": "Tell me what to do.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_09A_DSG_LOC|sta70_captain_D|106291",
