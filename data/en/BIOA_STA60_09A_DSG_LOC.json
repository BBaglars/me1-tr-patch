    },
    {
      "key": "BIOA_STA60_09A_DSG_LOC|sta70_captain_D|106292",
      "en": "Thank you.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_09A_DSG_LOC|sta70_captain_D|106293",
