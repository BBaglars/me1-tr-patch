    },
    {
      "key": "BIOA_STA60_09A_DSG_LOC|sta70_captain_D|106275",
      "en": "Not yet.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_09A_DSG_LOC|sta70_captain_D|106276",
