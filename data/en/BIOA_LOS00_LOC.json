      "tr": ""
    },
    {
      "key": "BIOA_LOS00_LOC|combat_banter_00_D|160624",
      "en": "Not now, Shepard!",
      "tr": ""
    },
    {
      "key": "BIOA_LOS00_LOC|combat_banter_00_D|160626",
      "en": "Take out those hostiles!",
      "tr": ""
    },
    {
      "key": "BIOA_LOS00_LOC|combat_banter_00_D|160627",
      "en": "Now is not the time!",
      "tr": ""
    },
    {
      "key": "BIOA_LOS00_LOC|los10_banter_00_d|160578",
      "en": "This city is too quiet.",
      "tr": ""
    },
    {
      "key": "BIOA_LOS00_LOC|los10_banter_00_d|160579",
      "en": "I wonder how many lived here?",
      "tr": ""
    },
    {
      "key": "BIOA_LOS00_LOC|los10_banter_00_d|160580",
      "en": "Feel like I'm walking over a grave.",
      "tr": ""
    },
    {
      "key": "BIOA_LOS00_LOC|los10_banter_00_d|160582",
      "en": "I wouldn't touch anything.",
      "tr": ""
    },
    {
      "key": "BIOA_LOS00_LOC|los10_banter_00_d|160583",
      "en": "Feels like we're being watched. And not by the geth.",
      "tr": ""
    },
    {
      "key": "BIOA_LOS00_LOC|los10_banter_00_d|160584",
      "en": "Let's just find the Conduit and get the hell off this world.",
      "tr": ""
    },
    {
      "key": "BIOA_LOS00_LOC|los10_banter_00_d|160586",
      "en": "I never dreamed I would actually find Ilos!",
      "tr": ""
    },
    {
      "key": "BIOA_LOS00_LOC|los10_banter_00_d|160587",
      "en": "I wish I had more time to study all of this.",
      "tr": ""
    },
    {
      "key": "BIOA_LOS00_LOC|los10_banter_00_d|160588",
      "en": "So much history here. So much to learn. I only hope I have the chance to come back some day.",
      "tr": ""
    },
    {
      "key": "BIOA_LOS00_LOC|los10_banter_00_d|160590",
      "en": "This place feels wrong to me. And not just because of the geth.",
      "tr": ""
    },
    {
      "key": "BIOA_LOS00_LOC|los10_banter_00_d|160591",
      "en": "There are secrets here that were meant to be forgotten.",
      "tr": ""
    },
    {
      "key": "BIOA_LOS00_LOC|los10_banter_00_d|160593",
      "en": "There's something in the air here; death is on the wind. It's a good place for killing.",
      "tr": ""
    },
    {
      "key": "BIOA_LOS00_LOC|los10_banter_00_d|160594",
      "en": "A lot of people died here long ago. Now it's time for a lot of geth to join them.",
      "tr": ""
    },
    {
      "key": "BIOA_LOS00_LOC|los10_banter_00_d|160596",
      "en": "My people once tried to find this world. We hoped we could settle here. But we didn't know it would feel so... unwelcome.",
      "tr": ""
    },
    {
      "key": "BIOA_LOS00_LOC|los10_banter_00_d|160597",
      "en": "We shouldn't be here. Not us. Not the geth. Not Saren.",
      "tr": ""
    }
  ]
}