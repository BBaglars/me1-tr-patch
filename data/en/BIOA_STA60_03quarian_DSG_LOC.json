  "entries": [
    {
      "key": "BIOA_STA60_03quarian_DSG_LOC|sta60_quarian_D|86362",
      "en": "Fist set me up! I knew I couldn't trust him!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_03quarian_DSG_LOC|sta60_quarian_D|86371",
      "en": "Then I have a chance to repay you for saving my life. But not here. We need to go somewhere safe.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_03quarian_DSG_LOC|sta60_quarian_D|86372",
      "en": "The ambassador's office. It's safe there. He'll want to see this anyway.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_03quarian_DSG_LOC|sta60_quarian_D|86373",
      "en": "The ambassador's office. It's safe there. He'll want to see this anyway.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_03quarian_DSG_LOC|sta60_quarian_D|86374",
      "en": "We could take her to the human embassy. Your ambassador will want to see this anyway.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_03quarian_DSG_LOC|sta60_quarian_D|105558",
      "en": "I know how to look after myself. Not that I don't appreciate the help. Who are you?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_03quarian_DSG_LOC|sta60_quarian_D|105559",
      "en": "Then I guess there are two things I need to thank you for. Who are you?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_03quarian_DSG_LOC|sta60_quarian_D|105560",
      "en": "Not so fast. Who are you?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_03quarian_DSG_LOC|sta60_quarian_D|105561",
      "en": "I guess I owe you. But not out here in the open. We need to go somewhere safe.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_03quarian_DSG_LOC|sta60_quarian_D|105562",
      "en": "Were you hurt in the fight?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_03quarian_DSG_LOC|sta60_quarian_D|105563",
      "en": "Don't worry about Fist. He got what was coming to him.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_03quarian_DSG_LOC|sta60_quarian_D|105564",
      "en": "You've got proof Saren is working with the geth. Hand it over.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_03quarian_DSG_LOC|sta60_quarian_D|105565",
      "en": "I don't have time for questions. I need the evidence you have against Saren.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_03quarian_DSG_LOC|sta60_quarian_D|105567",
      "en": "My name's Shepard. I'm looking for evidence to prove Saren's a traitor.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_03quarian_DSG_LOC|sta60_quarian_D|105568",
      "en": "Are you okay?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_03quarian_DSG_LOC|sta60_quarian_D|105569",
      "en": "I took care of him.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_03quarian_DSG_LOC|sta60_quarian_D|105570",
      "en": "Give me the evidence.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_03quarian_DSG_LOC|sta60_quarian_D|105571",
      "en": "A friend.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_03quarian_DSG_LOC|sta60_quarian_D|105572",
      "en": "A friend.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_03quarian_DSG_LOC|sta60_quarian_D|105573",
      "en": "A friend.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_03quarian_DSG_LOC|sta60_quarian_D|105574",
      "en": "Someone who saved your life.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_03quarian_DSG_LOC|sta60_quarian_D|105575",
      "en": "I'm with the Alliance.",
      "tr": ""
    }
  ]
