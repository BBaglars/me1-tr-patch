{
  "meta": {
    "package": "BIOA_PRO10_06_DSG_LOC_INT.pcc",
    "stem": "BIOA_PRO10_06_DSG_LOC",
    "textLang": "INT",
    "sets": 2
  },
  "entries": [
    {
      "key": "BIOA_PRO10_06_DSG_LOC|pro10_trig08_nihlus_d|149252",
      "en": "Change of plans, Shepard. There's a small spaceport up ahead.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_06_DSG_LOC|pro10_trig08_nihlus_d|149253",
      "en": "I want to check it out. I'll wait for you there.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_06_DSG_LOC|pro10_trig08_nihlus_d|153297",
      "en": "Sounds like Nihlus already knew the beacon wasn't here.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_06_DSG_LOC|pro10_trigger_08_probe_d|4377",
      "en": "This is the dig site. The beacon was right here. It must have been moved.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_06_DSG_LOC|pro10_trigger_08_probe_d|4378",
      "en": "By who? Our side? Or the geth?",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_06_DSG_LOC|pro10_trigger_08_probe_d|4379",
      "en": "Hard to say. Maybe we'll know more after we check out the research camp.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_06_DSG_LOC|pro10_trigger_08_probe_d|4394",
      "en": "If they were lucky. Maybe hiding up in the camp.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_06_DSG_LOC|pro10_trigger_08_probe_d|4399",
      "en": "It's just on the top of this ridge. Up the ramps.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_06_DSG_LOC|pro10_trigger_08_probe_d|4403",
      "en": "Let's get moving. Williams, where's the camp?",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_06_DSG_LOC|pro10_trigger_08_probe_d|4418",
      "en": "You think anyone got out of here alive?",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_06_DSG_LOC|pro10_trigger_08_probe_d|4423",
      "en": "We make for the camp.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_06_DSG_LOC|pro10_trigger_08_probe_d|46143",
      "en": "We're wasting time.",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_06_DSG_LOC|pro10_trigger_08_probe_d|46144",
      "en": "Any survivors?",
      "tr": ""
    },
    {
      "key": "BIOA_PRO10_06_DSG_LOC|pro10_trigger_08_probe_d|46145",
      "en": "Let's go there.",
      "tr": ""
    }
  ]
}