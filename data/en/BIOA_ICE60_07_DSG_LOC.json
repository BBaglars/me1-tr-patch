{
  "meta": {
    "package": "BIOA_ICE60_07_DSG_LOC_INT.pcc",
    "stem": "BIOA_ICE60_07_DSG_LOC",
    "textLang": "INT",
    "sets": 8
  },
  "entries": [
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice50_trig22_juleth_ambush_D|85576",
      "en": "I'm sorry about this, Shepard. We've got orders from Benezia.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice50_trig22_juleth_ambush_D|85577",
      "en": "Open fire!",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81499",
      "en": "What?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81500",
      "en": "I am Alestia Iallis, from the University of Auräis. Is there anything in particular you want to know? Or should I just spout random facts?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81501",
      "en": "I was meditating. I suppose to a species as brash as yours, it would appear to be inattention.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81502",
      "en": "You are interrupting my meditations. Precisely how rude must I be to convince you to leave?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81507",
      "en": "Recently transferred, yes.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81508",
      "en": "Molecular genetics. I specialize in biotic-enhanced allele-specific hybridization.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81509",
      "en": "I am very good at tracking inherited variations in genetic sequences. I am sure you would find it quite dull.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81510",
      "en": "It's a genetic thing. Forget it.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81511",
      "en": "That is one of the virtues of the meditation you interrupted.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81512",
      "en": "Why ask me and not your friend?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81513",
      "en": "Because I do not know anything about the Matriarch.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81514",
      "en": "Then why would I?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81515",
      "en": "Do you know President Huerta of Earth? I did not think so.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81516",
      "en": "Then I will return to my meditations.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81517",
      "en": "Tell me about yourself.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81518",
      "en": "Did I interrupt something?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81520",
      "en": "No need to be so rude.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81526",
      "en": "You're a member of the science teams?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81527",
      "en": "What do you do here?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81528",
      "en": "That's a bit technical for me.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81530",
      "en": "You seem less upset at this situation than the others.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81531",
      "en": "Do you know Matriarch Benezia?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81534",
      "en": "That's all for now.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81535",
      "en": "Sorry, I'll leave.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81537",
      "en": "Personal questions",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81538",
      "en": "Your work",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81539",
      "en": "Calm",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81540",
      "en": "Benezia",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81541",
      "en": "Goodbye.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81542",
      "en": "My apologies.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81543",
      "en": "Inconsiderate much?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81550",
      "en": "What do you study?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81551",
      "en": "That was over my head.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|81555",
      "en": "Goodbye.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|101432",
      "en": "I saw her. You asked if I knew her. I do not.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|101433",
      "en": "Benezia passed through here. You didn't see her?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|101434",
      "en": "But she's here.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|120392",
      "en": "Think you could translate that into galactic?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_alestiaiallis_D|120393",
      "en": "Speak plain.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_guard_1_D|81478",
      "en": "I didn't know Alliance basic training included biochemistry.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_guard_1_D|81482",
      "en": "Got a smoke? We're all out.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_guard_1_D|81483",
      "en": "Been counting your kills? I'm up to twenty-four.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_guard_1_D|81484",
      "en": "Krogan. Hanar. These things. Doesn't matter what color they are, or how many legs they have. They're all out to screw us.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_guard_1_D|81486",
      "en": "Welcome to hell. Smoking or non-smoking?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_guard_1_D|81487",
      "en": "I just shoot things. You want a sitrep, you talk to Cap'n Ventralis.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_guard_1_D|81488",
      "en": "The science crew look about to wet themselves.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_guard_2_D|81450",
      "en": "You got a cure for rampaging bugs, Spectre?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_guard_2_D|81454",
      "en": "Science pukes. Should just bug out and leave 'em to die. All their fault anyway.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_guard_2_D|81455",
      "en": "Heh. \"Bug out.\" Heh. Heh.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_guard_2_D|81456",
      "en": "What the hell are you looking at? You want me to use this?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_guard_2_D|81457",
      "en": "The company sent up a bunch of damn asari. Eye candy won't kill bugs.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_guard_2_D|81459",
      "en": "Why'd you come up here? Some sort of death wish?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_guard_2_D|81460",
      "en": "You think I'm afraid of you? Of them? Go talk to the captain. I'm watching you.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_guard_2_D|81461",
      "en": "Blow your goddamn head off.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_guard_2_D|81462",
      "en": "We're so dead.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_scientist_1_D|80728",
      "en": "No! Don't touch me!",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_scientist_1_D|80729",
      "en": "I won't cause any trouble! I won't!",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_scientist_1_D|80731",
      "en": "I hope the others survive. I hope we all do.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_scientist_1_D|80735",
      "en": "Where did they come from? Were they in the lab? I never went in the high security areas.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_scientist_1_D|80736",
      "en": "My contract was up. I was going home.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_scientist_1_D|80737",
      "en": "They'll be coming for me. I know they will.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_scientist_1_D|80738",
      "en": "That Matriarch's dead. Everyone's dead over there. I tried to tell her, but she pressed down on my brains.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_scientist_1_D|80740",
      "en": "Why would you come here? We're all going to die.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_scientist_1_D|80741",
      "en": "You should go back down the mountain. While you can.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_scientist_1_D|80742",
      "en": "We're going to be eaten. Or freeze to death. Unless they bomb us from orbit.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_scientist_2_D|80756",
      "en": "You gonna find a cure for being eaten next?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_scientist_2_D|80760",
      "en": "You're not going to go to the hot labs, are you?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_scientist_2_D|80761",
      "en": "That stain in the corner is where Ellie died. I wanted to ask her out, but I never...",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_scientist_2_D|80762",
      "en": "Look at the guard over there. Look at his hands. See them twitching?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_scientist_2_D|80763",
      "en": "If the bugs don't get us, one of Ventralis' people is going to flip out and kill us.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_scientist_2_D|80765",
      "en": "Why'd you come up here?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_scientist_2_D|80766",
      "en": "Ventralis has been awake for two days. Hard to believe he can walk straight.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_scientist_2_D|80767",
      "en": "We're dead. We just don't want to accept it.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_scientist_2_D|97292",
      "en": "No!",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_ambient_scientist_2_D|97293",
      "en": "I won't cause any trouble! I won't!",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81706",
      "en": "What's on your mind?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81707",
      "en": "I can't talk about what happened. Not here. Too public. ",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81708",
      "en": "Talk to Dr. Cohen down in the medical ward. He was the project lead.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81709",
      "en": "I'm a toxicologist. I can't talk about my work. Not that I'm doing anything since the accident.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81710",
      "en": "I can't say. I signed a non-disclosure agreement. If we survive, I'd like to keep my job.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81711",
      "en": "The location is terrible, but the pay is better than any other commercial lab.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81715",
      "en": "The outside world doesn't exist here. Just walls of ice and rock. There's only the work, the discovery.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81716",
      "en": "It's easy to forget why science is guided by ethics. Maybe we're paying for that now.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81718",
      "en": "Nothing. I didn't work there. As far as I know, Han Olar was the only survivor.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81719",
      "en": "No, he's staying in the science team's quarters.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81720",
      "en": "Be gentle with him. He had a trying experience.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81721",
      "en": "It would be petty to complain after showering off a coworker's brain.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81722",
      "en": "None of us have had enough sleep since the attack. Of course, not all of us have guns.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81723",
      "en": "Asari? Well, there's Dr. Iallis over there.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81724",
      "en": "Dr. Iallis is-- Well, she was right over there. ",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81725",
      "en": "There's also our guest, Lady Benezia. Captain Ventralis might know where she is.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81727",
      "en": "Remember to report any suspicious noises.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81728",
      "en": "What! No!",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81729",
      "en": "Sorry. I haven't had much sleep since the attack. Is there something you need?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81730",
      "en": "There was an accident here?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81732",
      "en": "What do you do here?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81733",
      "en": "What sort of work do you do here?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81737",
      "en": "You're not happy on Peak 15?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81741",
      "en": "What do you know about the hot labs?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81742",
      "en": "Is he in the medical ward?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81744",
      "en": "How are you holding up?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81746",
      "en": "I'm looking for an asari.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81750",
      "en": "I'll talk to you later.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81753",
      "en": "Accident?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81754",
      "en": "Personal questions",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81755",
      "en": "This lab",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81756",
      "en": "The hot labs",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81757",
      "en": "The situation here",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81758",
      "en": "Benezia",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81759",
      "en": "Goodbye.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81763",
      "en": "You don't like it here?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|81768",
      "en": "Where can I find him?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|102856",
      "en": "Get away from me!",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_palon_D|102857",
      "en": "The guards would shoot me to get you.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80691",
      "en": "Nervously, I will keep my head down.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80692",
      "en": "With trepidation, take your fighting elsewhere.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80693",
      "en": "Relieved, it is pleasant to see you well.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80694",
      "en": "Grimly, I will hope it is so.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80695",
      "en": "Uncertain, I welcome you. Cautiously, I am curious to know what you're doing here.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80696",
      "en": "Furtively, I am concerned about the state of our guards. Many have been awake for days.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80697",
      "en": "Surprised, one has visited recently. Furtively, there are rumors she has gone to the hot lab.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80698",
      "en": "Sympathetically, everyone here could say the same.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80699",
      "en": "For now, with forced cheer, I still have a limited supply of equipment to sell.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80700",
      "en": "Regretfully, most of my stock has been appropriated by Captain Ventralis.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80701",
      "en": "With nervous amusement, I have nothing else to do. Why not continue to run my kiosk?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80702",
      "en": "Pointedly, I give freely to Captain Ventralis. You, delicately, are not paid to protect us.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80704",
      "en": "I'll see you later.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80706",
      "en": "I heard there were some problems up here.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80708",
      "en": "I was sent here to find an asari Matriarch.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80710",
      "en": "It seems I've been caught up in events.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80712",
      "en": "Let's have a look.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80713",
      "en": "This doesn't seem like the time for commerce.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80714",
      "en": "Given the situation, you should freely contribute to the defense.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80716",
      "en": "Goodbye.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80718",
      "en": "I came to help.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80719",
      "en": "Matriarch Benezia",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80720",
      "en": "Good question.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80724",
      "en": "Show me what you've got.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80725",
      "en": "You're running a store?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|80726",
      "en": "What's this \"sell\" crap?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|147394",
      "en": "Show me what you've got.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_07_DSG_LOC|ice60_petozi_D|147395",
      "en": "Show me what you've got.",
      "tr": ""
