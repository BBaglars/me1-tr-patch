{
  "meta": {
    "package": "BIOA_ICE20_06_DSG_LOC_INT.pcc",
    "stem": "BIOA_ICE20_06_DSG_LOC",
    "textLang": "INT",
    "sets": 2
  },
  "entries": [
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96791",
      "en": "I don't think you're supposed to be in here, Shepard.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96792",
      "en": "Oh, now you're going to show some respect?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96793",
      "en": "Leave? You think I'm going to let you walk out? Uh-uh. ",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96794",
      "en": "I'm Sergeant Kaira Stirling, Elanus Risk Control Services.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96796",
      "en": "Anoleis would throw you offworld for what you did here. I won't. You know what we did to cop killers on my world?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96797",
      "en": "Your men are dirty, Sergeant. You're here off-duty, breaking the law for bribe money.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96798",
      "en": "You're breaking the law for bribe money. You know what we do to dirty cops on my world?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96799",
      "en": "What a load of crap. You're here off-duty, breaking the law for bribe money. ",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96800",
      "en": "Being a cop doesn't give you the right to break the law yourself. You accepted bribe money.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96801",
      "en": "You're here off-duty, breaking the law for bribe money. You expect us to feel bad for stopping you?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96802",
      "en": "Well, I don't need a gun to rip you to pieces.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96803",
      "en": "You talk the talk. Let's see if you can walk after I break your legs.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96804",
      "en": "I don't care.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96806",
      "en": "Get out of here.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96807",
      "en": "I'll be keeping my eye on you.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96808",
      "en": "You're not so tough.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96809",
      "en": "You better toe the line here.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96810",
      "en": "You have me at a disadvantage, Miss...?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96812",
      "en": "Do you plan on making me leave?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96814",
      "en": "No, I'm not. Are you?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96818",
      "en": "I didn't want to fight them. They fired first.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96820",
      "en": "If you want a fight, I'll give you one.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96822",
      "en": "I have a mission to complete. I did what I had to.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96825",
      "en": "Who are you?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96826",
      "en": "Your point?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96828",
      "en": "Nope.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96834",
      "en": "They didn't give me a choice.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96835",
      "en": "Bring it on.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_kairastirling_D|96836",
      "en": "I'm on a mission.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78961",
      "en": "Freeze! Hanshan security. This office is sealed.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78962",
      "en": "Qui'in? Are you working for him? He's under investigation.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78963",
      "en": "The administrator's orders. Lorik Qui'in is under investigation.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78964",
      "en": "You're the Spectre, right? Lorik Qui'in is under investigation.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78965",
      "en": "Hey, I'm not the one who wants Qui'in. Anoleis has a varren up his ass about this guy.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78966",
      "en": "You're bluffing.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78967",
      "en": "When the wager is one's life, is calling the bluff really so wise?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78968",
      "en": "Everything the commander has said is true. I'd step aside if I were you.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78969",
      "en": "How do you rate your confidence in that? Ninetieth percentile? Is a 10% chance of death acceptable?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78970",
      "en": "Your funeral, pal.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78971",
      "en": "You're right. They're actually going to let me eat you.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78973",
      "en": "He ain't paying me enough to take on Spectres, or Alliance troops, or whatever.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78974",
      "en": "How about this? You pretend you didn't see us, we'll pretend we didn't see you.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78975",
      "en": "You want to cause trouble?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78976",
      "en": "Lorik Qui'in gave me a pass in.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78977",
      "en": "What are you doing in these offices?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78978",
      "en": "What'll you do if I don't?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78979",
      "en": "Anoleis is paying you to shake this place down. Does Captain Matsuo know you're here?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78981",
      "en": "Anoleis is paying you to shake this place down. That makes you a criminal. I can kill criminals.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78990",
      "en": "Stand aside, kid. Unlike most people you face, we're armed.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78991",
      "en": "Qui'in let me in.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78992",
      "en": "What's going on here?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78993",
      "en": "Or what?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78994",
      "en": "You're here illegally.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78995",
      "en": "You can't take us.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|78996",
      "en": "I'll have to remove you.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|147412",
      "en": "I'm going in there, and I don't want to hurt you. Why don't you just go? We'll pretend this never happened.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|147413",
      "en": "I don't have time for this. Get the hell out of here, or I'll start shooting.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|147414",
      "en": "You two leave while you can.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|147415",
      "en": "Out of my way.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_06_DSG_LOC|ice20_trig11_si_guards_D|162973",
      "en": "This is suspicious.",
      "tr": ""
    }
  ]
}