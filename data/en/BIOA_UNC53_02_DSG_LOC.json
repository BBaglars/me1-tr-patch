{
  "meta": {
    "package": "BIOA_UNC53_02_DSG_LOC_INT.pcc",
    "stem": "BIOA_UNC53_02_DSG_LOC",
    "textLang": "INT",
    "sets": 1
  },
  "entries": [
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142572",
      "en": "Why am I not surprised?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142574",
      "en": "Goodbye, Shepard.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142575",
      "en": "What do we do now, Shepard?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142576",
      "en": "What do we do now, Shepard?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142577",
      "en": "Orders, Commander?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142578",
      "en": "What do we do now, Commander?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142579",
      "en": "Now what?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142580",
      "en": "That was a detonator. Someone just screwed us.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142581",
      "en": "What the hell!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142582",
      "en": "That was a detonator, Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142583",
      "en": "Seismic charge. Someone did that on purpose.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142584",
      "en": "That was a detonator, Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142585",
      "en": "Shepard. At last.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142586",
      "en": "You don't remember me. No matter. I remember you. I never forget anyone I've fought.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142588",
      "en": "My name is Elanos Haliat. I doubt you know it.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142589",
      "en": "Who do you think runs the Terminus Clans, Shepard? Hm? Thousands of pirates, slavers, criminals of every stripe?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142590",
      "en": "That's correct.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142591",
      "en": "The strongest leads.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142592",
      "en": "The one who kills the most men. Seizes the most ships. Pillages the most colonies.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142593",
      "en": "Three years ago, I was the strongest. I used my influence to assemble a fleet. We would drive your kind out of the Verge.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142594",
      "en": "I was the motivator. The instigator. The one who promised glory and riches for sacking the largest human colony in the cluster.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142595",
      "en": "Failed because of you. Your damnable holding action. ",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142597",
      "en": "Empty words from a dead woman.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142598",
      "en": "Empty words from a dead man.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142601",
      "en": "Let them. We'll be ready. An Alliance warship would make a fine prize.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142602",
      "en": "Oh, and if you hadn't noticed, the ores here are laced with heavy metals. I'm afraid your suit radios aren't powerful enough to transmit out.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142603",
      "en": "I rather doubt that.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142609",
      "en": "My crew will come for me.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142611",
      "en": "You'll see me again, Haliat. Count on it.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142612",
      "en": "We'll find a way out of here.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142615",
      "en": "We've got air and light, and the Normandy's still in orbit. Let's look for another way out.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142616",
      "en": "We find a way out. Someone up there needs my boot up his ass. See if there's anything in here we can use.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142617",
      "en": "I don't know. Let me think. You two see if there's anything in here we can use.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142622",
      "en": "You have me at a disadvantage.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142623",
      "en": "Have we met?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142625",
      "en": "You caused the cave-in? What's the meaning of this?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142628",
      "en": "In most criminal organizations, it's the one who's recognized as the most successful.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142630",
      "en": "You assume I give a damn. That's cute.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142631",
      "en": "I don't study the internal politics of pirate bands.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142634",
      "en": "You organized the attack on Elysium. You want me to thank you for my Star of Terra?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142635",
      "en": "You're the one behind the attack on Elysium!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142640",
      "en": "It doesn't have to be like this, Haliat.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142648",
      "en": "Who are you?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142649",
      "en": "\"At last?\"",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142650",
      "en": "Explain yourself.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142654",
      "en": "An acclaimed leader.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142655",
      "en": "Who cares?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142656",
      "en": "How should I know?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142660",
      "en": "You attacked Elysium!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142661",
      "en": "Nice try, genius.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142662",
      "en": "The Skyllian Blitz.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142667",
      "en": "Can't we negotiate?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142669",
      "en": "Call the Normandy.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142670",
      "en": "I'll get you.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142671",
      "en": "Don't underestimate me.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142678",
      "en": "No one panic.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142679",
      "en": "I'll kill him.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142680",
      "en": "I'll think of something.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142718",
      "en": "The one blamed when it failed.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142719",
      "en": "I was ruined when your kind held against the Blitz. What better way to recover my reputation than by eliminating the first human Spectre?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142721",
      "en": "You organized the attack on Elysium. Too bad we kicked your ass back into Terminus, huh?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_02_DSG_LOC|sp121_mastermind_d|142724",
      "en": "Nice try, genius.",
      "tr": ""
    }
  ]
}