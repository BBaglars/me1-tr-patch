    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_human_radio_D|175196",
      "en": "Are you there? You've got to hurry. You've really pissed them off.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_human_radio_D|175197",
