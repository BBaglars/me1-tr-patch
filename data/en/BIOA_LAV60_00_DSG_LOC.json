  "entries": [
    {
      "key": "BIOA_LAV60_00_DSG_LOC|lav70_banter_00_D|160135",
      "en": "At least it's a dry heat.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV60_00_DSG_LOC|lav70_banter_00_D|160136",
      "en": "Hell of a place.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV60_00_DSG_LOC|lav70_banter_00_D|160138",
      "en": "Like an oven here.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV60_00_DSG_LOC|lav70_banter_00_D|160139",
      "en": "I think my eyeballs are dried out.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV60_00_DSG_LOC|lav70_banter_00_D|160141",
      "en": "Remember to stay hydrated.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV60_00_DSG_LOC|lav70_banter_00_D|160142",
      "en": "I thought Palaven was hot.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV60_00_DSG_LOC|lav70_banter_00_D|160144",
      "en": "Nothing but rocks, dirt, and lava. Reminds me of home.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV60_00_DSG_LOC|lav70_banter_00_D|160145",
      "en": "Fifty degrees hotter and I might start to feel uncomfortable. How are you mammals doing, Shepard?",
      "tr": ""
    },
    {
      "key": "BIOA_LAV60_00_DSG_LOC|lav70_banter_00_D|160147",
      "en": "My people have searched many generations for a world to call home. If we landed here, we'd just keep searching.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV60_00_DSG_LOC|lav70_banter_00_D|160148",
      "en": "Even the geth wouldn't want to live in this heat.",
      "tr": ""
    }
  ]
}