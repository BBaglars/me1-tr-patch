{
  "meta": {
    "package": "BIOA_STA60_01destiny_DSG_LOC_INT.pcc",
    "stem": "BIOA_STA60_01destiny_DSG_LOC",
    "textLang": "INT",
    "sets": 1
  },
  "entries": [
    {
      "key": "BIOA_STA60_01destiny_DSG_LOC|sta20_trig_03_flagship_D|97026",
      "en": "Don't kid yourself. It's even bigger than it looks.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_01destiny_DSG_LOC|sta20_trig_03_flagship_D|100775",
      "en": "How would you know?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_01destiny_DSG_LOC|sta20_trig_03_flagship_D|100776",
      "en": "I got a tour. One of five hundred to see the Ascension from the inside out.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_01destiny_DSG_LOC|sta20_trig_03_flagship_D|100777",
      "en": "Really?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_01destiny_DSG_LOC|sta20_trig_03_flagship_D|100778",
      "en": "Took almost six hours, and we only saw one-tenth of the ship. I even got to meet the commander.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_01destiny_DSG_LOC|sta20_trig_03_flagship_D|100779",
      "en": "Matriarch Lidanya? You met her?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_01destiny_DSG_LOC|sta20_trig_03_flagship_D|100780",
      "en": "Well, she addressed everyone on the tour. But I got pretty close to her.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_01destiny_DSG_LOC|sta20_trig_03_flagship_D|100781",
      "en": "Huh. Just look at that ship. You'd have be stupid to mess with that.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_01destiny_DSG_LOC|sta20_trig_03_flagship_D|100782",
      "en": "Very true. She's got almost as much firepower as the rest of the asari fleet combined.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_01destiny_DSG_LOC|sta20_trig_03_flagship_D|100783",
      "en": "Hopefully she'll never need to use it.",
      "tr": ""
    }
  ]
}