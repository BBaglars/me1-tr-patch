    {
      "key": "BIOA_STA30_02_DSG_LOC|sta30_banter_01_D|160024",
      "en": "You can see half the Citadel from up here.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_02_DSG_LOC|sta30_banter_01_D|160025",
      "en": "When you look out and see something this beautiful... well, it really helps you understand what we're fighting to save.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_02_DSG_LOC|sta30_banter_01_D|160027",
      "en": "This is quite the view, Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_02_DSG_LOC|sta30_banter_01_D|160028",
      "en": "It's so peaceful up here. Very romantic... if you're into that sort of thing.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_02_DSG_LOC|sta30_banter_01_D|160030",
      "en": "Seeing the wards stretching out before you really makes you appreciate the Citadel as a true wonder of Prothean engineering.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_02_DSG_LOC|sta30_banter_01_D|160032",
      "en": "The Normandy combines the best of Alliance technology and turian engineering. It shows what we're capable of if we work together.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_02_DSG_LOC|sta30_banter_01_D|160034",
      "en": "A private docking bay. Wonder how much the Alliance had to shell out for this?",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_02_DSG_LOC|sta30_banter_01_D|160036",
      "en": "The Normandy is amazing, Shepard. It's an honor to be among her crew.",
      "tr": ""
    }
  ]
