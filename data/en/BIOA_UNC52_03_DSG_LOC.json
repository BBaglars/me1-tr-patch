{
  "meta": {
    "package": "BIOA_UNC52_03_DSG_LOC_INT.pcc",
    "stem": "BIOA_UNC52_03_DSG_LOC",
    "textLang": "INT",
    "sets": 2
  },
  "entries": [
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175511",
      "en": "Don't come any closer.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175512",
      "en": "We can do this hard way... or we can end this peacefully.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175513",
      "en": "Look, I'm just doing my job here. Hijacking this rock wasn't my idea.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175514",
      "en": "I signed on to make a little profit. A quick slave grab. Nothing more.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175515",
      "en": "Damn it.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175516",
      "en": "I don't think so. Balak would skin me alive and sell my hide out of spite.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175517",
      "en": "Crazy bastard. This whole mission's gone to hell and I'm gonna pay for it.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175519",
      "en": "Huh. Maybe.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175520",
      "en": "I had a bad feeling about this from the moment we landed. Now Balak wants you dead.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175525",
      "en": "And what Balak wants, Balak gets. I can't change that.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175526",
      "en": "An, uh, interesting proposal. It certainly has benefits over the current situation.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175527",
      "en": "Shut it down. This is Balak's problem now.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175528",
      "en": "I hope you're as quick with a gun as you are with your promises. For both our sakes.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175529",
      "en": "I hope you're right.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175530",
      "en": "Perfectly.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175531",
      "en": "Balak's holed up in the main facility. You'll need this to get in.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175532",
      "en": "Don't underestimate him. He's a mean bastard.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175533",
      "en": "Let's go. We're getting off this rock.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175534",
      "en": "Hold it right there. This doesn't have to end in bloodshed.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175535",
      "en": "Get him! No one leaves.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175536",
      "en": "Get her! No one leaves.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175538",
      "en": "I didn't think you batarians knew the meaning of the word.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175540",
      "en": "Balak's a dead man. And if I ever see you in human territory again, so are you. Understand?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175545",
      "en": "I've got nothing to say to a batarian terrorist.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175547",
      "en": "That's reason enough for me.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175549",
      "en": "Maybe you should take your men and go. Before you get hurt.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175552",
      "en": "So why do you listen to him?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175553",
      "en": "You keep listening to this Balak and you'll end up dead.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175561",
      "en": "Do you always want to be second in command? Get me out of here and I'll take care of Balak. Then you can start giving the orders.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175562",
      "en": "But I can!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175563",
      "en": "Spoken like a true lackey. You get me out of here and I'll take care of Balak. Or you can take your chances with me.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175566",
      "en": "Balak will get what's coming to him. And so will you if I ever catch you in human territory again. Are we clear?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175567",
      "en": "Balak will be dead before you get off the asteroid.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175569",
      "en": "Peacefully?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175571",
      "en": "Quicker.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175572",
      "en": "It'll be fine.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175573",
      "en": "Relax.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175579",
      "en": "I doubt that.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175582",
      "en": "[Attack him]",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175583",
      "en": "Good idea.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175587",
      "en": "Why follow him?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175588",
      "en": "Yes you will.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175598",
      "en": "Forget Balak.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175599",
      "en": "[Attack him]",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175600",
      "en": "Don't be stupid.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175639",
      "en": "Good question.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175640",
      "en": "Well, it's not too late. You can still leave.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175642",
      "en": "Then go.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175977",
      "en": "Don't you think I know that?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175978",
      "en": "I'm just following orders here. If it were up to me, we'd have already left.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175979",
      "en": "This isn't just a slave grab anymore. Millions of people are going to die.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|175981",
      "en": "It's gone too far.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_batarian_lieutenant_D|178006",
      "en": "It *is* up to you.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_trig_batarians_D|179108",
      "en": "Release the varren!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_trig_batarians_D|179109",
      "en": "Look out!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_trig_batarians_D|179110",
      "en": "Take cover.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_trig_batarians_D|179111",
      "en": "Fresh meat.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_trig_batarians_D|179112",
      "en": "Harak. Chekt! Chekt!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_trig_batarians_D|179113",
      "en": "Perimeter breached!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_trig_batarians_D|179114",
      "en": "Arm the drones!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_trig_batarians_D|179115",
      "en": "Send the drones in!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_trig_batarians_D|179116",
      "en": "Humans! Take 'em out!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_trig_batarians_D|179117",
      "en": "Balak wants them all dead!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_trig_batarians_D|179118",
      "en": "Alliance military!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_trig_batarians_D|179119",
      "en": "Die, human!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_trig_batarians_D|179120",
      "en": "Filthy human scum!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_trig_batarians_D|179121",
      "en": "Balak's down!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_trig_batarians_D|179122",
      "en": "They got Charn!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_trig_batarians_D|179123",
      "en": "D...d...d...die, human!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_trig_batarians_D|179124",
      "en": "Fall back to base!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_trig_batarians_D|179125",
      "en": "Go! Go! Go!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_trig_batarians_D|179126",
      "en": "Move it!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_trig_batarians_D|179127",
      "en": "Hold the line!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_trig_batarians_D|179128",
      "en": "Death before surrender!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_03_DSG_LOC|prc1_trig_batarians_D|179347",
      "en": "Attack!",
      "tr": ""
    }
  ]
}