{
  "meta": {
    "package": "BIOA_ICE20_03D_DSG_LOC_INT.pcc",
    "stem": "BIOA_ICE20_03D_DSG_LOC",
    "textLang": "DE",
    "sets": 1
  },
  "entries": [
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21357",
      "en": "Wie kann diese Person Ihnen helfen?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21358",
      "en": "Natürlich.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21359",
      "en": "Was ist, wenn Inamorda sieht, dass diese Person mit Ihnen redet?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21360",
      "en": "Haben Sie das Paket? Der Kunde wird unruhig.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21361",
      "en": "Seien Sie gegrüßt, Spectre. Bringen Sie das Paket?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21362",
      "en": "Der Spectre hat dieser Person einen großen Dienst erwiesen. Aus der Tiefe des Lichts dankt sie Ihnen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21363",
      "en": "Diese Person versprach eine Belohnung für die geleisteten Dienste. Dieser schlägt untertänigst eine Summe von 250 Credits als angemessen vor.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21364",
      "en": "Dann ist das Geschäft abgeschlossen. Kann dieser Ihnen sonst noch irgendwie helfen?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21365",
      "en": "Ihre Worte sind leider nicht von der Hand zu weisen. ",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21366",
      "en": "Diese Person würde die Summe auf 500 Credits erhöhen. Dann bekämen Sie die Hälfte seines Profits. Mehr kann diese Person Ihnen nicht anbieten.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21367",
      "en": "Diese Person ist froh, dass wir uns einig sind.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21368",
      "en": "N... nein! Diese Person würde nie ...!",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21369",
      "en": "Diese Person möchte den Spectre zur Eile mahnen. Der Kunde ist aufbrausend.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21370",
      "en": "Das können Sie nicht tun! Inamorda wird mit dieser Person zürnen!",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21371",
      "en": "Diese Person möchte, dass Sie jetzt gehen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21377",
      "en": "Haben Sie über die Bitte von dieser Person nachgedacht?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21378",
      "en": "Diese Person wartet auf Ihre Rückkehr.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21379",
      "en": "Diese Person grüßt Sie. Sie sind der Spectre, der den Hanshan-Raumhafen besucht?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21380",
      "en": "In der Tat, werter Spectre. Ihre Ankunft hat bei den Firmen hier nicht für Freude gesorgt.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21382",
      "en": "Diese Person trägt eine Last, die Sie erleichtern könnten. Wenn wir uns einigen, würde dieser Sie auch entschädigen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21383",
      "en": "Diese Person hat für einen Kunden einen besonderen Gegenstand besorgt, der auf der Station allerdings verboten ist. Aber Sie könnten ihn durch den Zoll bringen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21384",
      "en": "Das ist nicht inkorrekt.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21385",
      "en": "Diese Person dankt dem Spectre untertänigst. Das Paket wird zu Ihrem Schiff gebracht. Sie müssen es dieser Person bloß bringen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21386",
      "en": "Bitte erwähnen Sie das vor Administrator Anoleis nicht. Er würde sonst nur \"Gebühren\" erheben.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21389",
      "en": "Der Kunde zieht es vor, anonym zu bleiben.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21390",
      "en": "Ihre Worte klingen nicht unvernünftig.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21391",
      "en": "Ist Ihnen die Dringlichkeit bewusst? Die Verzögerung sorgt für einige Unruhe.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21392",
      "en": "Diese Person ist sehr dankbar, dass der Spectre das versteht.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21393",
      "en": "Diese Person versteht. Das Angebot bleibt bestehen. Dieser kann wirklich Hilfe gebrauchen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21394",
      "en": "Diese Person fleht Sie untertänigst an, noch einmal über seine Bitte nachzudenken.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21396",
      "en": "Natürlich. Verzeihung, falls diese Person Sie belästigt haben sollte.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21397",
      "en": "Zeigen Sie mir Ihre Waren.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21398",
      "en": "Das hatte ich vergessen. Ich kümmere mich darum.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21399",
      "en": "Bitte sehr.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21401",
      "en": "Das klingt vernünftig.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21402",
      "en": "Hätten Sie das ohne mich überhaupt am Zoll vorbeischmuggeln können? Sie könnten etwas großzügiger sein.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21404",
      "en": "Wie rücksichtsvoll von Ihnen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21405",
      "en": "Das muss reichen. ",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21406",
      "en": "Wollen Sie mich zum Lachen bringen? Denken Sie, ich wäre zu Ihrer Belustigung hier? Dass ich lustige Geräusche mache, wenn Sie mich beleidigen, anstatt mich zu belohnen?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21408",
      "en": "Ich war beschäftigt. Ich hole es später ab.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21409",
      "en": "Ich habe es noch nicht abgeholt.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21411",
      "en": "Ich komme dann später wieder.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21412",
      "en": "Kleine Planänderung - ich habe entschieden, es zu behalten.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21422",
      "en": "Okay, ich helfe Ihnen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21424",
      "en": "Ich schaue mich nur mal um.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21425",
      "en": "Neuigkeiten verbreiten sich hier schnell.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21430",
      "en": "Sie wollen meinen Status für einen Schmuggel ausnutzen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21431",
      "en": "Ich habe kein Problem damit.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21435",
      "en": "Ich will wissen, für wen das \"Paket\" bestimmt ist.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21436",
      "en": "Es wäre töricht, dies zu tun, ohne zu wissen, ob ich damit nicht meinen Feinden helfe.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21439",
      "en": "Ihr Kunde hätte gewiss lieber sein Paket. Sagen Sie mir, für wen es ist, oder ich verschwinde.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21440",
      "en": "Abstreitbarkeit. Dann ist er nicht dumm. Gut.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21441",
      "en": "Ich soll das Gesetz aufrecht erhalten, nicht brechen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21442",
      "en": "Kann ich jetzt etwas kaufen?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21443",
      "en": "Ich gehe dann jetzt.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21444",
      "en": "Vielleicht später. Jetzt brauche ich Vorräte.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21445",
      "en": "Ich denke darüber nach und melde mich später wieder.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21449",
      "en": "Sicher, wie Sie meinen. Das ist ein Geschäft, nicht wahr?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21497",
      "en": "In Ordnung.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21498",
      "en": "Diese Person würde gern auf weitere Interaktionen verzichten.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21499",
      "en": "Ja. Möchten Sie etwas kaufen?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21500",
      "en": "Sie haben was? Der Spectre hat diese Person betrogen?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21501",
      "en": "Der mit dem Namen Anoleis wird Wachen herschicken. Verstehen Sie? Diese Person wird es schwer haben, sich hier seinen Lebensunterhalt zu verdienen. ",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21502",
      "en": "Sie stehen moralisch auf derselben Stufe, denn Sie waren ebenfalls an einem Verbrechen beteiligt.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21503",
      "en": "Diese Person möchte, dass Sie jetzt gehen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21506",
      "en": "Der Spectre hat diese Person viel gekostet. Vielleicht mehr, als Ihnen klar ist. Diese Person ist auf dieses Einkommen angewiesen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21507",
      "en": "Diese Person möchte, dass Sie etwas kaufen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21508",
      "en": "Sind Sie sauer, weil ich das Paket selbst verkauft habe?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21509",
      "en": "Ich habe Inamorda das Paket verkauft.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21511",
      "en": "Für einen Schmuggler empfinde ich kein Mitgefühl.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21513",
      "en": "Sie haben das Gesetz gebrochen. Ein echter Polizist hätte Sie verhaftet und ins Gefängnis geworfen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|21517",
      "en": "Anoleis hat das Paket. Er hat mir ein besseres Angebot gemacht.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40617",
      "en": "Abgemacht.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40618",
      "en": "Sie haben mich gebraucht.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40619",
      "en": "Das ist wohl ein Witz.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40621",
      "en": "Schon besser.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40622",
      "en": "In Ordnung.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40625",
      "en": "Auf Wiedersehen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40628",
      "en": "Sie sind ein Gesetzesbrecher.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40629",
      "en": "Ich bin kein Polizist.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40641",
      "en": "Ich tue es.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40643",
      "en": "Auf Wiedersehen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40644",
      "en": "Sie haben's schon gehört?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40647",
      "en": "Ich will einkaufen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40652",
      "en": "Ich soll also schmuggeln.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40653",
      "en": "Nein. Das klingt nicht gut.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40654",
      "en": "Ich will einkaufen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40655",
      "en": "Auf Wiedersehen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40656",
      "en": "Ich tue es.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40657",
      "en": "Empfänger",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40661",
      "en": "Sie müssen mich verstehen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40662",
      "en": "Los, oder vergessen Sie's.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40663",
      "en": "Ist auch besser so.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40666",
      "en": "Ich will einkaufen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40667",
      "en": "Auf Wiedersehen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40669",
      "en": "Ich möchte etwas kaufen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40670",
      "en": "Schmollen Sie?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40671",
      "en": "Noch nicht.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40672",
      "en": "Ja.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40673",
      "en": "[LÜGEN] Ich hab's noch nicht.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40674",
      "en": "Nein.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40675",
      "en": "Ich werde es behalten.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40676",
      "en": "Ich habe es Inamorda gegeben.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|40677",
      "en": "Ich habe es Anoleis gegeben.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|55927",
      "en": "Ich will einkaufen. Wir können das später besprechen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|55928",
      "en": "Ich möchte etwas kaufen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|79006",
      "en": "Diese Person findet das nicht sehr tröstlich.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|79007",
      "en": "Kann diese Person Ihnen sonst noch irgendwie helfen?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|79008",
      "en": "Sucht der Spectre denn etwas Bestimmtes?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|79009",
      "en": "Der Kunde ist der Kroganer, der Inamorda genannt wird. Er ist ein Kopfgeldjäger mit einem gewissen Ruf und leicht erregbar.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|79010",
      "en": "Haben Sie das Paket?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|79011",
      "en": "Wären Sie so nett, diese Aufgabe für diese Person zu erledigen?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|79012",
      "en": "Diese Person muss diskret bleiben. Seien Sie versichert, dass der Inhalt für niemanden hier eine Gefahr darstellt.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|79013",
      "en": "Ich kümmere mich darum, versprochen. Es war mir bloß entfallen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|79014",
      "en": "Es tut mir Leid, auch wenn Ihnen das nicht hilft. Der Deal mit Anoleis hat meine Mission hier beschleunigt.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE20_03D_DSG_LOC|ice20_opold_D|79017",
