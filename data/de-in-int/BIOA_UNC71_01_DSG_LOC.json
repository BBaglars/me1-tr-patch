    {
      "key": "BIOA_UNC71_01_DSG_LOC|sp118_distress_call_D|131159",
      "en": "... allgemeiner Notruf ... Medizinischer Transporter Sacred Angel ...",
      "tr": ""
    },
    {
      "key": "BIOA_UNC71_01_DSG_LOC|sp118_distress_call_D|131160",
      "en": "... kritisches Systemversagen ... verlieren Energie ... Notlandung ... --gos Rho ...  ... wiederhole ... Argos\u00A0...",
      "tr": ""
    },
    {
      "key": "BIOA_UNC71_01_DSG_LOC|sp118_distress_call_D|131161",
      "en": "Kommunikation fällt aus ... Lebenserhaltung ... Notfalltransponder ... fällt aus ... bitte beeilen Sie sich.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC71_01_DSG_LOC|sp118_distress_call_D|131163",
      "en": "Da ist das Wrack. Aber ich sehe keine Überlebenden.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC71_01_DSG_LOC|sp118_distress_call_D|131164",
      "en": "Offenbar kommt das Signal aus diesem Wrack.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC71_01_DSG_LOC|sp118_distress_call_D|131165",
      "en": "Da ist das abgestürzte Schiff. Das muss der richtige Ort sein.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC71_01_DSG_LOC|sp118_distress_call_D|131166",
      "en": "Das Signal kommt aus dem abgestürzten Schiff.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC71_01_DSG_LOC|sp118_distress_call_D|131167",
      "en": "Da ist das Wrack. Das Signal muss von dort kommen.",
      "tr": ""
    },
    {
