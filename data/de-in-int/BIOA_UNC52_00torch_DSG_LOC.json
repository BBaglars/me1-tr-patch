{
  "meta": {
    "package": "BIOA_UNC52_00torch_DSG_LOC_INT.pcc",
    "stem": "BIOA_UNC52_00torch_DSG_LOC",
    "textLang": "DE",
    "sets": 3
  },
  "entries": [
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_computer_warnings_D|179098",
      "en": "Achtung: Bodenradar zeigt nahe Sprengladungen zur Fahrzeugabwehr. Bitte zu Fuß weitergehen.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_computer_warnings_D|179349",
      "en": "Achtung: Sprengladungen voraus. Langsam vorrücken.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_computer_warnings_D|179350",
      "en": "Achtung: Sprengladungen zur Fahrzeugabwehr geortet. Bitte zu Fuß weitergehen.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_computer_warnings_D|179351",
      "en": "Achtung: drucksensitive Minen geortet. Es wird empfohlen, zu Fuß weiterzugehen.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_computer_warnings_D|179352",
      "en": "Achtung: Bodenradar hat Sprengladungen zur Fahrzeugabwehr geortet. Bitte zu Fuß weitergehen.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_computer_warnings_D|179353",
      "en": "Achtung: drucksensitive Sprengladungen geortet. Bitte das Fahrzeug verlassen und zu Fuß weitergehen.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_computer_warnings_D|179354",
      "en": "Achtung: Bodenradar hat drucksensitive Sprengladungen geortet. Es wird empfohlen, zu Fuß weiterzugehen.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_human_radio_D|175196",
      "en": "Sind Sie da? Sie müssen sich beeilen. Sie haben sie ernsthaft sauer gemacht.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_human_radio_D|175197",
      "en": "Ihr Anführer bringt überall Sprengladungen an. Ich glaube, er will die ganze Anlage hochjagen.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_human_radio_D|175198",
      "en": "Verschwinden Sie da.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_human_radio_D|175199",
      "en": "Nicht schießen. Bitte.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_human_radio_D|175336",
      "en": "Sie sind auf dem richtigen Weg.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_human_radio_D|175338",
      "en": "Ich weiß nicht, wer Sie sind, aber ich ... Mist! Muss weg.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_human_radio_D|175340",
      "en": "Können Sie mich hören? Ich habe zu viele Interferenzen auf diesem Kanal.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_human_radio_D|175341",
      "en": "Verdammtes Ding! Tut mir leid, aber ich habe einige Rückkopplungen.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_human_radio_D|175834",
      "en": "Mal sehen, ob ich es reparieren kann. Machen Sie in der Zwischenzeit einfach so weiter.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_trig_batarians_D|179108",
      "en": "Lasst die Varren frei!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_trig_batarians_D|179109",
      "en": "Achtung!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_trig_batarians_D|179110",
      "en": "In Deckung.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_trig_batarians_D|179111",
      "en": "Frischfleisch!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_trig_batarians_D|179112",
      "en": "Harak. Chekt! Chekt!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_trig_batarians_D|179113",
      "en": "Eindringlinge!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_trig_batarians_D|179114",
      "en": "Macht die Drohnen scharf!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_trig_batarians_D|179115",
      "en": "Schickt die Drohnen rein!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_trig_batarians_D|179116",
      "en": "Menschen! Macht sie alle!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_trig_batarians_D|179117",
      "en": "Balak will sie tot sehen!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_trig_batarians_D|179118",
      "en": "Allianz-Militär!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_trig_batarians_D|179119",
      "en": "Stirb, Mensch!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_trig_batarians_D|179120",
      "en": "Dreckiger Menschenabschaum!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_trig_batarians_D|179121",
      "en": "Balak hat's erwischt!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_trig_batarians_D|179122",
      "en": "Sie haben Charn!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_trig_batarians_D|179123",
      "en": "St-t-t-t-t-irb, Menschlein!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_trig_batarians_D|179124",
      "en": "Zurück zur Basis!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_trig_batarians_D|179125",
      "en": "Los! Los! Los!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_trig_batarians_D|179126",
      "en": "Bewegung!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_trig_batarians_D|179127",
      "en": "Stellung halten!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_trig_batarians_D|179128",
      "en": "Keiner gibt auf!",
      "tr": ""
    },
    {
      "key": "BIOA_UNC52_00torch_DSG_LOC|prc1_trig_batarians_D|179347",
      "en": "Angriff!",
      "tr": ""
    }
  ]
}