    {
      "key": "BIOA_STA30_02_DSG_LOC|sta30_banter_01_D|160024",
      "en": "Von hier aus kann man fast die Hälfte der Citadel sehen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_02_DSG_LOC|sta30_banter_01_D|160025",
      "en": "Wenn man raussieht und etwas so Schönes sieht ... na ja, man beginnt zu verstehen, worum wir kämpfen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_02_DSG_LOC|sta30_banter_01_D|160027",
      "en": "Beeindruckender Ausblick, Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_02_DSG_LOC|sta30_banter_01_D|160028",
      "en": "Es ist so friedlich hier oben. Sehr romantisch ... Wenn man solche Sachen mag.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_02_DSG_LOC|sta30_banter_01_D|160030",
      "en": "Wenn man sieht, wie sich die Bezirke vor einem erstrecken, lernt man die Citadel als Wunder protheanischer Ingenieurskunst zu schätzen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_02_DSG_LOC|sta30_banter_01_D|160032",
      "en": "Die Normandy vereint die besten Seiten der Allianz-Technik und der turianischen Technologie. Sie zeigt, was wir erreichen können, wenn wir zusammenarbeiten.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_02_DSG_LOC|sta30_banter_01_D|160034",
      "en": "Eine private Andockbucht. Ich frage mich, wie viel die Allianz dafür blechen musste.",
      "tr": ""
    },
    {
      "key": "BIOA_STA30_02_DSG_LOC|sta30_banter_01_D|160036",
      "en": "Die Normandy ist beeindruckend, Shepard. Es ist eine Ehre, zu ihrer Crew zu gehören.",
      "tr": ""
    }
  ]
}