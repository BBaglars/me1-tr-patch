  "entries": [
    {
      "key": "BIOA_STA20_A_Arrival_CIN_LOC|nor10_cutscene_oculon_approach_D|9552",
      "en": "Was für ein gigantisches Schiff!",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_A_Arrival_CIN_LOC|nor10_cutscene_oculon_approach_D|9553",
      "en": "Die Ascension. Das Flaggschiff der Citadel-Flotte.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_A_Arrival_CIN_LOC|nor10_cutscene_oculon_approach_D|9554",
      "en": "Größe allein ist auch nicht alles.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_A_Arrival_CIN_LOC|nor10_cutscene_oculon_approach_D|9555",
      "en": "Sehen Sie sich das Monster an! Sein Hauptgeschütz könnte jedes Schiff der Allianzflotte in Stücke reißen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_A_Arrival_CIN_LOC|nor10_cutscene_oculon_approach_D|9556",
      "en": "Gut, dass es zu unseren Verbündeten zählt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_A_Arrival_CIN_LOC|nor10_cutscene_oculon_approach_D|103154",
      "en": "Warum so empfindlich, Joker?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_A_Arrival_CIN_LOC|nor10_cutscene_oculon_approach_D|103155",
      "en": "Ich will damit nur sagen, dass man auch Feuerkraft braucht.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_A_Arrival_CIN_LOC|nor10_cutscene_oculon_approach_D|103311",
      "en": "Citadel-Kontrolle: Hier ist die SSV Normandy. Bitten um Landeerlaubnis.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_A_Arrival_CIN_LOC|nor10_cutscene_oculon_approach_D|103312",
      "en": "Bitte auf Freigabe warten, Normandy.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_A_Arrival_CIN_LOC|nor10_cutscene_oculon_approach_D|103313",
      "en": "Freigabe erteilt. Sie können mit dem Landeanflug beginnen. Ab jetzt übernimmt ein Allianz-Operator.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_A_Arrival_CIN_LOC|nor10_cutscene_oculon_approach_D|103314",
      "en": "Normandy, hier spricht der Allianz-Tower. Bitte fliegen Sie jetzt das Dock an.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_A_Arrival_CIN_LOC|nor10_cutscene_oculon_approach_D|103315",
      "en": "Roger, Allianz-Tower. Normandy out.",
      "tr": ""
    }
  ]
}