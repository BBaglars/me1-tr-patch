{
  "meta": {
    "package": "BIOA_ICE60_10_DSG_LOC_INT.pcc",
    "stem": "BIOA_ICE60_10_DSG_LOC",
    "textLang": "DE",
    "sets": 1
  },
  "entries": [
    {
      "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81817",
      "en": "Ihre Mission endet hier, Shepard.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81818",
      "en": "Was zum Teufel ...?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81819",
      "en": "Ich hatte keine Erlaubnis reinzukommen. Er war im Weg.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81820",
      "en": "Sie sind gar nicht so dumm, wie Sie aussehen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81821",
      "en": "Sie haben gesehen, was Sie sehen wollten. Mehr nicht.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81822",
      "en": "Ich hatte die Aufgabe, alles hier im Auge zu behalten.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81823",
      "en": "Mir wurde befohlen, Sie zu eliminieren, sollte sich die Gelegenheit dazu bieten. Und da sind Sie, gefangen in diesem Labor.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81824",
      "en": "Feuer frei!",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81825",
      "en": "Was zum Teufel ...?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81826",
      "en": "Das werden wir noch sehen, Miststück.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81827",
      "en": "Hinterhalt!",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81828",
      "en": "Mir war sie von Anfang an suspekt.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81830",
      "en": "Sie sind Benezias Schläfer.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81831",
      "en": "Was ist mit Ventralis' Mann passiert?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81833",
      "en": "Sie ist von Geth umzingelt und hat eine Waffe auf uns gerichtet. Schießt!",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81835",
      "en": "Ich dachte, Sie wären Wissenschaftlerin.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81837",
      "en": "Sie sind die Asari aus dem Speisesaal.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81841",
      "en": "Sie gehören zur Matriarchin.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81842",
      "en": "Wo ist die Wache?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81843",
      "en": "Tötet sie!",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81844",
      "en": "Sie haben mich belogen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_10_DSG_LOC|ice60_trig04_lab_ambush_D|81845",
      "en": "Ich habe Sie gesehen.",
      "tr": ""
    }
  ]
}