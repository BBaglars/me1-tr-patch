  "entries": [
    {
      "key": "BIOA_END70C_Bridge_CIN_LOC|end90_cutscenes_D|134975",
      "en": "Die Citadel öffnet sich! Alle Schiffe reinfliegen! Konzentriert euch auf die Sovereign!",
      "tr": ""
    },
    {
      "key": "BIOA_END70C_Bridge_CIN_LOC|end90_cutscenes_D|134976",
      "en": "Allianz-Schiffe reinfliegen! Rettet die Destiny Ascension!",
      "tr": ""
    },
    {
      "key": "BIOA_END70C_Bridge_CIN_LOC|end90_cutscenes_D|134977",
      "en": "Die Sovereign ist zu stark! Wir müssen uns zurückziehen!",
      "tr": ""
    },
    {
      "key": "BIOA_END70C_Bridge_CIN_LOC|end90_cutscenes_D|134978",
      "en": "Negativ! Das ist unsere einzige Chance! Macht das Monster um jeden Preis fertig!",
      "tr": ""
    },
    {
      "key": "BIOA_END70C_Bridge_CIN_LOC|end90_cutscenes_D|134979",
      "en": "Die Schilde sind unten! Das ist unsere Chance!",
      "tr": ""
    },
    {
      "key": "BIOA_END70C_Bridge_CIN_LOC|end90_cutscenes_D|134980",
      "en": "Feuert aus allen Rohren!",
      "tr": ""
    },
    {
      "key": "BIOA_END70C_Bridge_CIN_LOC|end90_cutscenes_D|147236",
      "en": "Na los, Mädel ... zeigen wir denen, was wir draufhaben.",
      "tr": ""
    },
    {
      "key": "BIOA_END70C_Bridge_CIN_LOC|end90_cutscenes_D|147237",
      "en": "An meine Flanke! Wir fliegen rein!",
      "tr": ""
    },
    {
      "key": "BIOA_END70C_Bridge_CIN_LOC|end90_cutscenes_D|148666",
      "en": "Es ist die Allianz! Der Göttin sei Dank!",
      "tr": ""
    },
    {
      "key": "BIOA_END70C_Bridge_CIN_LOC|end90_cutscenes_D|148667",
      "en": "Destiny Ascension, Sie sind gerettet. Ich wiederhole - Sie sind gerettet.",
      "tr": ""
    },
    {
      "key": "BIOA_END70C_Bridge_CIN_LOC|end90_cutscenes_D|148668",
      "en": "Alle Allianz-Schiffe halten die Formation. Warten Sie auf eine freie Schussbahn zur Sovereign. Das hat höchste Priorität. Ich wiederhole: Das hat jetzt absolute Priorität!",
      "tr": ""
    },
    {
      "key": "BIOA_END70C_Bridge_CIN_LOC|end90_cutscenes_D|148669",
      "en": "Commander - wir kriegen Verstärkung!",
      "tr": ""
    },
    {
      "key": "BIOA_END70C_Bridge_CIN_LOC|end90_cutscenes_D|148670",
      "en": "Es ist die Allianz! Öffnen Sie einen Komm-Kanal!",
      "tr": ""
    },
    {
      "key": "BIOA_END70C_Bridge_CIN_LOC|end90_cutscenes_D|148671",
      "en": "Hier ist die Ascension. Wir stehen unter schwerem Beschuss. GARDIAN-Abwehr wurde überwältigt, kinetische Barrieren sind ausgefallen.",
      "tr": ""
    },
    {
      "key": "BIOA_END70C_Bridge_CIN_LOC|end90_cutscenes_D|148672",
      "en": "Commander ... sie haben die Verbindung abgebrochen.",
      "tr": ""
    },
    {
      "key": "BIOA_END70C_Bridge_CIN_LOC|end90_cutscenes_D|148681",
      "en": "Los!",
      "tr": ""
    },
    {
      "key": "BIOA_END70C_Bridge_CIN_LOC|end90_cutscenes_D|148682",
      "en": "Achtung!",
      "tr": ""
