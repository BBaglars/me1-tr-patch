    {
      "key": "BIOA_END70C_Bridge_CIN_LOC|end90_cutscenes_D|153976",
      "en": "Die Citadel schließt sich. Sie versiegeln die Station!",
      "tr": ""
    },
    {
      "key": "BIOA_END70C_Bridge_CIN_LOC|end90_cutscenes_D|153977",
      "en": "Die feindlichen Schiffe dürfen nicht zwischen die Arme kommen!",
      "tr": ""
    },
    {
      "key": "BIOA_END70C_Bridge_CIN_LOC|end90_cutscenes_D|153978",
      "en": "Das feindliche Flaggschiff rückt vor. Es kommt schnell näher!",
      "tr": ""
    },
    {
      "key": "BIOA_END70C_Bridge_CIN_LOC|end90_cutscenes_D|153979",
      "en": "Stellung halten.",
      "tr": ""
