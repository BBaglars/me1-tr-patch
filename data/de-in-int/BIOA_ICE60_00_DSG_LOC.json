{
  "meta": {
    "package": "BIOA_ICE60_00_DSG_LOC_INT.pcc",
    "stem": "BIOA_ICE60_00_DSG_LOC",
    "textLang": "DE",
    "sets": 1
  },
  "entries": [
    {
      "key": "BIOA_ICE60_00_DSG_LOC|ice50_banter_00_D|160383",
      "en": "Ein wenig schattig hier.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_00_DSG_LOC|ice50_banter_00_D|160384",
      "en": "Vielleicht könnten wir ja ein wenig zündeln.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_00_DSG_LOC|ice50_banter_00_D|160385",
      "en": "Ich glaube, ich habe Schnee im Stiefel.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_00_DSG_LOC|ice50_banter_00_D|160386",
      "en": "Mom hatte Recht. Ich hätte mir 'nen Pulli mitnehmen sollen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_00_DSG_LOC|ice50_banter_00_D|160388",
      "en": "Das ist ja wie der Winter bei uns zu Hause.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_00_DSG_LOC|ice50_banter_00_D|160389",
      "en": "Ist verdammt kalt hier.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_00_DSG_LOC|ice50_banter_00_D|160390",
      "en": "Und all das wegen einer verdammten Asari.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_00_DSG_LOC|ice50_banter_00_D|160392",
      "en": "Je schneller wir von diesem Kühlschrank verschwinden, desto besser.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_00_DSG_LOC|ice50_banter_00_D|160393",
      "en": "Ich mag diesen Ort nicht. Hier gibt es zu viele dunkle Geheimnisse.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_00_DSG_LOC|ice50_banter_00_D|160395",
      "en": "Turianer mögen keine Kälte, Shepard. Hatte ich das je erwähnt?",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_00_DSG_LOC|ice50_banter_00_D|160396",
      "en": "So viel Eis und Schnee auf einem Haufen habe ich selten gesehen.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_00_DSG_LOC|ice50_banter_00_D|160397",
      "en": "Bleiben Sie wachsam. Lieber kalt als tot.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_00_DSG_LOC|ice50_banter_00_D|160399",
      "en": "Ich hasse Kälte.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_00_DSG_LOC|ice50_banter_00_D|160400",
      "en": "Ich muss mein Blut zum Zirkulieren bringen. Suchen Sie mir was zum Töten!",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_00_DSG_LOC|ice50_banter_00_D|160402",
      "en": "Der Reiz des Winters lässt schnell nach.",
      "tr": ""
    },
    {
      "key": "BIOA_ICE60_00_DSG_LOC|ice50_banter_00_D|160403",
      "en": "Ich trage einen Umweltanzug und mir ist immer noch kalt!",
      "tr": ""
    }
  ]
}