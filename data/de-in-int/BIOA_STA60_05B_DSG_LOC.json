  "entries": [
    {
      "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|74820",
      "en": "Stehen bleiben! Kommen Sie nicht näher!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|74821",
      "en": "Zurück oder wir schießen!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|74825",
      "en": "Äh ... nun ... öh ...",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|74826",
      "en": "Unglaublich, es hat funktioniert!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|74827",
      "en": "Leute zu erschießen ist nicht immer die beste Lösung.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|74833",
      "en": "Dies wäre ein guter Zeitpunkt, sich einen neuen Job zu suchen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|74834",
      "en": "Ich habe fünfzig Leibwächter getötet, um hier reinzukommen. Was glauben Sie, dass ich Ihnen antue?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|74837",
      "en": "Schaltet sie aus!",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|74842",
      "en": "Retten Sie sich.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|74843",
      "en": "Sie machen einen Fehler.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|74844",
      "en": "Sie arbeiten für Fist.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|95786",
      "en": "Es wäre schneller, sie einfach umzubringen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|95787",
      "en": "Auf den Gedanken wäre ich nie gekommen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|95788",
      "en": "Leute zu erschießen ist nicht immer die beste Lösung.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|95789",
      "en": "Leute zu erschießen ist nicht immer die beste Lösung.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|104812",
      "en": "Lagerarbeiter. Die echten Wachen müssen tot sein.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|104813",
      "en": "Lagerarbeiter. Die echten Wachen müssen tot sein.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_05B_DSG_LOC|sta60_fists_guards02_D|104814",
