    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta00_cab_D|159576",
      "en": "Bitte wählen Sie ein Ziel für den Citadel Rapid Transit aus.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_amb_crimeboss_D|140689",
      "en": "Hey, Spectre! Haben Sie einen Moment Zeit?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_amb_family_argue_D|138638",
      "en": "Aber Jake hätte das ganz sicher nicht gewollt!",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_amb_family_argue_D|138639",
      "en": "Woher willst du wissen, was mein Mann gewollt hätte?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_amb_family_argue_D|138640",
      "en": "Zumindest weiß ich, was ich sage. Du gefährdest damit dein Baby!",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_amb_family_argue_D|138641",
      "en": "Das Baby ist alles, was mir von Jake geblieben ist!",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_banter_02_D|159589",
      "en": "Hört noch jemand dieses tiefe Brummen? Offenbar kommt es von der Statue. Davon bekommt man ja Zahnschmerzen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_banter_02_D|159591",
      "en": "Kunst bedeutet mir normalerweise nicht sehr viel, aber diese Portalstatue? Gefällt mir.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_banter_02_D|159593",
      "en": "Diese Statue zeigt, wie gut die Protheaner es verstanden, Funktion und Form zu verschmelzen. Die Massenportale waren nicht nur ihre größte technologische Errungenschaft, sondern auch eine Inspiration für wunderschöne Kunstwerke.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_banter_02_D|159595",
      "en": "Die Keeper haben dem Portalmonument nie viel Aufmerksamkeit geschenkt. Kam mir immer schon etwas seltsam vor.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_banter_02_D|159597",
      "en": "Ich war nie ein Fan dieser Statue. Das Kroganer-Monument scheint mir einfach eindrucksvoller zu sein.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_banter_02_D|159599",
      "en": "Die Protheaner verstanden offensichtlich den ästhetischen Wert der Massenportale. Etwas, das wir Quarianer auf unseren Wanderungen zu schätzen gelernt haben.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140646",
      "en": "Hallo, Spectre. Ich möchte Ihnen ein Geschäft vorschlagen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140647",
      "en": "So etwas spricht sich herum. Zumindest in bestimmten Kreisen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140648",
      "en": "Natürlich sind Sie das. Aber ich biete Ihnen einen einfachen Job bei sehr guter Bezahlung an.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140649",
      "en": "Ich kenne zwei sehr mächtige Gangsterbosse.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140650",
      "en": "Sie verstecken sich auf entlegenen Planeten und ich habe die Koordinaten. Sie könnten der Galaxie einen Gefallen tun.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140651",
      "en": "Sie sollen mit Rotem Sand, einer absolut abhängig machenden Droge, handeln. Wer sie nicht mehr bezahlen kann, den verkaufen sie als Sklaven an die Batarianer.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140652",
      "en": "Sie sind skrupellos und lassen unschuldige Leute leiden. Man muss sie zur Strecke bringen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140653",
      "en": "Danke, aber Sie überschätzen meine Courage. Ich habe nicht vor, Sie umzubringen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140654",
      "en": "Sie sind der erste menschliche Spectre und machen einen wichtigen Job für die Menschheit.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140656",
      "en": "Verhaften für was? Wir unterhalten uns doch nur.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140658",
      "en": "Ich haben keine Ahnung. Aber sie sind ganz sicher bewaffnet.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140660",
      "en": "Woher wissen Sie, dass ich ein Spectre bin?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140662",
      "en": "Ich bin momentan sehr beschäftigt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140665",
      "en": "Was für Verbrechen haben diese Männer begannen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140667",
      "en": "Ich schalte sie aus und dann übernehmen Sie und wollen mich umbringen. Sehe ich wirklich so blöd aus?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140670",
      "en": "Sie gehören selbst zu diesen Leuten. Warum sollte ich also nicht Sie verhaften?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140672",
      "en": "Welche Verteidigungsmaßnahmen stehen den beiden zur Verfügung?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140674",
      "en": "Kein Interesse.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140675",
      "en": "Woher kennen Sie mich?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140676",
      "en": "Schön für Sie.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140680",
      "en": "Verbrechen",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140681",
      "en": "Klarer Fall von Falle",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140682",
      "en": "Ich könnte Sie festnehmen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140683",
      "en": "Verteidigung",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140821",
      "en": "Ich habe kein Interesse an Rotem Sand oder Sklaverei. Wer daran verdient, muss sterben. Wir beide wollen also dasselbe. ",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140822",
      "en": "Ich habe hervorragende Anwälte. Mich zu verhaften, wäre reine Zeitverschwendung.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140823",
      "en": "Sie haben sich zerstritten. Beide glauben, der andere wolle ihn töten. Deswegen werden sie gut vorbereitet sein.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140824",
      "en": "Wie dem auch sei: Hier sind die Koordinaten. Es ist Ihre Entscheidung, was Sie damit machen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140825",
      "en": "Wollen Sie wirklich diese Männer leben lassen, obwohl Sie sie aufhalten können?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140826",
      "en": "Ausgezeichnet. Hier sind die Koordinaten. Ich werde am dritten Koordinatenpunkt auf Sie warten, wenn die Männer tot sind.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140827",
      "en": "Auf Wiedersehen, Commander. Sehr erfreut, Sie kennen gelernt zu haben.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140828",
      "en": "Finden Sie jemanden anderes für diese Drecksarbeit. Ich werde nicht an einem Bandenkrieg teilnehmen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140831",
      "en": "Wenn sie so übel sind, wie Sie behaupten, muss man sie ausschalten.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140833",
      "en": "Kein Problem.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140834",
      "en": "Nein. Nehme den Job nicht.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140835",
      "en": "Ich tu's.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140836",
      "en": "Kein Problem.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140837",
      "en": "Kein Problem.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140838",
      "en": "Kein Problem.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|140839",
      "en": "Kein Problem.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|142562",
      "en": "Mir gehören einige Anteile an einigen gemeinsamen Projekten mit ihnen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|142563",
      "en": "Aber ihre Geschäftspraktiken zwingen mich dazu, unsere Beziehungen zu beenden.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|142564",
      "en": "Wenn sie tot sind, werde ich das Geschäft auf seriösere Weise weiterführen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|142565",
      "en": "Und welche Vorteile haben Sie von dieser Sache?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|142568",
      "en": "Vorteile?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_crimeboss_D|142571",
      "en": "Kein Problem.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138517",
      "en": "Es ist mir egal, was du darüber denkst, Michael. Das ist meine Entscheidung!",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138518",
      "en": "Ich weiß, wie traurig du bist, Rebekah. Aber du musst jetzt an das Baby denken!",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138519",
      "en": "Das Baby ist alles, was mir von meinem Bruder geblieben ist ... Ich fühle mich dafür verantwortlich, dass es dem Kind gut geht.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138520",
      "en": "Es ist auch alles, war mir geblieben ist, Michael.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138521",
      "en": "Ich will doch nur, dass es Jacobs Kind gut geht. Das schulde ich ihm einfach.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138522",
      "en": "Es wird ihm gut gehen. Versprochen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138523",
      "en": "Danke, dass Sie mit uns darüber gesprochen haben. Ich weiß das zu würdigen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138524",
      "en": "Ich muss mir das nicht mehr anhören, Michael.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138525",
      "en": "Wer hat Sie denn überhaupt gefragt! Vergiss es, Michael. Ich gehe.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138526",
      "en": "Verdammt! Rebekah!",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138527",
      "en": "Vielleicht können Sie ihr ja etwas Vernunft beibringen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138528",
      "en": "Ich weiß ganz genau, was ich tue, Michael! Ich werde mich keiner Behandlung unterziehen!",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138529",
      "en": "Meine Schwägerin hier ist schwanger. Und sie weigert sich, eine Gentherapie für das Baby in der Gebärmutter zu machen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138530",
      "en": "Mein Mann, Jacob, ist vor einigen Monaten an einer seltenen Herzkrankheit gestorben.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138531",
      "en": "Es ist möglich, dass das Baby an der gleichen Krankheit leidet. Aber durch eine Standard-Gentherapie könnte es geheilt werden.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138532",
      "en": "Aber die Heilungschancen stehen schlecht, Michael. Und in den Extranet-Berichten steht, dass das Baby dabei Schaden nehmen könnte!",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138533",
      "en": "Es ist weniger gefährlich als die genetischen Verbesserungen, die alle Allianz-Soldaten erhalten!",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138534",
      "en": "Eins von dreihundert. Höchstens.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138535",
      "en": "Und in den Extranet-Berichten steht auch etwas über langfristige Komplikationen, die noch niemand abwägen kann!",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138536",
      "en": "Verstehst du es nicht? Wenn mein Baby das eine von dreihundert ist, werde ich mich immer fragen, ob ich mein Baby unnötig getötet habe!",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138537",
      "en": "Die Ärzte beziffern die Chance auf eins-zu-fünfzig. Und wenn das Baby doch krank wird, gibt auch konventionelle Heilungsmethoden.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138539",
      "en": "Aber die sind nicht annähernd so effektiv wie die Gen-Therapie!",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138540",
      "en": "Ihre Meinung interessiert mich nicht! Wer sind Sie überhaupt? Das ist mein Kind. Und meine Entscheidung!",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138541",
      "en": "Es war entsetzlich, Jacob sterben zu sehen! Ich will nicht auch noch mein Kind verlieren!",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138542",
      "en": "Aber wenn wir dadurch ein Kind töten, das diese Krankheit vielleicht niemals bekommt? Was dann?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138543",
      "en": "Sie verstehen das nicht! Ich darf dieses Baby nicht verlieren! Es ist alles, was mir noch von ihm bleibt!",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138544",
      "en": "Und du und das Baby seid alles, was mir noch von Jacob bleibt! Ich will euch beide nicht auch noch verlieren!",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138547",
      "en": "Warum hast du mir das nicht gesagt? Statt mich anzuschreien ...",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138548",
      "en": "Aber Sie trifft keine vernünftige Entscheidung! Sie reagiert nur blind! Aus Trauer!",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138549",
      "en": "Natürlich ist sie das! Ich werde dem Kind ein Art Ersatzvater sein!",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138550",
      "en": "Wie können Sie es wagen? Ich will doch nur das Beste für das Baby.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138552",
      "en": "Kann ich Ihnen irgendwie helfen?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138553",
      "en": "Es ist Rebekahs Kind, Michael. Ich denke, Sie sollten Ihre Entscheidung respektieren.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138554",
      "en": "Ich weiß, dass Sie nur das Beste für das Kind Ihres Bruders wollen, aber das ist nicht Ihre Entscheidung.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138555",
      "en": "Geht es um die Gesundheit des Babys oder darum, dass es die letzte bleibende Erinnerung an Ihren Bruder ist?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138556",
      "en": "Natürlich trauert sie! So wie Sie! Aber auch wenn Sie sie anschreien, bringt das Ihren Bruder nicht zurück.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138557",
      "en": "Dann unterstützen Sie die Mutter des Kindes, wenn Sie solch schwierige Entscheidungen treffen muss.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138558",
      "en": "Sie haben einfach Angst, das Baby zu verlieren. So wie Sie Ihren Bruder verloren haben.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138563",
      "en": "Tut mir leid, dass ich nicht mehr helfen konnte. Viel Glück.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138563|m",
      "en": "Tut mir leid, dass ich Ihnen nicht mehr helfen konnte. Viel Glück.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138565",
      "en": "Vergessen Sie's. Dafür habe ich einfach keine Zeit.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138567",
      "en": "Belästigt Sie dieser Mann, Ma'am?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138570",
      "en": "Ich bin sicher, dass es dafür gute Gründe gibt. Ich würde auch gern die andere Seite der Geschichte hören.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138571",
      "en": "Ich dachte Gentherapien wären eine ganz normale Sache.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138575",
      "en": "Wie viele Babys erleiden denn Schaden durch diese Therapie?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138578",
      "en": "Und wie wahrscheinlich ist es, dass auch Ihr Kind diese Krankheit bekommt?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138581",
      "en": "Meiner Einschätzung nach sollten Sie die Gentherapie machen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138582",
      "en": "Sie haben schon Ihren Mann verloren. Lassen Sie aus Trauer darüber jetzt auch zu, dass ihr Baby in Gefahr gerät?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138583",
      "en": "Am Tod Ihres Mannes tragen Sie keine Schuld. Aber wenn Sie sich der Therapie verweigern, tragen Sie vielleicht die Verantwortung für den Tod des Kindes.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138584",
      "en": "Würde nicht auch Ihr Mann wollen, dass Ihr Baby bessere Chancen hat, als er selbst?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138585",
      "en": "Die Soldaten der Allianz werden viel schwereren Gen-Behandlungen unterzogen. Sie können die Therapie riskieren.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138586",
      "en": "Dann haben Sie alles getan, um dem Kind zu helfen. Mehr können Sie nicht von sich selbst verlangen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138592",
      "en": "Gibt es ein Problem?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138593",
      "en": "Was ist hier los?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138594",
      "en": "Lassen Sie sie in Ruhe.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138597",
      "en": "Eine Seite der Geschichte",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138598",
      "en": "Warum?",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138599",
      "en": "Egal",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138603",
      "en": "Therapiegefahren",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138604",
      "en": "Krankheitswahrscheinlichkeit",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138605",
      "en": "Gentherapie machen",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138606",
      "en": "Ihre Wahl",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138611",
      "en": "Ans Kind denken.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138612",
      "en": "Ist die Sache wert.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138613",
      "en": "Sicheren Weg wählen",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138614",
      "en": "Keine Einflussmöglichkeit",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138615",
      "en": "Keine einfache Entscheidung",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138616",
      "en": "Wäre nicht Ihre Schuld",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138617",
      "en": "Sie machen zu viele Sorgen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138618",
      "en": "Keine Einflussmöglichkeit",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138623",
      "en": "Trotzdem Ihre Entscheidung.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138624",
      "en": "Sie sind keine Hilfe.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138625",
      "en": "Auf Wiedersehen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138626",
      "en": "Nicht Ihr Baby.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138627",
      "en": "Aufschlussreiche Wortwahl",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138628",
      "en": "Dann verhalten Sie sich so.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138629",
      "en": "Dann geben Sie sich Mühe.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138630",
      "en": "Ist schon richtig so.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|138631",
      "en": "Bullshit",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|139819",
      "en": "Ich habe mir Sorgen gemacht. Es tut mir leid.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|139820",
      "en": "Wenn es dir so viel bedeutet und du glaubst, dass es das Richtige ist, mache ich diese Therapie.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|139821",
      "en": "Ich danke Ihnen vielmals. Wir brauchten wohl die Meinung eines Außenstehenden, um zu einer vernünftigen Entscheidung zu kommen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|153359",
      "en": "Ich wünschte, ich könnte mehr tun.",
      "tr": ""
    },
    {
      "key": "BIOA_STA20_02B_DSG_LOC|sta20_family_argue_D|153360",
      "en": "Ich wünschte, ich könnte mehr tun.",
      "tr": ""
    }
  ]
}