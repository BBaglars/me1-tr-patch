    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142440",
      "en": "Das Signal kommt aus einer Mine?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142441",
      "en": "Minenschacht. Das ist die Quelle des Signals.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142442",
      "en": "Minenschacht. Das ist die Quelle des Signals.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142443",
      "en": "Das Signal kommt aus einer Mine?",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142444",
      "en": "Minenschacht. Das ist die Quelle des Signals.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142445",
      "en": "Das stinkt.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142446",
      "en": "Verdächtig.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142447",
      "en": "Eine Falle. So muss es sein.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142449",
      "en": "Riecht nach Hinterhalt.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142450",
      "en": "Riecht nach Hinterhalt, Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142451",
      "en": "Das gefällt mir nicht, Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142452",
      "en": "Stimmt, das war kein Absturz. Jemand hat sie hier hergebracht.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142453",
      "en": "Ganz Ihrer Meinung. Das war kein Absturz. Jemand hat sie hier hergebracht.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142454",
      "en": "Ja. Das Ding ist nicht abgestürzt. Jemand hat es hier hergebracht.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142455",
      "en": "Ganz Ihrer Meinung. Die Sonde ist nicht abgestürzt. Jemand hat sie hier hergebracht.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142456",
      "en": "Ganz Ihrer Meinung. Die Sonde ist nicht abgestürzt. Sie wurde hier hergebracht.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142457",
      "en": "Klar. ",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142458",
      "en": "Ja.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142459",
      "en": "Okay, Shepard.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142460",
      "en": "Zu Befehl. ",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142461",
      "en": "Zu Befehl. ",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142474",
      "en": "Vielleicht wissen sie nicht, was sie da haben. Wir müssen sie finden, bevor sie losgeht.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142475",
      "en": "Es ist umwerfend, wie schnell Sie das Offensichtliche begreifen. Da unten ist immer noch eine Atombombe. Passen Sie ja gut auf.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142476",
      "en": "Da unten befindet sich eine Nuklearwaffe. Wir können sie nicht da lassen. Bleiben Sie wachsam.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142494",
      "en": "Wer immer das getan hat, ist in Gefahr.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142495",
      "en": "Im Ernst.",
      "tr": ""
    },
    {
      "key": "BIOA_UNC53_01_DSG_LOC|sp121_trig01_mine_D|142496",
      "en": "Das ändert nichts an unserem Ziel.",
      "tr": ""
    }
  ]
}