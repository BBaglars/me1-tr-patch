  "entries": [
    {
      "key": "BIOA_NOR10_06locker_DSG_LOC|nor20_empty_locker_d|122500",
      "en": "Tut mir leid, wenn ich störe, Commander. Ich habe eine Nachricht von Captain Anderson für Sie.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_06locker_DSG_LOC|nor20_empty_locker_d|122501",
      "en": "Commander, ich habe eine Nachricht von Captain Anderson für Sie.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_06locker_DSG_LOC|nor20_empty_locker_d|122502",
      "en": "Er sagte nur, dass er Sie in diesem Club in den Zivilbezirken treffen will. Im Flux.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_06locker_DSG_LOC|nor20_empty_locker_d|122503",
      "en": "Vielleicht sollten Sie lieber hingehen.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_06locker_DSG_LOC|nor20_empty_locker_d|122504",
      "en": "Klingt wichtig. Sie sollten wohl lieber hingehen.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_06locker_DSG_LOC|nor20_empty_locker_d|122505",
      "en": "Sie sollten wohl besser zum Treffen hingehen.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_06locker_DSG_LOC|nor20_empty_locker_d|122506",
      "en": "Nein, Ma'am. Ich wusste nur, dass Sie auf dem Schiff sind, und wollte Ihnen diese Nachricht überbringen.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_06locker_DSG_LOC|nor20_empty_locker_d|122507",
      "en": "Nein, Sir. Ich wusste nur, dass Sie auf dem Schiff sind, und wollte Ihnen diese Nachricht überbringen.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_06locker_DSG_LOC|nor20_empty_locker_d|122508",
      "en": "Der Captain möchte Sie im Flux treffen. Das ist dieser Club unten in den Zivilbezirken.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_06locker_DSG_LOC|nor20_empty_locker_d|122509",
      "en": "Spionieren Sie uns nach, Joker?",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_06locker_DSG_LOC|nor20_empty_locker_d|122510",
      "en": "Was will er denn?",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_06locker_DSG_LOC|nor20_empty_locker_d|122515",
      "en": "Spionieren Sie mir nach, Joker?",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_06locker_DSG_LOC|nor20_empty_locker_d|122519",
      "en": "Gelauscht?",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_06locker_DSG_LOC|nor20_empty_locker_d|122520",
      "en": "Nachricht geben",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_06locker_DSG_LOC|nor20_empty_locker_d|122521",
      "en": "Woher wussten Sie, dass ich hier bin?",
      "tr": ""
    }
  ]
}