  "entries": [
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|33730",
      "en": "Ich hörte, was Captain Anderson zugestoßen ist. Überlebt hunderte Schlachten, nur um dann politischen Schiebereien zum Opfer zu fallen.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89163",
      "en": "Der Captain wurde ausgebootet. Aber Sie hätten auch nichts daran ändern können. Wir geben Ihnen keine Schuld.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89164",
      "en": "Jeder auf diesem Schiff steht hinter Ihnen, Commander. Einhundert Prozent.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89165",
      "en": "Intercom ist freigeschaltet. Wenn Sie der Crew etwas sagen wollen, ist jetzt der richtige Zeitpunkt.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89177",
      "en": "Gut gesprochen, Commander. Der Captain wäre stolz auf Sie.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89178",
      "en": "Jawohl, Ma'am!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89179",
      "en": "Ja, Sir!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89181",
      "en": "Saren ist irgendwo da draußen. Und wir werden ihn finden.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89182",
      "en": "Captain Anderson sollte das Kommando haben. Ich fühle mich, als hätte ich ihm sein Schiff weggenommen.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89186",
      "en": "Schon viel zu lange hat sich unser Volk aus Konflikten herausgehalten.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89189",
      "en": "Der Rat will die Situation ignorieren.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89190",
      "en": "Keines der anderen Völker verfügt über ausreichend Mut oder Kompetenz, um diese Sache zu erledigen.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89192",
      "en": "Wir alle wissen, was auf Eden Prime geschehen ist.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89193",
      "en": "Bis jetzt wurde \"nur\" eine menschliche Siedlung in der Traverse angegriffen.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89194",
      "en": "Unser Feind weiß, dass wir kommen.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89195",
      "en": "Wohin auch immer Saren flieht - wir werden ihm folgen.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89196",
      "en": "Dies ist die wichtigste Mission, die wir alle je erlebt haben.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89197",
      "en": "Der Captain ist nicht hier. Ich habe jetzt das Kommando, Joker. Und unsere Zeit wird knapp. Starten Sie diesen Vogel.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89198",
      "en": "Mit schönen Reden allein werden wir Saren und die Röhre nicht finden. Wenn wir den Captain wirklich stolz machen wollen, sollten wir diesen Vogel jetzt starten.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89203",
      "en": "Ich bin bereit.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89204",
      "en": "Komisches Gefühl",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89210",
      "en": "Verantwortung der Menschen ",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89212",
      "en": "Keine Hilfe zu erwarten!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89213",
      "en": "Nur die Menschen können das!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89214",
      "en": "Denken Sie an Eden Prime.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89215",
      "en": "Eden Prime war nur der Anfang.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89216",
      "en": "Saren wartet schon auf uns.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89217",
      "en": "Kein Versteck für Saren",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89218",
      "en": "Wir dürfen nicht versagen!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89219",
      "en": "Der Captain ist egal.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|89220",
      "en": "Vielleicht",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|152317",
      "en": "Der Captain hat alles aufgegeben, damit wir diese Chance bekommen. Kein Versagen.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|152318",
      "en": "Werde ihn nicht enttäuschen.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|153012",
      "en": "Wir haben folgende Befehle: Wir müssen Saren finden, bevor er die Röhre findet. Ich will meine Crew nicht anlügen. Das wird keine leichte Mission.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|153013",
      "en": "Aber Saren hat noch viel mehr vor. Seine Geth-Armeen werden nicht am Rand des Citadel-Sektors verbleiben.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|153014",
      "en": "Aber Saren hat noch viel mehr vor. Seine Geth-Armeen werden nicht am Rand des Citadel-Sektors verbleiben.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|153015",
      "en": "Aber Saren hat noch viel mehr vor. Seine Geth-Armeen werden nicht am Rand des Citadel-Sektors verbleiben.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|153016",
      "en": "Jetzt müssen wir Verantwortung übernehmen und der Galaxie helfen! Jetzt können wir zeigen, wozu die Menschen imstande sind!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|153017",
      "en": "Das ist natürlich keine Überraschung. Auch in der Vergangenheit haben sie uns nicht geholfen. Warum also sollten sie es jetzt tun. Aber wir brauchen ihre Hilfe nicht. Wir können die Sache auch selbst erledigen!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|153018",
      "en": "Wenn wir die Traverse erreichen, werden seine Verbündeten schon auf uns warten. Aber auch wir werden vorbereitet sein.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|153019",
      "en": "Wenn wir die Traverse erreichen, werden seine Verbündeten schon auf uns warten. Aber auch wir werden vorbereitet sein.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|153020",
      "en": "Hier spricht der Commander. Wir haben folgende Befehle: Wir müssen Saren finden, bevor er die Röhre findet. Und ich werde nicht zulassen, dass diese Mission scheitert!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|153021",
      "en": "Wir haben die Zerstörung gesehen. Und die vielen Leichen. Das alles war Sarens Werk. Und dafür wird er bezahlen!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|153022",
      "en": "Wir haben die Zerstörung gesehen. Und die vielen Leichen. Das alles war Sarens Werk. Und dafür wird er bezahlen!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|153023",
      "en": "Wir haben die Zerstörung gesehen. Und die vielen Leichen. Das alles war Sarens Werk. Und dafür wird er bezahlen!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|153024",
      "en": "Jetzt müssen wir Verantwortung übernehmen und der Galaxie helfen! Jetzt können wir zeigen, wozu die Menschen imstande sind!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|153025",
      "en": "Das ist natürlich keine Überraschung. Auch in der Vergangenheit haben sie uns nicht geholfen. Warum also sollten sie es jetzt tun. Aber wir brauchen ihre Hilfe nicht. Wir können die Sache auch selbst erledigen!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|153026",
      "en": "Wo auch immer Saren nach der Röhre sucht - wir werden da sein. Wir werden ihn bis ans Ende der Galaxie jagen und zur Strecke bringen.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|153027",
      "en": "Wo auch immer Saren nach der Röhre sucht - wir werden da sein. Wir werden ihn bis ans Ende der Galaxie jagen und zur Strecke bringen.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|153028",
      "en": "Wir haben folgende Befehle: Wir müssen Saren finden, bevor er die Röhre findet.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|153029",
      "en": "Hier spricht Commander Shepard.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|153030",
      "en": "An alle auf der Normandy!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|153031",
      "en": "Schon viel zu lange hat sich unser Volk aus Konflikten herausgehalten.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|153032",
      "en": "Der Rat will die Situation ignorieren.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_02_DSG_LOC|nor20_leaving_oculon_d|153033",
      "en": "Hier spricht Commander Shepard.",
      "tr": ""
    },
    {
