  },
  "entries": [
    {
      "key": "BIOA_NOR10_11_DS1_LOC|nor10_landing_bay_D|58187",
      "en": "Das sind verdammt gewaltige Grabungsarbeiten, Captain.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_11_DS1_LOC|nor10_landing_bay_D|58188",
      "en": "Finden Sie einen Landeplatz nahe der Grabungsstätte. Aber nicht zu nahe. Es soll keiner bemerken, dass wir hier sind.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_11_DS1_LOC|nor10_landing_bay_D|58191",
      "en": "Ihr Team ist das Wichtigste bei dieser Operation, Commander. Gehen Sie direkt runter und machen Sie sich auf zur Ausgrabungsstätte.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_11_DS1_LOC|nor10_landing_bay_D|58192",
      "en": "Was ist mit Überlebenden, Captain?",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_11_DS1_LOC|nor10_landing_bay_D|58193",
      "en": "Die Hilfe für Überlebende ist ein sekundäres Missionsziel. Der Sender hat höchste Priorität.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_11_DS1_LOC|nor10_landing_bay_D|101595",
      "en": "Nihlus? Kommen Sie mit uns?",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_11_DS1_LOC|nor10_landing_bay_D|101596",
      "en": "Ich bin alleine schneller.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_11_DS1_LOC|nor10_landing_bay_D|101600",
      "en": "Nihlus wird vor Ihnen auskundschaften. Er gibt Ihnen Statusberichte zur Mission durch. Ansonsten will ich, dass Funkstille herrscht.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_11_DS1_LOC|nor10_landing_bay_D|101601",
      "en": "Von hier aus übernehmen Sie, Shepard. Viel Glück!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_11_DS1_LOC|nor10_landing_bay_D|101606",
      "en": "Bereit zum Einsatz, Sir!",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_11_DS1_LOC|nor10_landing_bay_D|101613",
      "en": "Verstanden, Captain.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_11_DS1_LOC|nor10_landing_bay_D|149189",
      "en": "Nihlus ist auf unserer Seite. Er will Sie zum Spectre befördern. Und er will diesen Sender finden.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_11_DS1_LOC|nor10_landing_bay_D|149190",
      "en": "Er kann sich auf uns verlassen, Captain.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_11_DS1_LOC|nor10_landing_bay_D|149191",
      "en": "Ich lege mein Leben nicht gerne in die Hände eines Turianers, Sir.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_11_DS1_LOC|nor10_landing_bay_D|149193",
      "en": "Er kann auf uns zählen.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_11_DS1_LOC|nor10_landing_bay_D|149194",
      "en": "Können wir ihm vertrauen?",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_11_DS1_LOC|nor10_landing_bay_D|149195",
      "en": "Er kann auf uns zählen.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_11_DS1_LOC|nor10_landing_bay_D|150995",
      "en": "Tarnsysteme werden aktiviert.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_11_DS1_LOC|nor10_landing_bay_D|151998",
      "en": "Nähern uns Landestelle 1.",
      "tr": ""
    },
    {
      "key": "BIOA_NOR10_11_DS1_LOC|nor10_landing_bay_D|151999",
      "en": "Nähern uns Landestelle 2.",
      "tr": ""
    }
  ]
}