{
  "meta": {
    "package": "BIOA_LAV70_00_DSG_LOC_INT.pcc",
    "stem": "BIOA_LAV70_00_DSG_LOC",
    "textLang": "DE",
    "sets": 4
  },
  "entries": [
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_banter_00_D|160135",
      "en": "Wenigstens ist es 'ne trockene Hitze.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_banter_00_D|160136",
      "en": "Die reinste Hölle.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_banter_00_D|160138",
      "en": "Hier ist's ja wie in der Sauna.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_banter_00_D|160139",
      "en": "Ich glaub, meine Augäpfel trocknen aus.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_banter_00_D|160141",
      "en": "Denken Sie daran, immer genug zu trinken.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_banter_00_D|160142",
      "en": "Und ich dachte, auf Palaven wär's heiß.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_banter_00_D|160144",
      "en": "Nichts als Felsen, Dreck und Lava. Erinnert mich an zuhause.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_banter_00_D|160145",
      "en": "Noch fünfzig Grad mehr und ich könnte mich etwas unwohl fühlen. Was macht ihr Säugetiere, Shepard?",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_banter_00_D|160147",
      "en": "Mein Volk hat viele Generationen lang nach einer Welt gesucht, die es als Zuhause bezeichnen kann. Wenn wir hier gelandet wären, hätten wir sofort weitergesucht.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_banter_00_D|160148",
      "en": "Selbst die Geth würden nicht in dieser Hitze leben wollen.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig02_mining_laser_D|15989",
      "en": "Die Fokussierlinsen sind noch intakt. Ich glaube, wir können das Ding reparieren.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig02_mining_laser_D|15990",
      "en": "Sieht aus, als könnten wir es reaktivieren. War vielleicht einfach zu teuer.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig02_mining_laser_D|15991",
      "en": "Das Ding würde eine verdammt gute Waffe abgeben. Alles was Fels vaporisieren kann, sollte auch mit einer verstärkten Säule fertig werden.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig02_mining_laser_D|15992",
      "en": "Hören Sie das Summen? Ich glaube, der Antrieb ist noch intakt.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig02_mining_laser_D|15993",
      "en": "Ob das Ding funktioniert, wenn ich mal dagegen trete?",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig04_elevator_ride_D|34760",
      "en": "Ich ... verstehe das alles immer noch nicht. Warum hatten die Geth es auf mich abgesehen? Ob Benezia was damit zu tun hatte?",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig04_elevator_ride_D|34761",
      "en": "Saren ist auf der Suche nach der Röhre. Sie sind hier die Expertin für Protheaner. Er will vielleicht, dass Sie ihm bei der Suche helfen.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig04_elevator_ride_D|34762",
      "en": "Saren ist auf der Suche nach der Röhre. Denk schneller, Ms. Experte für Protheaner.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig04_elevator_ride_D|34763",
      "en": "Saren ist auf der Suche nach der Röhre. Sie sind hier die Expertin für Protheaner. Er will vielleicht, dass Sie ihm bei der Suche helfen.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig04_elevator_ride_D|34764",
      "en": "Saren ist auf der Suche nach der Röhre. Sie sind hier die Expertin für Protheaner. Er will offensichtlich, dass Sie ihm bei der Suche helfen.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig04_elevator_ride_D|34769",
      "en": "Die Röhre? Aber ich ...",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig04_elevator_ride_D|34770",
      "en": "Was zum Teufel war das?",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig04_elevator_ride_D|34771",
      "en": "Was zum Teufel war das? ",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig04_elevator_ride_D|34772",
      "en": "Was zum Teufel war das?",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig04_elevator_ride_D|34773",
      "en": "Was zum Teufel war das?",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig04_elevator_ride_D|76225",
      "en": "Diese Höhle war nie besonders stabil. Ihre ganze Schießerei und Sprengerei hat es nur noch schlimmer gemacht.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig04_elevator_ride_D|78876",
      "en": "Joker! Bringen Sie die Normandy in die Luft und peilen Sie mein Signal an. Jetzt!",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig04_elevator_ride_D|78877",
      "en": "Wir brauchen einen Fluchtplan.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig04_elevator_ride_D|89225",
      "en": "Wir haben vielleicht 10 Minuten bis hier alles zusammenbricht. Ich hoffe nur, dass der Druck keine Eruption verursacht!",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig04_elevator_ride_D|89226",
      "en": "Zu Befehl, Commander. Anker gelichtet. Geschätzte Ankunftszeit: acht Minuten.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig04_elevator_ride_D|106609",
      "en": "Das muss schneller gehen!",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig04_elevator_ride_D|106610",
      "en": "Es wird eng, Skipper.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig04_elevator_ride_D|106611",
      "en": "Wenn ich hier sterbe, bringe ich ihn um!",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig04_elevator_ride_D|106612",
      "en": "Kein großer Spielraum für Fehler.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|lav70_trig04_elevator_ride_D|122434",
      "en": "Wir verschwinden von hier!",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|unc_banter_00_d|160642",
      "en": "Ich bin hier.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|unc_banter_00_d|160643",
      "en": "Bereit, wenn Sie es sind.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|unc_banter_00_d|160644",
      "en": "Jawohl, Sir.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|unc_banter_00_d|160645",
      "en": "Jawohl, Ma'am.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|unc_banter_00_d|160646",
      "en": "Auf Ihren Befehl.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|unc_banter_00_d|160647",
      "en": "Sind bereit.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|unc_banter_00_d|160648",
      "en": "Warte auf Befehle.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|unc_banter_00_d|160650",
      "en": "Bereit.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|unc_banter_00_d|160651",
      "en": "Geben Sie den Befehl.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|unc_banter_00_d|160652",
      "en": "Ich bin bereit zu schießen.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|unc_banter_00_d|160653",
      "en": "Ich kümmere mich darum.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|unc_banter_00_d|160655",
      "en": "Bereit.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|unc_banter_00_d|160656",
      "en": "Auf Ihren Befehl, Shepard.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|unc_banter_00_d|160657",
      "en": "Gehen Sie voraus, Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|unc_banter_00_d|160659",
      "en": "Gehen Sie vor.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|unc_banter_00_d|160660",
      "en": "Ich bin hier, wenn Sie mich brauchen.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|unc_banter_00_d|160661",
      "en": "Bin direkt hinter Ihnen, Shepard.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|unc_banter_00_d|160663",
      "en": "Also dann los!",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|unc_banter_00_d|160664",
      "en": "Hier rumzustehen bringt gar nichts.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|unc_banter_00_d|160665",
      "en": "Gehen wir.",
      "tr": ""
    },
    {
      "key": "BIOA_LAV70_00_DSG_LOC|unc_banter_00_d|160667",
      "en": "Sie gehen vor, ich folge Ihnen.",
      "tr": ""
    }
  ]
}