  "entries": [
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150550",
      "en": "Chief. Wir haben soeben ein Schiff entdeckt, das zu Ihnen unterwegs ist.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150551",
      "en": "Vergessen Sie's! Wir können auf uns selbst aufpassen. Gehen Sie zurück und holen Sie Alenko.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150552",
      "en": "Es ist bereits hier und spuckt immer mehr Geth aus, die die Detonationsstelle überfluten.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150553",
      "en": "Es sind zu viele. Ich glaube nicht, dass wir sie aufhalten können.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150554",
      "en": "Negativ. Es ist zu spät für uns. Es sind einfach zu viele.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150555",
      "en": "Ich aktiviere die Bombe.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150556",
      "en": "Ich stelle sicher, dass die Bombe hochgeht. Unter allen Umständen.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150557",
      "en": "Erledigt, Commander. Holen Sie den Lieutenant und verschwinden Sie dann schleunigst.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150558",
      "en": "Das werden Sie nicht! Wir können auf uns selbst aufpassen. Gehen Sie zurück und holen Sie Williams.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150559",
      "en": "Ja, Commander. Ich ...",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150560",
      "en": "Es ist die richtige Entscheidung und Sie wissen das, Ash.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150561",
      "en": "Zu Befehl, Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150562",
      "en": "Wir beide wissen, dass das nicht passieren wird, Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150563",
      "en": "Ich verstehe, Commander. Ich bedauere nichts.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150564",
      "en": "Ja, Commander. Ich ...",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150565",
      "en": "Sie wissen, dass es die richtige Entscheidung ist, Lieutenant.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150566",
      "en": "Zu Befehl, Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150567",
      "en": "Wir beide wissen, dass das nicht passieren wird, Commander.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150568",
      "en": "Ich verstehe, Commander. Ich bedauere nichts.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150569",
      "en": "Vorsicht, Lieutenant. Wir haben soeben ein Schiff entdeckt, das zu Ihnen unterwegs ist.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150570",
      "en": "Es ist schon hier. Die gesamte Detonationsstelle wimmelt von Geth.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150571",
      "en": "Es sind zu viele. Ich glaube nicht, dass wir durchhalten, bis Sie hier sind.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150572",
      "en": "Negativ. Es sind einfach zu viele. Ich glaube nicht, dass wir sie aufhalten können.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150573",
      "en": "Ich aktiviere die Bombe.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150574",
      "en": "Ich stelle nur sicher, dass diese Bombe hochgeht. Unter allen Umständen.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150575",
      "en": "Erledigt, Commander. Holen Sie Williams und verschwinden Sie dann schleunigst.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150578",
      "en": "Können Sie sie zurückhalten?",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150580",
      "en": "Warten Sie, Chief. Ich komme und hole Sie da raus.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150582",
      "en": "Was zum Teufel machen Sie da, Williams?",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150585",
      "en": "Williams, funken Sie Joker an und sagen Sie ihm, er soll uns an der Detonationsstelle treffen.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150587",
      "en": "Kämpfen Sie hart, Lieutenant. Und sterben Sie erhobenen Hauptes.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150589",
      "en": "Bleiben Sie am Leben. Ich werde Sie holen kommen, Kaidan.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150591",
      "en": "Tut mir leid, Kaidan. Ich musste mich entscheiden.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150593",
      "en": "Alenko, funken Sie Joker an und sagen Sie ihm, er soll uns am Flakturm treffen.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150595",
      "en": "Kämpfen Sie hart. Und sterben Sie erhobenen Hauptes.",
      "tr": ""
    },
    {
      "key": "BIOA_JUG80_09_DSG_LOC|jug80_choice_D|150597",
      "en": "Bleiben Sie am Leben. Ich werde Sie holen kommen, Ash.",
