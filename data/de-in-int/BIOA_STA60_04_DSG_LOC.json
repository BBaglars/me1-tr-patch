    {
      "key": "BIOA_STA60_04_DSG_LOC|sta00_cab_D|159576",
      "en": "Bitte wählen Sie ein Ziel für den Citadel Rapid Transit aus.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_assassin_ambush_D|89463",
      "en": "Das ist er.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_assassin_ambush_D|89464",
      "en": "Das ist sie.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_assassin_ambush_D|89465",
      "en": "Bist du sicher?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_assassin_ambush_D|89466",
      "en": "Positiv. Los geht's.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_assassins_dispatched_D|100997",
      "en": "Das waren Sarens Männer.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_assassins_dispatched_D|100998",
      "en": "Das waren Sarens Männer.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_assassins_dispatched_D|101000",
      "en": "Dann sind wir wohl auf der richtigen Fährte.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_assassins_dispatched_D|106626",
      "en": "Dann sind wir wohl auf der richtigen Fährte.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137971",
      "en": "Man hatte mir gesagt, dass du es seist. Kaum zu glauben: Shepard ist jetzt erwachsen und beim Militär.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137972",
      "en": "Ich bin Finch. Vielleicht erinnerst du dich nicht mehr an mich, aber wir waren beide bei den Tenth Street Reds.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137973",
      "en": "Vielleicht kannst du dich ja gar nicht daran erinnern, in einer Gang gewesen zu sein. In den Videos über dich wird nie 'was davon gesagt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137974",
      "en": "Tatsächlich? Und wenn jemand ein Interview gibt und über Commander Shepards Zeiten in der Gang berichtet?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137975",
      "en": "Wir wollen keinen Ärger machen, sondern dich nur um einen kleinen Gefallen bitten, Shepard. Aus alter Verbundenheit.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137976",
      "en": "Einer der Reds, Curt Weisman, wurde von den Turianern eingebuchtet. Vielleicht kannst du mit der turianischen Wache in der Bar reden und ihn rausholen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137977",
      "en": "Seit du nicht mehr dabei bist, haben die Reds ihre Geschäfte ausgedehnt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137978",
      "en": "Ein paar Hilfsdienste hier, ein paar Transporte da ... Solche Sachen eben.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137979",
      "en": "Nur irgendeine Kleinigkeit. Vielleicht hatte er ein bisschen Roter Sand dabei ... Du kennst die Turianer ja.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137980",
      "en": "Sie haben eine große Sache draus gemacht und wollen ihm jetzt den Prozess machen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137981",
      "en": "Natürlich nicht. Aber die Leute sagen, dass du ziemlich gut mit diesen Aliens umgehen kannst.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137982",
      "en": "Wir bitten dich nur, ein gutes Wort für ihn einzulegen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137983",
      "en": "Danke Shepard. Ich wusste, dass man sich noch auf dich verlassen kann. Die Wache ist in Choras Nest.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137984",
      "en": "Wie du meinst, Shepard. Aber wenn du deine Meinung änderst: Er ist in Choras Nest. Wenn du dich darum kümmerst, werde ich dich zukünftig in Ruhe lassen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137985",
      "en": "Und Shepard ... Auch wenn du nicht mehr bei uns bist: Als Feinde können wir dir das Leben immer noch schwermachen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137986",
      "en": "Sind wir uns schon begegnet?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137987",
      "en": "Beim Militär und ungeduldig. Wer sind Sie und was wollen Sie?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137989",
      "en": "Die Leute können meine Vergangenheit ruhig kennen. Ich habe nichts zu verbergen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137991",
      "en": "Stimmt. Ich war bei den Reds. Aber das ist lange her.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137993",
      "en": "In den Videos sagen sie nie die ganze Wahrheit. Was kann ich denn für die Reds tun?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137994",
      "en": "Was macht ein Mitglied der Tenth Street Reds denn auf turianischen Gebiet?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137996",
      "en": "Warum wurde der Mann verhaftet?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|137998",
      "en": "Du glaubst doch nicht etwa, dass ich Weisman bei einem Gefängnisausbruch helfe, oder?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|138000",
      "en": "Ich werde mit dem Turianer reden und sehen, was sich machen lässt.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|138001",
      "en": "Ich bin in keiner Gang mehr, Finch. Also lass' mich in Ruhe.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|138003",
      "en": "Bitte? Wer sind Sie?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|138004",
      "en": "Wer sind Sie?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|138005",
      "en": "Was wollen Sie?",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|138007",
      "en": "Nicht peinlich",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|138008",
      "en": "Das ist lange vorbei.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|138009",
      "en": "Die Videos sind egal.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|138012",
      "en": "Turianisches Gebiet",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|138013",
      "en": "Gründe für Verhaftung",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|138014",
      "en": "Kein Ausbruch",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|138015",
      "en": "Kein Problem.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|138016",
      "en": "Keine Versprechen.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|138017",
      "en": "Kommt nicht in Frage.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|138019",
      "en": "Kein Problem.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|138021",
      "en": "Kein Problem.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|138023",
      "en": "Kein Problem.",
      "tr": ""
    },
    {
      "key": "BIOA_STA60_04_DSG_LOC|sta60_trig_gangmember_D|138292",
      "en": "Wenn du dich darum kümmerst, werde ich dich zukünftig in Ruhe lassen.",
      "tr": ""
    }
